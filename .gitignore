/target
# Vite and its SWC plugin cache, per machine; one was committed once at 7.9 MB.
.vite/
/config/*
.env
.sqlx/
*.cer
# Apple's public root, which app_store.rs pins; not a secret.
!/src/certs/AppleRootCA-G3.cer

# Vitest browser failure screenshots, as neo-cucumber already ignores.
**/__screenshots__/

# pnpm's fallback content store, made in the project root when it cannot use
# the one in ~/Library/pnpm.
.pnpm-store/
