{% extends "base.jinja" %}
{% block title %}
  {{ super() }}
{% endblock title %}
{% block content %}
  {# The same card as 404.jinja and 500.jinja. #}
  <div class="auth-page">
    <div class="ds-card auth-card not-found">
      <img class="not-found-mark" src="/static/favicon.png" alt="" width="56" height="56" />
      <p class="not-found-code">403</p>
      <p class="not-found-text">{{ ftl_get_message("error-403") }}</p>
      <a class="ds-button ds-button-primary auth-submit" href="/">{{ ftl_get_message("nav-home") }}</a>
    </div>
  </div>
{% endblock content %}
