{% extends "base.jinja" %}
{% block title %}
  {{ super() }} |
  {% if post.title %}
    {{ post.title }}
  {% else %}
    {{ ftl_get_message("post-no-title") }}
  {% endif %} | {{ ftl_get_message("post-move-community-title") }}
{% endblock title %}
{% block head %}
  <meta name="robots" content="noindex" />
{% endblock head %}

{# One place a drawing can go: a row in the list, the whole row the target.
   Its three latest drawings say what the community is at a glance; the
   radio beside them is what the form sends. `label` is what the Move
   button will say once this row is chosen. #}
{% macro destination(value, name, meta, label, badge, posts, search, group) %}
  <label class="move-row" data-search="{{ search }}">
    <input type="radio" name="community_id" value="{{ value }}" data-move-label="{{ label }}" />
    <span class="move-row-cover" aria-hidden="true">
      {% if posts %}
        {% for p in posts[:3] %}
          <span class="move-row-cell"><img src="{{ r2_public_endpoint_url }}/image/{{ p.image_filename[:2] }}/{{ p.image_filename }}" alt="" draggable="false" loading="lazy" decoding="async" /></span>
        {% endfor %}
      {% elif value == "" %}
        <span class="move-row-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c.8-3.7 3.9-6 7.5-6s6.7 2.3 7.5 6"/></svg>
        </span>
      {% endif %}
    </span>
    <span class="move-row-text">
      <span class="move-row-name">
        <span class="move-row-title">{{ name }}</span>
        {% if badge %}<span class="community-card-badge">{{ badge }}</span>{% endif %}
      </span>
      {% if meta %}<span class="move-row-meta">{{ meta }}</span>{% endif %}
    </span>
    <svg class="move-row-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
  </label>
{% endmacro %}

{% macro community_row(community, badge) %}
  {{ destination(
       community.id,
       community.name,
       "@" ~ community.owner_login_name ~ ((" · " ~ community.posts_count ~ " " ~ ftl_get_message("community-stats-posts")) if community.posts_count else ""),
       ftl_format_pattern("post-move-to", {"communityName": community.name}),
       badge,
       community.recent_posts,
       (community.name ~ " " ~ community.slug ~ " " ~ (community.description or ""))|lower) }}
{% endmacro %}

{% block content %}
  {# Moving a drawing is choosing one place from a list and saying so once:
     the list is a picker, the search narrows it, and a single button at
     the foot names where the drawing will go. It used to be a column of
     large cards with a Move button and a confirmation each, and a search
     that found its section headings by looking for English words in them. #}
  <div class="move-page">
    <section class="ds-card move-subject">
      <a class="move-subject-thumb" href="/@{{ post.login_name }}/{{ post_id }}">
        <img src="{{ r2_public_endpoint_url|safe }}/image/{{ post.image_filename[:2] }}/{{ post.image_filename }}"
             alt="{{ post.title }}" draggable="false" />
      </a>
      <div class="move-subject-text">
        <h1 class="move-subject-title">{{ ftl_get_message("post-move-community-title") }}</h1>
        <div class="move-subject-post">{% if post.title %}{{ post.title }}{% else %}{{ ftl_get_message("post-no-title") }}{% endif %}</div>
        <div class="move-subject-where">
          <span>{{ ftl_get_message("post-current-community") }}</span>
          {% if current_community %}
            <a class="profile-chip" href="/communities/@{{ current_community.slug }}">{{ current_community.name }}</a>
          {% else %}
            <span class="profile-chip">{{ ftl_get_message("post-personal-post") }}</span>
          {% endif %}
        </div>
      </div>
    </section>

    <form method="post" action="/@{{ post.login_name }}/{{ post_id }}/edit/community" class="move-form" id="move-form">
      <input type="search"
             id="community-search"
             class="ds-input move-search"
             placeholder="{{ ftl_get_message('post-move-search-placeholder') }}"
             aria-label="{{ ftl_get_message('post-move-search-placeholder') }}"
             autocomplete="off" />

      <div class="move-list" role="radiogroup" aria-label="{{ ftl_get_message('post-move-available') }}">
        {% if current_community %}
          <div class="move-group" data-move-group>
            {{ destination("", ftl_get_message("post-personal-post"), ftl_get_message("post-personal-post-description"), ftl_get_message("post-move-to-personal"), none, none, (ftl_get_message("post-personal-post") ~ " personal")|lower, "personal") }}
          </div>
        {% endif %}
        {% if unlisted_communities %}
          <div class="move-group" data-move-group>
            <div class="profile-section-label">{{ ftl_get_message("move-section-unlisted") }}</div>
            {% for community in unlisted_communities %}
              {{ community_row(community, ftl_get_message("community-badge-unlisted")) }}
            {% endfor %}
          </div>
        {% endif %}
        {% if public_participated_communities %}
          <div class="move-group" data-move-group>
            <div class="profile-section-label">{{ ftl_get_message("move-section-public-participated") }}</div>
            {% for community in public_participated_communities %}
              {{ community_row(community, none) }}
            {% endfor %}
          </div>
        {% endif %}
        {% if public_other_communities %}
          <div class="move-group" data-move-group>
            <div class="profile-section-label">{{ ftl_get_message("move-section-public-other") }}</div>
            {% for community in public_other_communities %}
              {{ community_row(community, none) }}
            {% endfor %}
          </div>
        {% endif %}
        <p class="profile-empty move-empty" {% if unlisted_communities or public_participated_communities or public_other_communities or current_community %}hidden{% endif %}>{{ ftl_get_message("post-move-no-results") }}</p>
      </div>

      {# The one decision, at the foot of the window while the list scrolls. #}
      <div class="move-bar">
        <a href="/@{{ post.login_name }}/{{ post_id }}" class="ds-button">{{ ftl_get_message("cancel") }}</a>
        <button type="submit" class="ds-button ds-button-primary" id="move-submit" disabled
                data-choose="{{ ftl_get_message('post-move-choose') }}">{{ ftl_get_message("post-move-choose") }}</button>
      </div>
    </form>
  </div>

  <script>
    (function () {
      var form = document.getElementById("move-form");
      var submit = document.getElementById("move-submit");
      var search = document.getElementById("community-search");
      var empty = form.querySelector(".move-empty");

      // Choosing a row names it on the button.
      form.addEventListener("change", function (event) {
        var radio = event.target;
        if (radio.name !== "community_id") return;
        submit.disabled = false;
        submit.textContent = radio.getAttribute("data-move-label");
        var rows = form.querySelectorAll(".move-row");
        for (var i = 0; i < rows.length; i++) {
          rows[i].classList.toggle("is-chosen", rows[i].contains(radio));
        }
      });
      // The radio is out of sight, so its row shows where the keyboard is.
      form.addEventListener("focusin", function (event) {
        var row = event.target.closest && event.target.closest(".move-row");
        if (row) row.classList.add("has-focus");
      });
      form.addEventListener("focusout", function (event) {
        var row = event.target.closest && event.target.closest(".move-row");
        if (row) row.classList.remove("has-focus");
      });

      // Narrowing: rows by what they are called and described, groups by
      // whether a row of theirs is left.
      search.addEventListener("input", function () {
        var query = search.value.toLowerCase().trim();
        var groups = form.querySelectorAll("[data-move-group]");
        var any = false;
        for (var g = 0; g < groups.length; g++) {
          var rows = groups[g].querySelectorAll(".move-row");
          var shown = 0;
          for (var r = 0; r < rows.length; r++) {
            var hit = !query || rows[r].getAttribute("data-search").indexOf(query) !== -1;
            rows[r].hidden = !hit;
            if (hit) shown++;
          }
          groups[g].hidden = shown === 0;
          if (shown) any = true;
        }
        empty.hidden = any;
      });

      // Enter in the search box would send the form with whatever was
      // chosen before; it picks the first row left instead.
      search.addEventListener("keydown", function (event) {
        if (event.key !== "Enter") return;
        event.preventDefault();
        var first = form.querySelector(".move-row:not([hidden]) input");
        if (first) {
          first.checked = true;
          first.dispatchEvent(new Event("change", { bubbles: true }));
          first.focus();
        }
      });
    })();
  </script>
{% endblock content %}
