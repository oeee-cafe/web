{% from "post_url_macro.jinja" import post_url %}
{% from "storage_macro.jinja" import stored_url %}
{% extends "base.jinja" %}
{% block title %}
  {{ super() }} |
  {% if post.title %}
    {{ post.title }}
  {% else %}
    {{ ftl_get_message("post-no-title") }}
  {% endif %} | {{ ftl_get_message("post-move-community-title") }}
{% endblock title %}
{% block head %}
  <meta name="robots" content="noindex" />
{% endblock head %}

{% block content %}
  {# Moving a drawing is choosing one place from a list and saying so once:
     the list is a picker, the search narrows it, and a single button at
     the foot names where the drawing will go. It used to be a column of
     large cards with a Move button and a confirmation each, and a search
     that found its section headings by looking for English words in them. #}
  <div class="move-page">
    <section class="ds-card move-subject">
      <a class="move-subject-thumb" href="{{ post_url(post, post_id) }}">
        <img src="{{ stored_url("image", post.image_filename) }}"
             alt="{{ post.title }}" />
      </a>
      <div class="move-subject-text">
        <h1 class="move-subject-title">{{ ftl_get_message("post-move-community-title") }}</h1>
        <div class="move-subject-post">{% if post.title %}{{ post.title }}{% else %}{{ ftl_get_message("post-no-title") }}{% endif %}</div>
        <div class="move-subject-where">
          <span>{{ ftl_get_message("post-current-community") }}</span>
          {% if current_community %}
            <a class="profile-chip" href="/@{{ current_community.slug }}">{{ current_community.name }}</a>
          {% else %}
            <span class="profile-chip">{{ ftl_get_message("post-personal-post") }}</span>
          {% endif %}
        </div>
      </div>
    </section>

    <form method="post" action="{{ post_url(post, post_id) }}/edit/community" class="move-form" id="move-form">
      {# Narrowed in the database as you type: the server answers with
         the move_list block alone, which replaces the list below. #}
      <input type="search"
             id="community-search"
             name="q"
             value="{{ query }}"
             class="ds-input move-search"
             placeholder="{{ ftl_get_message('post-move-search-placeholder') }}"
             aria-label="{{ ftl_get_message('post-move-search-placeholder') }}"
             autocomplete="off"
             hx-get="{{ post_url(post, post_id) }}/edit/community"
             hx-trigger="input changed delay:250ms, search"
             hx-target="#move-list"
             hx-swap="innerHTML" />

      <div class="move-list" id="move-list" role="radiogroup" aria-label="{{ ftl_get_message('post-move-available') }}">
        {% block move_list %}
        {# One place a drawing can go: a row in the list, the whole row the
           target. Its three latest drawings say what the community is at a
           glance; the radio beside them is what the form sends. `label` is
           what the Move button will say once this row is chosen. Defined in
           the block so the block renders on its own. #}
        {% macro destination(value, name, meta, label, badge, posts) %}
          <label class="move-row">
            <input type="radio" name="community_id" value="{{ value }}" data-move-label="{{ label }}" />
            <span class="move-row-cover" aria-hidden="true">
              {% if posts %}
                {% for p in posts[:3] %}
                  <span class="move-row-cell"><img src="{{ stored_url("image", p.image_filename) }}" alt="" loading="lazy" decoding="async" /></span>
                {% endfor %}
              {% elif value == "" %}
                <span class="move-row-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c.8-3.7 3.9-6 7.5-6s6.7 2.3 7.5 6"/></svg>
                </span>
              {% endif %}
            </span>
            <span class="move-row-text">
              <span class="move-row-name">
                <span class="move-row-title">{{ name }}</span>
                {% if badge %}<span class="community-card-badge">{{ badge }}</span>{% endif %}
              </span>
              {% if meta %}<span class="move-row-meta">{{ meta }}</span>{% endif %}
            </span>
            <svg class="move-row-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
          </label>
        {% endmacro %}

        {% macro community_row(community, badge) %}
          {{ destination(
               community.id,
               community.name,
               "@" ~ community.owner_login_name ~ ((" · " ~ ftl_format_pattern("post-move-posts-count", {"count": community.posts_count})) if community.posts_count else ""),
               ftl_format_pattern("post-move-to", {"communityName": community.name}),
               badge,
               community.recent_posts) }}
        {% endmacro %}

        {% set personal = ftl_get_message("post-personal-post") %}
        {% set show_personal = current_community and (not query or query|lower in personal|lower) %}
        {% if show_personal %}
          <div class="move-group">
            {{ destination("", personal, ftl_get_message("post-personal-post-description"), ftl_get_message("post-move-to-personal"), none, none) }}
          </div>
        {% endif %}
        {% if unlisted_communities %}
          <div class="move-group">
            <div class="profile-section-label">{{ ftl_get_message("move-section-unlisted") }}</div>
            {% for community in unlisted_communities %}
              {{ community_row(community, ftl_get_message("community-badge-unlisted")) }}
            {% endfor %}
          </div>
        {% endif %}
        {% if public_participated_communities %}
          <div class="move-group">
            <div class="profile-section-label">{{ ftl_get_message("move-section-public-participated") }}</div>
            {% for community in public_participated_communities %}
              {{ community_row(community, none) }}
            {% endfor %}
          </div>
        {% endif %}
        {% if public_other_communities %}
          <div class="move-group">
            <div class="profile-section-label">{{ ftl_get_message("move-section-public-other") }}</div>
            {% for community in public_other_communities %}
              {{ community_row(community, none) }}
            {% endfor %}
          </div>
        {% endif %}
        {% if has_more %}
          <p class="profile-empty move-more">
            {% if query %}{{ ftl_format_pattern("post-move-more-results", {"count": public_other_communities|length}) }}{% else %}{{ ftl_get_message("post-move-more") }}{% endif %}
          </p>
        {% elif not (show_personal or unlisted_communities or public_participated_communities or public_other_communities) %}
          <p class="profile-empty move-empty">{{ ftl_get_message("post-move-no-results") }}</p>
        {% endif %}
        {% endblock move_list %}
      </div>

      {# The one decision, at the foot of the window while the list scrolls. #}
      <div class="move-bar">
        <a href="{{ post_url(post, post_id) }}" class="ds-button">{{ ftl_get_message("cancel") }}</a>
        <button type="submit" class="ds-button ds-button-primary" id="move-submit" disabled
                data-choose="{{ ftl_get_message('post-move-choose') }}">{{ ftl_get_message("post-move-choose") }}</button>
      </div>
    </form>
  </div>

  <script>if (window.oeeeChrome) window.oeeeChrome.moveToCommunity();</script>
{% endblock content %}
