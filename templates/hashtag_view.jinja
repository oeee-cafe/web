{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | #{{ hashtag.display_name }}
{% endblock title %}
{% block social_meta %}
  <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="#{{ hashtag.display_name }}" />
  <meta property="og:description"
        content="{{ ftl_format_pattern('hashtag-post-count', {'count': post_count}) }}" />
  {# The stored name, escaped: the display name differs from it in case, and a
     tag in a non-Latin script has to survive being put in a URL. #}
  <meta property="og:url"
        content="{{ base_url|safe }}/hashtags/{{ hashtag.name|urlencode }}" />
  {# Lead with the most recent drawing carrying the tag, which is a far better
     preview than the site mark. #}
  {% if feed.posts %}
    <meta property="og:image"
          content="{{ r2_public_endpoint_url|safe }}/image/{{ feed.posts[0].image_filename[:2] }}/{{ feed.posts[0].image_filename }}" />
    <meta name="twitter:card" content="summary_large_image" />
  {% else %}
    <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
    <meta name="twitter:card" content="summary" />
  {% endif %}
  <meta name="twitter:site" content="@oeee_cafe" />
{% endblock social_meta %}
{% block content %}
  {# In the body, not the head: a boosted visit keeps nothing of the head but
     the title, so from there it stopped applying the reader's count a row. #}
  {% include "post_feed_head.jinja" %}
  {# A tag's page as a community's is laid out: the card saying what it is,
     then its drawings. #}
  <div class="profile hashtag-page">
    <section class="profile-card ds-card">
      <div class="profile-identity">
        <h1 class="profile-name">#{{ hashtag.display_name }}</h1>
        {# Counted over the same filter the grid below is drawn from, so this
           is the number of drawings on the page rather than a stored counter
           that had drifted from it. #}
        <div class="profile-handle">{{ ftl_format_pattern("hashtag-post-count", {"count": post_count}) }}</div>
      </div>
      <div class="profile-actions">
        <a class="ds-button" href="/hashtags">{{ ftl_get_message("hashtag-discovery") }}</a>
      </div>
    </section>

    {# The shared feed: same cards, same sensitive blur, same column control
       and same infinite scroll as / and a community page. #}
    <section class="profile-section" role="region" aria-labelledby="post-feed-heading">
      {% if feed.posts %}
        <div class="grid-header">
          <div id="post-feed-heading" class="profile-section-label">{{ ftl_get_message("recent-drawings") }}</div>
          {% include "post_feed_controls.jinja" %}
        </div>
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      {% else %}
        <p class="profile-empty">{{ ftl_get_message("hashtag-no-posts") }}</p>
      {% endif %}
    </section>
  </div>
{% endblock content %}
