{# A person, as one pill: their banner, then their name over their handle.
   For anyone who has drawn a banner -- the banner is who they are on this
   site, so it goes beside their name rather than in a strip of its own.
   `size` is "large" for the person a page is about. `href` is none when the
   pill should not be a link (a banner the viewer is about to redraw links
   elsewhere itself). #}
{% macro user_pill(href, banner_filename, banner_width, banner_height, display_name, handle, r2_public_endpoint_url, size="") %}
  {% if href %}<a class="user-pill {{ size }}" href="{{ href }}">{% else %}<span class="user-pill {{ size }}">{% endif %}
    <img
         class="user-pill-banner banner"
         width="{{ banner_width }}"
         height="{{ banner_height }}"
         alt=""
         src="{{ r2_public_endpoint_url }}/image/{{ banner_filename[:2] }}/{{ banner_filename }}" />
    <span class="user-pill-text">
      <span class="user-pill-name">{{ display_name }}</span>
      <span class="user-pill-handle">{{ handle }}</span>
    </span>
  {% if href %}</a>{% else %}</span>{% endif %}
{% endmacro %}
