{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("hashtag-discovery") }}
{% endblock title %}
{% block content %}
  <div class="center">
    <h2>{{ ftl_get_message("hashtag-discovery") }}</h2>

    <div class="hashtag-discovery-controls">
      {# The form still GETs /hashtags, so this works with scripting off and
         Enter still navigates to a bookmarkable URL. The htmx attributes on
         the input search as you type on top of that — the same arrangement
         the community directory has had, which this page did not. #}
      <form method="get" action="/hashtags" class="hashtag-search-form">
        <input type="text"
               name="q"
               placeholder="{{ ftl_get_message("hashtag-search-placeholder") }}"
               value="{% if search_query %}{{ search_query }}{% endif %}"
               class="hashtag-search-input"
               autocomplete="off"
               hx-get="/api/hashtags/cards"
               hx-trigger="input changed delay:300ms, search"
               hx-target="#hashtag-results"
               hx-swap="innerHTML"
               hx-include="[name='sort']"
               hx-indicator="#hashtag-search-indicator" />
        <button type="submit">{{ ftl_get_message("search") }}</button>
        {# Inside the form, not beside it: submitting without scripting sends
           whatever is in the form, and while this sat in the sort controls
           below, pressing Enter dropped the chosen order and went back to
           trending. hx-include reaches it either way. #}
        <input type="hidden" name="sort" value="{{ sort_by }}" />
        <span id="hashtag-search-indicator"
              class="htmx-indicator search-indicator"
              role="status">{{ ftl_get_message("searching") }}</span>
      </form>

      {# Shown during a search too, now that searching no longer reloads the
         page: hiding them on the first keystroke would leave no way back to
         browsing without clearing the box by hand. Each link keeps the search
         it was clicked from, so reordering results does not silently throw the
         query away. #}
      {% set search_suffix = "&q=" ~ (search_query|urlencode) if search_query else "" %}
      <div class="hashtag-sort-controls">
        <span>{{ ftl_get_message("sort-by") }}:</span>
        <a href="/hashtags?sort=trending{{ search_suffix }}"
           class="{% if sort_by == 'trending' %}active{% endif %}">
          {{ ftl_get_message("sort-trending") }}
        </a>
        <a href="/hashtags?sort=popular{{ search_suffix }}"
           class="{% if sort_by == 'popular' %}active{% endif %}">
          {{ ftl_get_message("sort-popular") }}
        </a>
        <a href="/hashtags?sort=recent{{ search_suffix }}"
           class="{% if sort_by == 'recent' %}active{% endif %}">
          {{ ftl_get_message("sort-recent") }}
        </a>
        <a href="/hashtags?sort=alphabetical{{ search_suffix }}"
           class="{% if sort_by == 'alphabetical' %}active{% endif %}">
          {{ ftl_get_message("sort-alphabetical") }}
        </a>
      </div>
    </div>

    <div id="hashtag-results">
      {% include "hashtag_results.jinja" %}
    </div>
  </div>
{% endblock content %}
