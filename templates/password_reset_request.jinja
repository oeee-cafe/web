{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("password-reset-title") }}
{% endblock title %}
{% block content %}
  {# The three steps of a forgotten password are the sign-in page's card:
     someone who lands here is already stuck, and it should look like the
     door they were at. #}
  <div class="auth-page">
    <form method="post" class="ds-card auth-card">
      <h1 class="auth-title">{{ ftl_get_message("password-reset-title") }}</h1>
      <p class="auth-lede">{{ ftl_get_message("password-reset-description") }}</p>
      <div class="form-field">
        <label class="ds-label" for="email">{{ ftl_get_message("email") }}</label>
        <input class="ds-input" name="email" id="email" type="email" autocomplete="email" required autofocus />
      </div>
      <button type="submit" class="ds-button ds-button-primary auth-submit">{{ ftl_get_message("password-reset-send-email") }}</button>
      <a class="ds-button auth-secondary" href="/login">{{ ftl_get_message("back-to-login") }}</a>
    </form>
  </div>
{% endblock content %}
