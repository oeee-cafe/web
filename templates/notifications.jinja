{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("notifications") }}
{% endblock title %}
{% block content %}
  <div class="notifications-page">
    {% include "notifications_header.jinja" %}

    {# Invitations use the notification row's proportions — one line, time and
       controls on the right — so the two lists scan as one page rather than as
       two unrelated components stacked on each other. #}
    {% if invitations %}
      <div class="invitations-section">
        <h2 class="profile-section-label">{{ ftl_get_message("invitations-pending") }}</h2>
        {% for invitation in invitations %}
          <div class="notification invitation-item">
            <span class="notification-figure">
              <span class="notification-thumbnail-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
              </span>
            </span>
            <div class="notification-content">
              {# Same four pieces in the same order as before: the locales
                 write these as one sentence frame — "Invitation from" @who
                 "to join" Community — so the wording cannot be rearranged
                 without retranslating it. Only the layout changed. #}
              <p class="notification-line">
                {{ ftl_get_message("invitation-from") }}
                <a href="/@{{ invitation.inviter_login_name }}" class="notification-actor">@{{ invitation.inviter_login_name }}</a>
                {{ ftl_get_message("invitation-to-community") }}
                <a href="/communities/@{{ invitation.community_slug }}">{{ invitation.community_name }}</a>
              </p>
            </div>
            <div class="notification-meta">
              <time class="notification-time" title="{{ invitation.created_at|datetimeformat(format="short", tz="Asia/Seoul") }}">{{ invitation.created_at|ago }}</time>
              <div class="invitation-actions">
                <form method="post" action="/invitations/{{ invitation.id }}/accept">
                  <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("invitation-accept") }}</button>
                </form>
                <form method="post" action="/invitations/{{ invitation.id }}/reject">
                  <button type="submit" class="ds-button" data-haptic="light">{{ ftl_get_message("invitation-reject") }}</button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# No heading over this list: it is what the page is, and the h2 above
       already says so. The invitations block gets one because it is the
       section that is not notifications. #}
    {# Rows live in notifications_fragment.jinja so the first batch and every
       scrolled batch share one definition. #}
    {% if notifications %}
      <div class="notification-list" id="notification-list">
        {% include "notifications_fragment.jinja" %}
      </div>
    {% elif not invitations %}
      <div class="ds-card notifications-empty">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
        <p>{{ ftl_get_message("no-notifications") }}</p>
      </div>
    {% endif %}
  </div>
{% endblock content %}
