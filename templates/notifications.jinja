{% extends "base.jinja" %}
{% block title %}
  {{ ftl_get_message("brand") }}
{% endblock title %}
{% block content %}
  <div class="center">
    <div class="notifications-header">
      <h2 class="notifications-title">{{ ftl_get_message("notifications") }}</h2>
      {% if unread_notification_count > 0 %}
        <button class="notification-mark-all-button"
                hx-post="/notifications/mark-all-read"
                hx-swap="none"
                hx-on::after:request="window.location.reload()"
                hx-disable="this">
          {{ ftl_get_message("notification-mark-all-read") }}
        </button>
      {% endif %}
    </div>

    {# Invitations use the notification row's proportions — one line, time and
       controls on the right — so the two lists scan as one page rather than as
       two unrelated components stacked on each other. #}
    {% if invitations %}
      <div class="invitations-section">
        <h3 class="notifications-title">{{ ftl_get_message("invitations-pending") }}</h3>
        {% for invitation in invitations %}
          <div class="notification invitation-item">
            <div class="notification-content">
              {# Same four pieces in the same order as before: the locales
                 write these as one sentence frame — "Invitation from" @who
                 "to join" Community — so the wording cannot be rearranged
                 without retranslating it. Only the layout changed. #}
              <p class="notification-line">
                {{ ftl_get_message("invitation-from") }}
                <a href="/@{{ invitation.inviter_login_name }}" class="notification-actor">@{{ invitation.inviter_login_name }}</a>
                {{ ftl_get_message("invitation-to-community") }}
                <a href="/communities/@{{ invitation.community_slug }}">{{ invitation.community_name }}</a>
              </p>
            </div>
            <div class="notification-meta">
              <time class="notification-time muted">{{ invitation.created_at|datetimeformat(format="short", tz="Asia/Seoul") }}</time>
              <div class="notification-actions">
                <form method="post" action="/invitations/{{ invitation.id }}/accept">
                  <button type="submit" class="btn-accept">{{ ftl_get_message("invitation-accept") }}</button>
                </form>
                <form method="post" action="/invitations/{{ invitation.id }}/reject">
                  <button type="submit" class="btn-reject">{{ ftl_get_message("invitation-reject") }}</button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# No heading over this list: it is what the page is, and the h2 above
       already says so. The invitations block gets one because it is the
       section that is not notifications. #}
    {# Rows live in notifications_fragment.jinja so the first batch and every
       scrolled batch share one definition. #}
    {% if notifications %}
      <div class="notification-list">
        {% include "notifications_fragment.jinja" %}
      </div>
    {% elif not invitations %}
      <p>{{ ftl_get_message("no-notifications") }}</p>
    {% endif %}
  </div>
{% endblock content %}
