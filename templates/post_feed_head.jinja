{# Shared by every grid of drawings -- the feeds, the profile and drafts:
   the reader's chosen number of drawings a row, applied before the grid
   paints so it does not flash at the default.

   It sits in the body rather than the head because the nav is boosted, and a
   boosted response has its entire <head> thrown away bar the title -- left up
   there it would stop running the moment anyone reached a feed through the
   nav. At the top of the content it still runs before the grid below it is
   parsed, and htmx re-executes it on every boosted swap. #}
<script>
  (function () {
    var saved = null;
    try {
      saved = parseInt(localStorage.getItem("homeCols"), 10);
    } catch (error) {}
    if (saved >= 1 && saved <= 12) {
      var root = document.documentElement;
      root.style.setProperty("--home-cols", saved);
      // Kept in step with per_row_macro.jinja, which sets it on a change.
      root.setAttribute("data-homeCols-density", saved > 9 ? "bare" : saved > 6 ? "dense" : "");
    }
  })();
</script>
