<!DOCTYPE html>
<html lang="{{ ftl_lang }}">
  <head>
    <meta charset="UTF-8">
    {% include "theme_head.jinja" %}
    {# Held at its own scale: the painter zooms its canvas itself, and a pinch
       that starts off the canvas -- on a panel, or a room's chat -- would
       otherwise zoom the whole page, panels and all. WKWebView and Android's
       WebView honour this; Safari overrides it, which is its call. #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    {% include "presence_meta.jinja" %}
    <title>
      {% if parent_post %}Re: {{ parent_post.title }}{% else %}{{ ftl_get_message("community-drawing-new") }}{% endif %}
      {% if community_name %} @ {{ community_name }}{% endif %}
    </title>
    <link rel="stylesheet"
          href="{{ '/static/neo-cucumber/offline.css' | cachebuster | safe }}" />
    {# After the painter's own, so the toolbar is not restyled by its reset. #}
    <link rel="stylesheet"
          href="{{ '/static/ds.css' | cachebuster | safe }}" />
    <style>
      html, body { width: 100%; height: 100%; margin: 0; }
      body { overflow: hidden; }
      /* The page is the header and the painter, stacked. The painter fills
         what is left rather than pinning itself to the viewport, which is what
         used to hide chrome like this. `dvh` because `vh` counts the strip
         behind mobile Safari's URL bar. */
      #oeee-painter-page {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      /* The toolbar is the page's first row, as on every other page; it is
         in the document before the painter mounts, so the area the painter
         measures is already the one it will keep. */
      #oeee-painter-page > .nav-bar { flex: 0 0 auto; position: relative; }
      #oeee-painter-page > .ds-notices { flex: 0 0 auto; }
      #neo-cucumber-root { flex: 1 1 auto; min-height: 0; }
    </style>
  </head>
  <body>
    {# No bar of the painter's own under the toolbar: the toolbar is the way
       off this page, and what a bar would say -- the drawing's title, its
       community, its size -- is in the page title. #}
    <div id="oeee-painter-page">
      {% include "toolbar.jinja" %}
      {# A guest learns before drawing where the drawing will be kept: in this
         browser, until they sign in and post it from their drafts. #}
      {% if not current_user %}
        <ul class="ds-notices">
          <li class="ds-notice">{{ ftl_get_message("draw-guest-notice") }}&nbsp;<a href="/login?next=%2Fposts%2Fdrafts">{{ ftl_get_message("sign-in") }}</a></li>
        </ul>
      {% endif %}
      <div id="neo-cucumber-root"></div>
    </div>
    <button id="oeee-painter-save" type="button" disabled
            data-confirm="{{ ftl_get_message("draw-save-confirm") }}"
            data-cancel="{{ ftl_get_message("cancel") }}"
            style="position:fixed;top:61px;right:8px;z-index:80">{{ ftl_get_message("save") }}</button>
    {% include "confirm_dialog.jinja" %}
    <script id="neo-cucumber-config" type="application/json">{{ painter_config | safe }}</script>
    {# What saving says, beyond the button's own words; read by the adapter
       (frontend/painter/entry.ts). #}
    <script id="oeee-painter-words" type="application/json">{{ {
      "guestSaveConfirm": ftl_get_message("draw-guest-save-confirm"),
      "guestSavedTitle": ftl_get_message("draw-guest-saved-title"),
      "guestSaved": ftl_get_message("draw-guest-saved"),
      "localSaveFailed": ftl_get_message("draw-local-save-failed"),
      "uploadFailedKept": ftl_get_message("draw-upload-failed-kept"),
      "uploadFailedLost": ftl_get_message("draw-upload-failed-lost"),
      "signIn": ftl_get_message("sign-in"),
      "signUp": ftl_get_message("sign-up"),
      "downloadPng": ftl_get_message("draw-download-png"),
      "done": ftl_get_message("draw-done"),
      "keepDrawing": ftl_get_message("draw-keep-drawing"),
    }|tojson }}</script>
    <script type="module"
            src="{{ '/static/neo-cucumber/offline.js' | cachebuster | safe }}"></script>
  </body>
</html>
