{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("password-reset-verify-title") }}
{% endblock title %}
{% block content %}
  <div class="auth-page">
    <form method="post" class="ds-card auth-card">
      <h1 class="auth-title">{{ ftl_get_message("password-reset-verify-title") }}</h1>
      <input name="token" type="hidden" value="{{ token }}" required />
      <div class="form-field">
        <label class="ds-label" for="new_password">{{ ftl_get_message("account-change-password-new") }}</label>
        <input class="ds-input" name="new_password" id="new_password" type="password" autocomplete="new-password" required autofocus />
      </div>
      <div class="form-field">
        <label class="ds-label" for="new_password_confirm">{{ ftl_get_message("account-change-password-new-repeat") }}</label>
        <input class="ds-input" name="new_password_confirm" id="new_password_confirm" type="password" autocomplete="new-password" required />
      </div>
      <button type="submit" class="ds-button ds-button-primary auth-submit">{{ ftl_get_message("password-reset-submit") }}</button>
      <a class="ds-button auth-secondary" href="/login">{{ ftl_get_message("back-to-login") }}</a>
    </form>
  </div>
{% endblock content %}
