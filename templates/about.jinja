{% from "storage_macro.jinja" import stored_url %}
{% extends "base.jinja" %}
{% from "supporter_badge_macro.jinja" import supporter_mark %}
{% from "app_stores_macro.jinja" import app_stores %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("nav-about") }}
{% endblock title %}
{% block content %}
  {# What the site is, as an application's About window says it: the name
     and a line on what it is and where else to get it, then where else to find
     it, the documents it keeps, and the people who draw here -- each a
     button or a chip rather than a bulleted list of links. #}
  <div class="profile about-page">
    <section class="profile-card ds-card about-card">
      <div class="profile-identity">
        <h1 class="profile-name">{{ ftl_get_message("brand") }}</h1>
        <p class="about-lede">{{ ftl_get_message("about") }}</p>
        {{ app_stores(ftl_lang) }}
      </div>
    </section>

    <section class="profile-section">
      <div class="profile-section-label">{{ ftl_get_message("about-elsewhere") }}</div>
      <div class="profile-chips">
        <a class="profile-chip" href="https://planet.moe/@oeee_cafe" target="_blank" rel="noopener">Fediverse · @oeee_cafe<span class="profile-chip-out" aria-hidden="true">↗</span></a>
        <a class="profile-chip" href="https://github.com/oeee-cafe" target="_blank" rel="noopener">GitHub · oeee-cafe<span class="profile-chip-out" aria-hidden="true">↗</span></a>
        <a class="profile-chip" href="https://x.com/oeee_cafe" target="_blank" rel="noopener">X · @oeee_cafe<span class="profile-chip-out" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="profile-section">
      <div class="profile-section-label">{{ ftl_get_message("about-documents") }}</div>
      <div class="about-buttons">
        <a class="ds-button" href="/policy">{{ ftl_get_message("community-guidelines") }}</a>
        <a class="ds-button" href="/privacy">{{ ftl_get_message("privacy-policy") }}</a>
        <a class="ds-button" href="/design">{{ ftl_get_message("about-design") }}</a>
      </div>
    </section>

    {% if supporters|length > 0 %}
      {# The credits: everyone who bought this year's Supporter Pack,
         whoever has been at it longest first, unless they asked to be left
         off on their account page. Every supporter mark on the site leads
         here, and each chip wears the mark of the platform that person
         bought this year's pack on. #}
      <section class="profile-section" id="supporters">
        <div class="profile-section-label">{{ ftl_get_message("about-supporters") }}</div>
        <p class="ds-help about-supporters-thanks">{{ ftl_get_message("about-supporters-thanks") }}</p>
        <div class="profile-chips">
          {% for supporter in supporters %}
            <a class="profile-chip supporter-chip ds-marked" href="/@{{ supporter.login_name }}" title="@{{ supporter.login_name }}">{{ supporter_mark(supporter.mark) }}{{ supporter.display_name }}</a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if users_with_public_posts_and_banner|length > 0 %}
      {# Everyone who draws here in the open and has a banner, as a wall of
         their banners -- each drawn by its owner, so the wall says who they
         are better than their names would. The name is the tooltip. #}
      <section class="profile-section">
        <div class="profile-section-label">{{ ftl_get_message("user-contributors") }}</div>
        <div class="about-banners">
          {% for user in users_with_public_posts_and_banner %}
            <a class="about-banner" href="/@{{ user.login_name }}" title="{{ user.display_name }} (@{{ user.login_name }})">
              {# Banners are drawn at 200 by 40; the query behind this page does
                 not return their size, and the frame keeps that shape itself. #}
              <img width="200"
                   height="40"
                   alt="{{ user.display_name }} (@{{ user.login_name }})"
                   loading="lazy"
                   decoding="async"
                   src="{{ stored_url("image", user.banner_image_filename) }}" />
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if git_commit %}
      {# Which commit is serving, for anyone reporting a bug; unset outside
         a deployed image, and then there is nothing to say. #}
      <section class="profile-section">
        <div class="profile-section-label">{{ ftl_get_message("about-version") }}</div>
        <div class="profile-chips">
          <a class="profile-chip about-version" href="https://github.com/oeee-cafe/web/commit/{{ git_commit }}" target="_blank" rel="noopener" title="{{ git_commit }}">{{ git_commit[:12] }}<span class="profile-chip-out" aria-hidden="true">↗</span></a>
        </div>
      </section>
    {% endif %}
  </div>
{% endblock content %}
