{# A saved password, in the Mac app.

   Safari fills a form from the reader's saved passwords, and so does iOS
   in any app's web view, above its keyboard. A web view in a Mac app gets
   neither: the Mac offers saved passwords only on its own text fields. So
   there the page asks the app, which asks the system with a sheet of its
   own for a password saved for this site (webcredentials:oeee.cafe), and
   the page fills the form with what the reader picked.

   It is asked when the reader goes to a field of a form marked
   data-saved-password -- presses it, or tabs to it -- and not when the page
   puts the caret there itself (an autofocus), so the sheet never
   comes up on its own. Once a form: put away, it is not offered again
   until the page is, so a reader who meant to type is not asked at every
   press. A form's mark says what the password is for:

     sign-in   the username and the password, and the form is sent
               (login.jinja)
     confirm   the password only, and the reader sends it: a saved
               password never deletes an account by itself (account.jinja)

   Its own message and its own answer, never signIn's: an answer carries the
   id it was asked with, and the page takes only the one it is waiting for,
   so neither can be taken for the other's (app_sign_in.jinja).

     password         {id}
     password.answer  ({id, username, password}), or ({id, cancelled}) for
                      none picked, none saved, or a sheet already up #}
<script>
  (function () {
    if (!window.oeeeApp) return;
    // Only the Mac app asks; the answer is on every page, as every member is.
    var asking = document.documentElement.getAttribute("data-app") === "macos";

    var FIELDS = /^(username|current-password)$/;

    // The form the sheet is up for, and the id it was asked with. One at a time.
    var asked = null;
    var count = 0;
    var offered = new WeakSet();

    // Whether the field was reached with Tab, which is the keyboard's press.
    var tabbing = false;
    document.addEventListener("keydown", function (event) {
      tabbing = event.key === "Tab";
    }, true);

    function form(target) {
      var field = target && target.closest ? target.closest("input") : null;
      if (!field || !FIELDS.test(field.getAttribute("autocomplete") || "")) return null;
      var owner = field.form;
      return owner && owner.hasAttribute("data-saved-password") ? owner : null;
    }

    function offer(target) {
      var owner = form(target);
      if (!asking || !owner || asked || offered.has(owner)) return;
      offered.add(owner);
      var id = String(++count);
      if (window.oeeeApp.post("password", { id: id }, true)) asked = { id: id, form: owner };
    }

    document.addEventListener("pointerdown", function (event) {
      tabbing = false;
      offer(event.target);
    }, true);
    document.addEventListener("focusin", function (event) {
      if (tabbing) offer(event.target);
    }, true);

    function fill(field, value) {
      if (!field) return;
      field.value = value;
      field.dispatchEvent(new Event("input", { bubbles: true }));
      field.dispatchEvent(new Event("change", { bubbles: true }));
    }

    function answer(told) {
      told = told || {};
      var request = asked;
      if (!request || told.id !== request.id) return;
      asked = null;
      var owner = request.form;
      // None picked or none saved: the reader types, as they would have.
      if (!owner.isConnected || typeof told.password !== "string" || !told.password) return;

      var password = owner.querySelector('input[autocomplete="current-password"]');
      if (owner.getAttribute("data-saved-password") !== "sign-in") {
        fill(password, told.password);
        if (password) password.focus();
        return;
      }
      fill(owner.querySelector('input[autocomplete="username"]'), told.username || "");
      fill(password, told.password);
      if (owner.requestSubmit) owner.requestSubmit();
      else owner.submit();
    }

    window.oeeeApp.password = { answer: answer };
  })();
</script>
