{% extends "base.jinja" %}
{% block title %}
  {{ ftl_get_message("brand") }}
{% endblock title %}
{% block head %}
{% endblock head %}
{% block content %}
  {% include "post_feed_head.jinja" %}
  <div class="center-wide">
    {# The public post grid is the whole page: communities and recent comments
       moved off home. Cards, controls and page chrome are shared with /home so
       the two feeds stay identical. #}
    {% if feed.posts and feed.posts|length > 0 %}
      <section role="region" aria-labelledby="post-feed-heading">
        {# Short view label rather than naming the visibility rule the query
           uses. Reuses the key the hashtag and community pages already put
           above their drawing grids. #}
        <div class="feed-header">
          <h2 id="post-feed-heading" class="home-section-title">{{ ftl_get_message("recent-drawings") }}</h2>
          {% include "post_feed_controls.jinja" %}
        </div>
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      </section>
    {% endif %}
  </div>
{% endblock content %}
