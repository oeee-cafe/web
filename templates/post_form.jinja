{% extends "base.jinja" %}
{% block head %}
  <script>
    // The tag field's suggestion menu. It used to answer a click and nothing
    // else, inside a container that announced itself as a listbox — so anyone
    // working from the keyboard, and anyone on a screen reader, had a menu they
    // could neither reach nor dismiss.
    document.addEventListener('DOMContentLoaded', function () {
      var input = document.getElementById('hashtags-input');
      var menu = document.getElementById('hashtag-suggestions');
      if (!input || !menu) return;

      // The separators the server splits on, so the tag being typed is the same
      // one either side sees. The full-width forms are what an IME emits.
      var SEPARATORS = /[\s,\u3001\uFF0C#\uFF03]+/;
      var active = -1;

      function options() {
        return Array.prototype.slice.call(
          menu.querySelectorAll('.hashtag-autocomplete-item')
        );
      }

      function highlight(index) {
        var items = options();
        active = items.length ? (index + items.length) % items.length : -1;
        items.forEach(function (item, i) {
          var on = i === active;
          item.classList.toggle('is-active', on);
          item.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        input.setAttribute(
          'aria-activedescendant',
          active >= 0 ? items[active].id : ''
        );
      }

      function close() {
        menu.innerHTML = '';
        active = -1;
        input.setAttribute('aria-expanded', 'false');
        input.setAttribute('aria-activedescendant', '');
      }

      function choose(item) {
        var tags = input.value.split(SEPARATORS).filter(function (t) {
          return t.trim();
        });
        tags.pop(); // the partial tag this suggestion replaces
        tags.push(item.dataset.hashtag);
        input.value = tags.join(', ') + ', ';
        close();
        input.focus();
      }

      menu.addEventListener('click', function (e) {
        var item = e.target.closest('.hashtag-autocomplete-item');
        if (item) choose(item);
      });

      menu.addEventListener('mousemove', function (e) {
        var item = e.target.closest('.hashtag-autocomplete-item');
        if (item) highlight(options().indexOf(item));
      });

      input.addEventListener('keydown', function (e) {
        var items = options();
        if (e.key === 'Escape') {
          close();
          return;
        }
        if (!items.length) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlight(active + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlight(active - 1);
        } else if (e.key === 'Enter' && active >= 0) {
          // Only when a suggestion is highlighted: otherwise Enter still
          // submits the post, which is what it does with the menu closed.
          e.preventDefault();
          choose(items[active]);
        }
      });

      // A fresh batch of suggestions starts with nothing highlighted.
      menu.addEventListener('htmx:afterSwap', function () {
        active = -1;
        input.setAttribute('aria-expanded', options().length ? 'true' : 'false');
        input.setAttribute('aria-activedescendant', '');
      });

      document.addEventListener('click', function (e) {
        if (!menu.contains(e.target) && e.target !== input) close();
      });
    });
  </script>
{% endblock head %}
{% block content %}
  {# Publishing a drawing, laid out as the post it will become: the drawing on
     the ground at the left, at the same whole-step zoom as the post page, and
     beside it one card -- what the drawing is so far, what it will be called
     and said about it, the three switches as a grouped list, and the button
     that publishes it. Deleting is set apart at the card's foot. #}
  <div class="post-page publish-page">
    <div class="post-stage">
      <div class="post-stage-column">
        <div class="post-stage-frame" data-post-stage
             data-width="{{ post.image_width }}" data-height="{{ post.image_height }}">
          <img draggable="false" class="post-stage-image"
               width="{{ post.image_width }}"
               height="{{ post.image_height }}"
               alt="{{ ftl_get_message("draft-post") }}"
               src="{{ r2_public_endpoint_url }}/image/{{ post.image_filename[:2] }}/{{ post.image_filename }}" />
        </div>
      </div>
    </div>

    <div class="post-side">
      <section class="ds-card post-inspector">
        <h1 class="post-inspector-title">{{ ftl_get_message("post-publish") }}</h1>
        <dl class="post-inspector-facts publish-facts">
          <dt>{{ ftl_get_message("post-created-at") }}</dt>
          <dd>{{ post.created_at }}</dd>
          <dt>{{ ftl_get_message("post-duration") }}</dt>
          <dd>{{ post.paint_duration }}</dd>
          <dt>{{ ftl_get_message("community") }}</dt>
          <dd>{% if link %}<a href="{{ link }}">{{ post.community_name }}</a>{% else %}{{ ftl_get_message("personal-post") }}{% endif %}</dd>
        </dl>

        <form action="/posts/publish" method="post" class="publish-form">
          <input type="hidden" name="post_id" value="{{ post.id }}" />
          <div class="form-field">
            <label class="ds-label" for="title">{{ ftl_get_message("post-title") }}</label>
            <input class="ds-input" type="text" id="title" name="title"
                   required minlength="1" maxlength="200" aria-required="true" autofocus />
          </div>
          <div class="form-field">
            <label class="ds-label" for="content">{{ ftl_get_message("post-description") }}</label>
            <textarea class="ds-textarea" id="content" name="content"
                      required minlength="1" maxlength="5000" rows="4" aria-required="true"></textarea>
          </div>
          <div class="form-field">
            <label class="ds-label" for="hashtags-input">{{ ftl_get_message("post-hashtags") }}</label>
            <div class="hashtag-input-container">
              {# hx-vals sends only the tag being typed. #}
              <input class="ds-input"
                     type="text"
                     id="hashtags-input"
                     name="hashtags"
                     placeholder="{{ ftl_get_message("post-hashtags-placeholder") }}"
                     autocomplete="off"
                     maxlength="500"
                     role="combobox"
                     aria-expanded="false"
                     aria-controls="hashtag-suggestions"
                     aria-autocomplete="list"
                     aria-describedby="hashtags-hint"
                     hx-get="/api/hashtags/autocomplete"
                     hx-trigger="keyup changed delay:300ms"
                     hx-target="#hashtag-suggestions"
                     hx-vals='js:{q: document.getElementById("hashtags-input").value.split(/[\s,\u3001\uFF0C#\uFF03]+/).pop()}'
                     hx-indicator="#hashtag-autocomplete-indicator" />
              <span id="hashtag-autocomplete-indicator"
                    class="htmx-indicator search-indicator"
                    role="status">{{ ftl_get_message("searching") }}</span>
              <div id="hashtag-suggestions"
                   class="hashtag-autocomplete"
                   role="listbox"
                   aria-label="{{ ftl_get_message("post-hashtags") }}"></div>
            </div>
            <span id="hashtags-hint" class="ds-help">{{ ftl_get_message("post-hashtags-hint") }}</span>
          </div>

          {# The three switches as a settings pane lists them: one row each,
             the whole row the target. #}
          <div class="community-form-choices publish-switches">
            <label class="community-form-choice">
              <input type="checkbox" id="is_sensitive" name="is_sensitive" />
              <span class="community-form-choice-name">{{ ftl_get_message("sensitive") }}</span>
            </label>
            <label class="community-form-choice">
              <input type="checkbox" id="allow_relay" name="allow_relay" checked />
              <span class="community-form-choice-name">{{ ftl_get_message("allow-relay") }}</span>
            </label>
            <label class="community-form-choice">
              <input type="checkbox" id="allow_replay" name="allow_replay" checked />
              <span class="community-form-choice-name">{{ ftl_get_message("allow-replay") }}</span>
            </label>
          </div>

          <button type="submit" class="ds-button ds-button-primary auth-submit">{{ ftl_get_message("post-publish") }}</button>
        </form>

        <div class="publish-foot">
          <a class="ds-button" href="/posts/drafts">{{ ftl_get_message("drafts") }}</a>
          <form hx-delete="/posts/{{ post_id }}"
                hx-confirm="{{ ftl_get_message("post-delete-confirm") }}"
                hx-target="body"
                class="delete-form"
                hx-disable="find button">
            <button type="submit" class="ds-button ds-button-danger">{{ ftl_get_message("delete") }}</button>
          </form>
        </div>
      </section>
    </div>
  </div>
  <script>
    (function () {
      // The post page's stage: whole steps up to what fits.
      var stageBox = document.querySelector("[data-post-stage]");
      function fitStage() {
        var width = parseInt(stageBox.getAttribute("data-width"), 10);
        var height = parseInt(stageBox.getAttribute("data-height"), 10);
        var room = stageBox.parentNode.parentNode.clientWidth;
        var tall = window.innerWidth > 600 ? Math.max(window.innerHeight - 190, height) : Infinity;
        var zoom = Math.max(1, Math.min(Math.floor(room / width), Math.floor(tall / height), 4));
        if (width * zoom > room) zoom = 1;
        if (zoom > 1) stageBox.style.setProperty("--post-stage-shown", (width * zoom) + "px");
        else stageBox.style.removeProperty("--post-stage-shown");
        stageBox.classList.toggle("is-zoomed", zoom > 1);
      }
      fitStage();
      window.addEventListener("resize", fitStage);
    })();
  </script>
{% endblock content %}
