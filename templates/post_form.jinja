{% from "storage_macro.jinja" import stored_url %}
{% extends "base.jinja" %}
{% block head %}
  <script>if (window.oeeeChrome) window.oeeeChrome.tagSuggestions();</script>
{% endblock head %}
{% block content %}
  {# Publishing a drawing, laid out as the post it will become: the drawing on
     the ground at the left, as large as on the post page, and
     beside it one card -- what the drawing is so far, what it will be called
     and said about it, the three switches as a grouped list, and the button
     that publishes it. Deleting is set apart at the card's foot. #}
  <div class="post-page publish-page">
    <div class="post-stage">
      <div class="post-stage-column">
        <div class="post-stage-frame" data-post-stage
             data-width="{{ post.image_width }}" data-height="{{ post.image_height }}">
          <img class="post-stage-image" data-oeee-drawing
               width="{{ post.image_width }}"
               height="{{ post.image_height }}"
               alt="{{ ftl_get_message("draft-post") }}"
               src="{{ stored_url("image", post.image_filename) }}" />
        </div>
      </div>
    </div>

    <div class="post-side">
      <section class="ds-card post-inspector">
        <h1 class="post-inspector-title">{{ ftl_get_message("post-publish") }}</h1>
        <dl class="post-inspector-facts publish-facts">
          <dt>{{ ftl_get_message("post-created-at") }}</dt>
          <dd>{{ post.created_at }}</dd>
          <dt>{{ ftl_get_message("post-duration") }}</dt>
          <dd>{{ post.paint_duration }}</dd>
          <dt>{{ ftl_get_message("community") }}</dt>
          <dd>{% if link %}<a href="{{ link }}">{{ post.community_name }}</a>{% else %}{{ ftl_get_message("personal-post") }}{% endif %}</dd>
        </dl>

        <form action="/posts/publish" method="post" class="publish-form">
          <input type="hidden" name="post_id" value="{{ post.id }}" />
          <div class="form-field">
            <label class="ds-label" for="title">{{ ftl_get_message("post-title") }}</label>
            <input class="ds-input" type="text" id="title" name="title"
                   required minlength="1" maxlength="200" aria-required="true" autofocus />
          </div>
          <div class="form-field">
            <label class="ds-label" for="content">{{ ftl_get_message("post-description") }}</label>
            <textarea class="ds-textarea" id="content" name="content"
                      required minlength="1" maxlength="5000" rows="4" aria-required="true"></textarea>
          </div>
          <div class="form-field">
            <label class="ds-label" for="tags-input">{{ ftl_get_message("post-tags") }}</label>
            <div class="tag-input-container">
              {# hx-vals sends only the tag being typed. #}
              <input class="ds-input"
                     type="text"
                     id="tags-input"
                     name="tags"
                     placeholder="{{ ftl_get_message("post-tags-placeholder") }}"
                     autocomplete="off"
                     maxlength="500"
                     role="combobox"
                     aria-expanded="false"
                     aria-controls="tag-suggestions"
                     aria-autocomplete="list"
                     aria-describedby="tags-hint"
                     hx-get="/api/tags/autocomplete"
                     hx-trigger="keyup changed delay:300ms"
                     hx-target="#tag-suggestions"
                     hx-vals='js:{q: document.getElementById("tags-input").value.split(/[\s,\u3001\uFF0C#\uFF03]+/).pop()}' />
              <div id="tag-suggestions"
                   class="tag-autocomplete"
                   role="listbox"
                   aria-label="{{ ftl_get_message("post-tags") }}"></div>
            </div>
            <span id="tags-hint" class="ds-help">{{ ftl_get_message("post-tags-hint") }}</span>
          </div>

          {# The three switches as a settings pane lists them: one row each,
             the whole row the target. #}
          <div class="community-form-choices publish-switches">
            <label class="community-form-choice">
              <input type="checkbox" id="is_sensitive" name="is_sensitive" />
              <span class="community-form-choice-name">{{ ftl_get_message("sensitive") }}</span>
            </label>
            <label class="community-form-choice">
              <input type="checkbox" id="allow_relay" name="allow_relay" checked />
              <span class="community-form-choice-name">{{ ftl_get_message("allow-relay") }}</span>
            </label>
            <label class="community-form-choice">
              <input type="checkbox" id="allow_replay" name="allow_replay" checked />
              <span class="community-form-choice-name">{{ ftl_get_message("allow-replay") }}</span>
            </label>
          </div>

          <button type="submit" class="ds-button ds-button-primary auth-submit">{{ ftl_get_message("post-publish") }}</button>
        </form>

        <div class="publish-foot">
          <a class="ds-button" href="/posts/drafts">{{ ftl_get_message("drafts") }}</a>
          {# Back into the painter with it, to carry on where it was saved
             (draw.rs `continue_draft`). #}
          {% if continuable %}<a class="ds-button" href="/posts/{{ post_id }}/continue">{{ ftl_get_message("draft-continue") }}</a>{% endif %}
          <form hx-delete="/posts/{{ post_id }}"
                hx-confirm="{{ ftl_get_message("post-delete-confirm") }}"
                hx-target="body"
                class="delete-form"
                hx-disable="find button">
            <button type="submit" class="ds-button ds-button-danger">{{ ftl_get_message("delete") }}</button>
          </form>
        </div>
      </section>
    </div>
  </div>
  <script>if (window.oeeeChrome) window.oeeeChrome.publishStage();</script>
{% endblock content %}
