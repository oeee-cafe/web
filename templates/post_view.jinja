{% import "comments_macro.jinja" as comments_macro %}
{% from "supporter_badge_macro.jinja" import supporter_badge %}

{# A drawing in a thread -- the one this replies to, or one replying to it:
   a small framed square and what it is, as one target. Replies to replies
   step in under their parent. #}
{% macro render_post_card(post, depth) %}
  <div class="post-thread-item" style="margin-left: {{ depth * 16 }}px">
    <a href="/@{{ post.user_login_name }}/{{ post.id }}" class="post-thread-card">
      <span class="post-thread-thumb">
        <img src="{{ r2_public_endpoint_url }}/image/{{ post.image_filename[:2] }}/{{ post.image_filename }}"
             alt=""
             loading="lazy"
             decoding="async" />
      </span>
      <span class="post-thread-text">
        <span class="post-thread-title">{% if post.title %}{{ post.title }}{% else %}{{ ftl_get_message("post-no-title") }}{% endif %}</span>
        <span class="post-thread-meta">
          {{ post.user_display_name }}
          {% if post.published_at %}· {{ post.published_at|ago }}{% endif %}
          {% if post.comments_count > 0 %}· {{ post.comments_count }} {{ ftl_get_message("post-comments") }}{% endif %}
        </span>
      </span>
    </a>
    {% if post.children %}
      {% for child in post.children %}
        {{ render_post_card(child, depth + 1) }}
      {% endfor %}
    {% endif %}
  </div>
{% endmacro %}

{% extends "base.jinja" %}
{% block title %}
  {{ super() }} |
  {% if post.title %}
    {{ post.title }}
  {% else %}
    {{ ftl_get_message("post-no-title") }}
  {% endif %}
{% endblock title %}
{% block social_meta %}
  {% if not post_community or post_community.visibility != "private" %}
    <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ post.title }}" />
    <meta property="og:description" content="{{ post.content }}" />
    {# Canonical post URL is /@slug-or-login-name/id, the same form the page
       links to itself by; /posts/id only redirects there. #}
    <meta property="og:url"
          content="{{ base_url|safe }}/@{{ post.login_name }}/{{ post_id }}" />
    <meta property="og:image"
          content="{{ r2_public_endpoint_url|safe }}/image/{{ post.image_filename[:2] }}/{{ post.image_filename }}" />
    <meta property="og:image:width" content="{{ post.image_width }}" />
    <meta property="og:image:height" content="{{ post.image_height }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@oeee_cafe" />
  {% endif %}
{% endblock social_meta %}
{% block head %}
  {% if not post_community or post_community.visibility != "private" %}
    <link rel="alternate"
          type="application/activity+json"
          href="https://{{ domain }}/ap/posts/{{ post.id }}" />
  {% else %}
    <meta name="robots" content="noindex, nofollow">
  {% endif %}
{% endblock head %}
{% block content %}
  {# A drawing, laid out as an application shows a document: the drawing on
     the ground, as the painter shows it, and beside it one card that says
     what it is and what you can do with it; then the drawings answering it
     and the conversation. On a phone the card follows the drawing. #}
  {# The reply-with-drawing sizes, as the community page offers them. #}
  {% set reply_widths = [300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 800, 850, 900, 950, 1000, 1024] %}
  {% set reply_heights = [300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 768, 800] %}
  {% set can_relay = post.image_tool in ["neo", "neo-cucumber", "cucumber"] and post.allow_relay == "true" %}
  {% set can_watch_replay = post.replay_filename and (post.allow_replay == "true" or current_user.id == post.author_id or current_user.role == "admin") %}
  {% set inline_replay = can_watch_replay and post.replay_filename[-4:] == ".pch" %}
  {% set two_tone = post_community and post_community.background_color and post_community.foreground_color %}
  <div class="post-page">
    <div class="post-stage">
      <div class="post-stage-column">
        {# Shown at a whole multiple of its own size that fits, as the painter
           zooms -- a fractional step would make some pixels wider than
           others. Larger than the stage, it is scaled down smoothly.

           A NEO drawing whose replay may be watched carries the replay's
           controls under it from the start: the viewer mounts over this box
           with the drawing as its poster and fetches the recording only when
           a control is used. The image inside is what shows until it does,
           and what shows without script. #}
        {% set image_url = r2_public_endpoint_url ~ "/image/" ~ post.image_filename[:2] ~ "/" ~ post.image_filename %}
        <div class="{% if inline_replay %}post-stage-replay{% else %}post-stage-frame{% endif %}" data-post-stage
             data-width="{{ post.image_width }}" data-height="{{ post.image_height }}"
             style="--post-stage-shown: {{ post.image_width }}px"
             {% if inline_replay %}
               id="post-stage-replay"
               data-replay="{{ r2_public_endpoint_url|safe }}/replay/{{ post.replay_filename[:2] }}/{{ post.replay_filename }}"
               data-poster="{{ image_url }}"
               data-lang="{{ ftl_lang }}"
             {% endif %}>
          <img class="post-stage-image" data-oeee-drawing
               width="{{ post.image_width }}"
               height="{{ post.image_height }}"
               alt="{{ post.title }}"
               src="{{ image_url }}" />
        </div>
      </div>
    </div>

    <div class="post-side">
      {% if parent_post_data %}
        <section class="post-thread">
          <div class="profile-section-label">{{ ftl_get_message("post-replying-to") }}</div>
          {{ render_post_card(parent_post_data, 0) }}
        </section>
      {% endif %}

      <section class="ds-card post-inspector">
        {# Who drew it, above what it is called, as a byline sits over a
           headline; the people who drew it together follow. #}
        <div class="post-inspector-byline">
          <a class="post-inspector-author" href="/@{{ post.login_name }}">{{ post.display_name }}</a>
          {{ supporter_badge(supporters, post.login_name) }}
          <span class="post-inspector-handle">@{{ post.login_name }}</span>
          {% for participant in collaborative_participants %}
            {% if participant.login_name != post.login_name %}
              <span class="post-inspector-handle">·</span>
              <a class="post-inspector-author" href="/@{{ participant.login_name }}" title="@{{ participant.login_name }}">{{ participant.display_name }}</a>
              {{ supporter_badge(supporters, participant.login_name) }}
            {% endif %}
          {% endfor %}
        </div>
        {% block post_edit_block %}
          <div id="post-edit-container" hx-target="this" hx-swap="outerHTML">
            <h1 class="post-inspector-title">
              {% if post.title %}{{ post.title }}{% else %}{{ ftl_get_message("post-no-title") }}{% endif %}
            </h1>
            {% if post.content %}
              <div class="post-inspector-description ds-selectable">{{ post.content|markdown|safe }}</div>
            {% endif %}
            {% if hashtags %}
              <div class="post-inspector-tags">
                {% for hashtag in hashtags %}
                  <a href="/hashtags/{{ hashtag.name|urlencode }}" class="profile-chip">#{{ hashtag.display_name }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endblock post_edit_block %}

        <dl class="post-inspector-facts">
          {% if post.published_at %}
            <dt>{{ ftl_get_message("post-published-at") }}</dt>
            <dd title="{{ post.published_at }}">{{ post.published_at_utc|ago if post.published_at_utc else post.published_at }}</dd>
          {% endif %}
          <dt>{{ ftl_get_message("post-duration") }}</dt>
          <dd>
            {{ post.paint_duration }}
            {# A replay the author has closed is still linked for the author
               themselves and for staff, labelled either way so whoever is
               looking can tell the link is not one the public gets. #}
            {% if can_watch_replay %}
              {# A NEO replay's controls are under the drawing; only Tegaki's,
                 which takes the whole window, is a link to its own page. #}
              {% if not inline_replay %}
                <a class="post-inspector-inline" href="/@{{ post.login_name }}/{{ post_id }}/replay">{{ ftl_get_message("post-replay") }}</a>
              {% endif %}
              {% if post.allow_replay != "true" %}
                <span class="muted">({{ ftl_get_message("replay-private" if current_user.id == post.author_id else "replay-private-staff") }})</span>
              {% endif %}
            {% endif %}
          </dd>
          {% if post.community_slug or (current_user.id == post.author_id and not post.parent_post_id) %}
            <dt>{{ ftl_get_message("community") }}</dt>
            <dd>
              {% if post.community_slug %}
                <a href="/communities/@{{ post.community_slug }}">{{ post.community_name }}</a>
                {% if current_user.id == post.author_id and (not post_community or post_community.visibility != "private") and not post.parent_post_id and not two_tone %}
                  <a class="post-inspector-inline" href="/@{{ post.login_name }}/{{ post_id }}/edit/community">{{ ftl_get_message("edit") }}</a>
                {% endif %}
              {% else %}
                <a class="post-inspector-inline" href="/@{{ post.login_name }}/{{ post_id }}/edit/community">{{ ftl_get_message("edit-community-button") }}</a>
              {% endif %}
            </dd>
          {% endif %}
          <dt>HIT</dt>
          <dd>{{ post.viewer_count }}</dd>
        </dl>

        <div class="post-reactions-container">{% include "post_reactions.jinja" %}</div>

        <div class="post-inspector-actions">
          {% if current_user %}
            <button type="button" class="ds-button ds-button-primary" onclick="showPostDrawModal()">{{ ftl_get_message("post-reply-with-drawing") }}</button>
            {% if can_relay %}
              <a class="ds-button" href="/@{{ post.login_name }}/{{ post_id }}/relay">{{ ftl_get_message("post-relay") }}</a>
            {% endif %}
          {% endif %}
          <button type="button" class="ds-button" data-share-url="{{ base_url|safe }}/@{{ post.login_name }}/{{ post_id }}"
                  data-share-title="{{ post.title or ftl_get_message('post-no-title') }}"
                  data-share-copied="{{ ftl_get_message('post-share-copied') }}"
                  onclick="sharePost(this)">{{ ftl_get_message("post-share") }}</button>
          {% if current_user and current_user.id == post.author_id %}
            <button type="button" class="ds-button" hx-get="/posts/{{ post_id }}/edit" hx-target="#post-edit-container" hx-swap="outerHTML">{{ ftl_get_message("edit") }}</button>
            <form hx-delete="/posts/{{ post_id }}"
                  hx-confirm="{{ ftl_get_message('post-delete-confirm') }}"
                  hx-target="body"
                  hx-disable="find button">
              <button type="submit" class="ds-button ds-button-danger">{{ ftl_get_message("delete") }}</button>
            </form>
          {% elif current_user %}
            <button type="button" class="ds-button" onclick="showReportModal()">{{ ftl_get_message("post-report") }}</button>
          {% endif %}
        </div>
      </section>

      {% if child_posts %}
        <section class="post-thread">
          <div class="profile-section-label">{{ ftl_get_message("post-child-posts") }}</div>
          {% for child in child_posts %}
            {{ render_post_card(child, 0) }}
          {% endfor %}
        </section>
      {% endif %}

      <section class="ds-card post-comments" aria-labelledby="post-comments-heading">
        <h2 id="post-comments-heading" class="profile-section-label">{{ ftl_get_message("post-comments") }}</h2>
        {# The list alone is what posting a comment replaces; the form stays.
           It used to be inside the replaced element, so after one comment
           there was nowhere to write the next without reloading. #}
        <div id="comments" class="ds-selectable">
          {% if comments %}
            {{ comments_macro.comments(comments, current_user, supporters) }}
          {% else %}
            <p class="profile-empty">
              {{ ftl_get_message("post-no-comments") }}
              {% if not current_user %}{{ ftl_get_message("post-no-comments-signin") }}{% endif %}
            </p>
          {% endif %}
        </div>
        {% if current_user %}
          <form id="comment-form" class="post-comment-form" hx-post="/comments" hx-target="#comments" hx-swap="innerHTML" data-haptic-done="success"
                hx-disable="find button">
            <input type="hidden" name="post_id" value="{{ post_id }}">
            <input type="hidden" id="parent_comment_id" name="parent_comment_id" value="">
            <div id="reply-info" class="post-comment-replying" style="display: none;">
              <span id="reply-to-text"></span>
              <button type="button" class="ds-button ds-button-quiet ds-button-small"
                      hx-on:click="document.getElementById('parent_comment_id').value = ''; document.getElementById('reply-info').style.display = 'none';">{{ ftl_get_message("cancel") }}</button>
            </div>
            <textarea id="comment-content" class="ds-textarea" name="content" rows="3" required
                      aria-label="{{ ftl_get_message('post-comment') }}"></textarea>
            <div class="post-comment-actions">
              <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("post-comment") }}</button>
            </div>
          </form>
        {% endif %}
      </section>
    </div>
  </div>

  {% if current_user %}
    {# Reply with a drawing: the painter's choices, asked for when they are
       needed, as on a community's page. #}
    <div id="post-draw-modal" class="ds-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="post-draw-title">
      <div class="ds-modal-panel">
        <h2 id="post-draw-title">{{ ftl_get_message("post-reply-with-drawing") }}</h2>
        {% if two_tone %}
          <form action="/draw" method="post" onsubmit="setOrientationDimensions(this)">
            <input type="hidden" name="tool" value="neo" />
            <input type="hidden" name="community_id" value="{{ post.community_id }}" />
            <input type="hidden" name="parent_post_id" value="{{ post_id }}" />
            <input type="hidden" name="width" value="640" />
            <input type="hidden" name="height" value="480" />
            <div class="form-field">
              <span class="ds-label">{{ ftl_get_message('community-drawing-orientation') }}</span>
              <label class="community-draw-choice">
                <input type="radio" name="orientation" value="landscape" checked />
                {{ ftl_get_message('community-drawing-landscape') }} <span class="ds-help">640 × 480</span>
              </label>
              <label class="community-draw-choice">
                <input type="radio" name="orientation" value="portrait" />
                {{ ftl_get_message('community-drawing-portrait') }} <span class="ds-help">480 × 640</span>
              </label>
            </div>
            <div class="form-actions community-draw-actions">
              <button type="button" class="ds-button" onclick="hidePostDrawModal()">{{ ftl_get_message("cancel") }}</button>
              <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("post-reply-with-drawing") }}</button>
            </div>
          </form>
        {% else %}
          <form action="/draw" method="post">
            <input type="hidden" name="tool" value="neo" />
            <input type="hidden" name="parent_post_id" value="{{ post_id }}" />
            {% if post.community_id %}
              <input type="hidden" name="community_id" value="{{ post.community_id }}" />
            {% endif %}
            <div class="form-field community-draw-size">
              <label>
                <span class="ds-label">{{ ftl_get_message('community-drawing-width') }}</span>
                <select name="width" class="ds-select">
                  {% for w in reply_widths %}
                    <option value="{{ w }}" {% if w == 300 %}selected{% endif %}>{{ w }}</option>
                  {% endfor %}
                </select>
              </label>
              <span class="community-draw-times" aria-hidden="true">×</span>
              <label>
                <span class="ds-label">{{ ftl_get_message('community-drawing-height') }}</span>
                <select name="height" class="ds-select">
                  {% for h in reply_heights %}
                    <option value="{{ h }}" {% if h == 300 %}selected{% endif %}>{{ h }}</option>
                  {% endfor %}
                </select>
              </label>
            </div>
            <div class="form-actions community-draw-actions">
              <button type="button" class="ds-button" onclick="hidePostDrawModal()">{{ ftl_get_message("cancel") }}</button>
              <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("post-reply-with-drawing") }}</button>
            </div>
          </form>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if current_user and current_user.id != post.author_id %}
    <div id="report-modal" class="ds-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="report-title">
      <div class="ds-modal-panel">
        <h2 id="report-title">{{ ftl_get_message("post-report-title") }}</h2>
        {# `required` on the textarea is the empty-description check: htmx runs
           HTML5 validation before it will issue a request for a form. #}
        <form id="report-form" data-haptic-done="success"
              hx-post="/posts/{{ post_id }}/report"
              hx-target="this"
              hx-swap="outerHTML"
              hx-disable="find button">
          <label class="ds-label" for="report-description">{{ ftl_get_message("post-report-description-label") }}</label>
          <textarea id="report-description"
                    class="ds-textarea"
                    name="description"
                    required
                    rows="5"
                    style="width: 100%"
                    placeholder="{{ ftl_get_message('post-report-description-placeholder') }}"></textarea>
          <div class="form-actions community-draw-actions">
            <button type="button" class="ds-button" onclick="hideReportModal()">{{ ftl_get_message("cancel") }}</button>
            <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("post-report-submit") }}</button>
          </div>
        </form>
      </div>
    </div>
  {% endif %}

  <script>
    (function () {
      // Whole steps up to what fits, as the painter zooms; smaller than
      // one step, the browser scales it down to fit (max-width). The size
      // is a custom property on the stage, so the image, the replay's poster
      // and its canvas all take it.
      var stageBox = document.querySelector("[data-post-stage]");
      function fitStage() {
        if (!stageBox) return;
        var width = parseInt(stageBox.getAttribute("data-width"), 10);
        var height = parseInt(stageBox.getAttribute("data-height"), 10);
        var room = stageBox.parentNode.parentNode.clientWidth;
        // The stage's height is the window's, less the toolbar, on a wide
        // screen; a phone scrolls, so only the width counts there.
        var tall = window.innerWidth > 600 ? Math.max(window.innerHeight - 190, height) : Infinity;
        var zoom = Math.max(1, Math.min(Math.floor(room / width), Math.floor(tall / height), 4));
        if (width * zoom > room) zoom = 1;
        // Always a length, never auto: an auto-sized replay box takes the
        // width of its controls, which stretched a 300px drawing to ~400
        // and resized it again whenever Play became Pause.
        stageBox.style.setProperty("--post-stage-shown", (width * zoom) + "px");
        stageBox.classList.toggle("is-zoomed", zoom > 1);
      }
      fitStage();
      window.addEventListener("resize", fitStage);

      var box = document.getElementById("post-stage-replay");
      if (!box) return;
      var script = document.createElement("script");
      script.src = "{{ '/static/viewer/neo-cucumber-replay.js' | cachebuster | safe }}";
      script.onload = function () {
        var viewer = window.NeoCucumberReplay.mount(box, {
          replay: box.getAttribute("data-replay"),
          poster: box.getAttribute("data-poster"),
          width: parseInt(box.getAttribute("data-width"), 10),
          height: parseInt(box.getAttribute("data-height"), 10),
          lang: box.getAttribute("data-lang")
        });
        // The replay routes send NEO replays here, to be played at once.
        if (location.hash === "#replay") viewer.play();
      };
      document.head.appendChild(script);
    })();

    function modalToggle(id, open) {
      var modal = document.getElementById(id);
      if (!modal) return;
      modal.style.display = open ? "flex" : "none";
      if (open) {
        var first = modal.querySelector("textarea, select, input[type=radio]:checked");
        if (first) first.focus();
      }
    }
    function showPostDrawModal() { modalToggle("post-draw-modal", true); }
    function hidePostDrawModal() { modalToggle("post-draw-modal", false); }
    function showReportModal() {
      var text = document.getElementById("report-description");
      if (text) text.value = "";
      modalToggle("report-modal", true);
    }
    function hideReportModal() { modalToggle("report-modal", false); }
    function setOrientationDimensions(form) {
      var portrait = form.querySelector('input[name="orientation"]:checked').value === "portrait";
      form.querySelector('input[name="width"]').value = portrait ? "480" : "640";
      form.querySelector('input[name="height"]').value = portrait ? "640" : "480";
    }
    function sharePost(button) {
      var url = button.getAttribute("data-share-url");
      if (navigator.share) {
        navigator.share({ title: button.getAttribute("data-share-title"), url: url }).catch(function () {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function () {
          dsAlert(button.getAttribute("data-share-copied"));
        });
      }
    }
    (function () {
      var modals = ["post-draw-modal", "report-modal"];
      for (var i = 0; i < modals.length; i++) {
        var modal = document.getElementById(modals[i]);
        if (!modal) continue;
        modal.addEventListener("click", function (e) {
          if (e.target === this) this.style.display = "none";
        });
      }
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        for (var j = 0; j < modals.length; j++) modalToggle(modals[j], false);
      });
      // Once the list has taken the new comment, the form is emptied and
      // no longer replying to anyone.
      function afterSwap(e) {
        if (!e.target || e.target.id !== "comments") return;
        var form = document.getElementById("comment-form");
        if (!form) return;
        form.reset();
        document.getElementById("parent_comment_id").value = "";
        document.getElementById("reply-info").style.display = "none";
      }
      document.addEventListener("htmx:after:swap", afterSwap);
      document.addEventListener("htmx:afterSwap", afterSwap);
    })();
  </script>
{% endblock content %}
