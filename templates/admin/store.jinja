{% extends "admin/base.jinja" %}
{# The Supporter Pack catalogue (models/store_product.rs): what each store
   sells, which year a purchase of it counts for, and whether /supporter
   offers it. A product is never removed, only taken off sale -- whoever
   bought it keeps it, and a refund of it still has to be heard -- and its
   year never changes, since that is what its purchases were credited
   with. So each row has a toggle, and when it is sold: a window the
   toggle narrows rather than replaces, in Seoul time, either end left
   empty for open. #}
{% set admin_section = "store" %}
{% block admin_content %}
  <div class="admin-head">
    <h1 class="admin-title">Store</h1>
    <p class="ds-help">
      The Supporter Packs each store sells. /supporter offers a store's
      products on sale for {{ this_year }} to the app that sells through it.
      Off sale only stops that: a product off sale still counts for everyone
      who bought it, and its refunds are still heard. A sale window narrows
      it further -- a product on sale is offered only between its start and
      its end, in Seoul time, and an empty end is open.
    </p>
  </div>

  {% if error %}
    <p class="admin-alert" role="alert"><strong>Not added.</strong> {{ error }}</p>
  {% endif %}

  {% for group in groups %}
    <section class="admin-section">
      <h2 class="profile-section-label">{{ group.store }}</h2>
      {% if group.store == "microsoft" and not microsoft_configured %}
        <p class="ds-help admin-section-help">
          This server has no <code>[microsoft_store]</code> in its config, so
          nothing bought here can be checked yet.
        </p>
      {% endif %}
      {% if group.products|length == 0 %}
        <p class="ds-card admin-empty">Nothing yet.</p>
      {% else %}
        <div class="admin-table-scroll">
          <table>
            <thead>
              <tr>
                <th>Product</th>
                <th>Year</th>
                <th>Button</th>
                <th>Added</th>
                <th>On sale</th>
                <th></th>
                <th>Sold (Seoul time, end not included)</th>
              </tr>
            </thead>
            <tbody>
              {% for product in group.products %}
                <tr>
                  <td><code>{{ product.product }}</code></td>
                  <td>
                    {% if product.year == this_year %}<strong>{{ product.year }}</strong>{% else %}{{ product.year }}{% endif %}
                  </td>
                  <td>
                    {% if product.label %}{{ product.label }}{% else %}<span class="muted">the usual words</span>{% endif %}
                  </td>
                  <td>{{ product.created_at|dateformat(format="short", tz="Asia/Seoul") }}</td>
                  <td>
                    {% if product.selling_now %}
                      selling now
                    {% elif product.on_sale %}
                      <span class="admin-tag deleted">outside its window</span>
                    {% else %}
                      <span class="admin-tag deleted">off sale</span>
                    {% endif %}
                  </td>
                  <td>
                    <form method="post"
                          action="/admin/store/{{ product.store|urlencode }}/{{ product.product|urlencode }}/on-sale">
                      <input type="hidden"
                             name="on_sale"
                             value="{% if product.on_sale %}false{% else %}true{% endif %}" />
                      <button type="submit" class="ds-button ds-button-small">
                        {% if product.on_sale %}Take off sale{% else %}Put on sale{% endif %}
                      </button>
                    </form>
                  </td>
                  <td>
                    <form class="admin-sale-window"
                          method="post"
                          action="/admin/store/{{ product.store|urlencode }}/{{ product.product|urlencode }}/sale-window">
                      <input type="datetime-local"
                             name="sale_starts_at"
                             value="{{ product.sale_starts_local }}"
                             aria-label="Starts (Seoul time)" />
                      –
                      <input type="datetime-local"
                             name="sale_ends_at"
                             value="{{ product.sale_ends_local }}"
                             aria-label="Ends (Seoul time, not included)" />
                      <button type="submit" class="ds-button ds-button-small">Save</button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>
  {% endfor %}

  {# The page's one lime button: the tables' buttons are secondary. #}
  <form method="post" action="/admin/store" class="admin-add-product">
    <fieldset>
      <legend>Add a product</legend>
      <p class="ds-help">
        The store's own id: an App Store product id, a Microsoft Store ID, or a
        Steam DLC's app id. Its year cannot be changed after it is added.
      </p>
      <div class="admin-fields">
        <label>
          <span class="ds-label">Store</span>
          <select name="store" required>
            <option value="">—</option>
            {% for store in stores %}
              <option value="{{ store }}" {% if form.store == store %}selected{% endif %}>{{ store }}</option>
            {% endfor %}
          </select>
        </label>
        <label>
          <span class="ds-label">Product id</span>
          <input type="text" name="product" value="{{ form.product }}" required />
        </label>
        <label>
          <span class="ds-label">Year</span>
          <input type="number" name="year" value="{{ form.year or this_year }}" required />
        </label>
        <label>
          <span class="ds-label">Button label <span class="muted">(optional)</span></span>
          <input type="text" name="label" value="{{ form.label }}" maxlength="100" />
        </label>
        <label>
          <span class="ds-label">Sold from <span class="muted">(optional, Seoul time)</span></span>
          <input type="datetime-local" name="sale_starts_at" value="{{ form.sale_starts_at }}" />
        </label>
        <label>
          <span class="ds-label">Sold until <span class="muted">(optional, Seoul time, not included)</span></span>
          <input type="datetime-local" name="sale_ends_at" value="{{ form.sale_ends_at }}" />
        </label>
        </div>
        <div class="ds-actions">
          <button type="submit">Add</button>
        </div>
      </fieldset>
    </form>
  {% endblock admin_content %}
