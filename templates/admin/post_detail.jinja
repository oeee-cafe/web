{% from "post_url_macro.jinja" import post_url %}
{% from "storage_macro.jinja" import stored_url %}
{% extends "admin/base.jinja" %}
{% set admin_section = "posts" %}
{% block admin_content %}
  <div class="admin-head">
    <h1 class="admin-title">{{ post.title or "(untitled)" }}</h1>
    <p class="admin-tags">
      {% if not post.published_at %}<span class="admin-tag draft">draft</span>{% endif %}
      {% if post.deleted_at %}
        <span class="admin-tag deleted">deleted{% if post.deletion_reason %}: {{ post.deletion_reason }}{% endif %}</span>
      {% endif %}
      {% if post.is_sensitive_by_author %}<span class="admin-tag sensitive">sensitive</span>{% endif %}
      {% if post.is_explicit %}<span class="admin-tag deleted">explicit</span>{% endif %}
      {% if post.community_visibility and post.community_visibility != "public" %}
        <span class="admin-tag {{ post.community_visibility }}">{{ post.community_visibility }}</span>
      {% endif %}
    </p>
  </div>

  {# The drawing at its own size, framed as the painter frames its canvas,
     and beside it (below, on a phone) what staff act on and look up.

     A NEO replay plays here, whatever the author allowed and whether or not
     the post is still up: the viewer the post page uses mounts over the
     drawing, keeps it as its poster and fetches the recording only when a
     control is pressed. #}
  {% set inline_replay = post.replay_filename and post.replay_filename[-4:] == ".pch" %}
  <div class="admin-post">
    {% if inline_replay %}
      <div class="admin-post-drawing neo-cucumber-replay" id="admin-post-replay"
           data-replay="{{ stored_url("replay", post.replay_filename) }}"
           data-width="{{ post.image_width }}"
           data-height="{{ post.image_height }}"
           data-lang="{{ ftl_lang }}">
        <img class="admin-drawing neo-cucumber-replay-poster"
             width="{{ post.image_width }}"
             height="{{ post.image_height }}"
             alt="{{ post.title or 'Untitled' }}"
             src="{{ stored_url("image", post.image_filename) }}" />
        {% include "replay_controls.jinja" %}
      </div>
    {% else %}
      <img class="admin-drawing admin-post-drawing"
           width="{{ post.image_width }}"
           height="{{ post.image_height }}"
           alt="{{ post.title or 'Untitled' }}"
           src="{{ stored_url("image", post.image_filename) }}" />
    {% endif %}

    <div class="admin-post-side ds-stack">
      {% include "admin/post_flag_panel.jinja" %}

      <table>
        <tr>
          <th scope="row">Post ID</th>
          <td><code>{{ post.id }}</code></td>
        </tr>
        <tr>
          <th scope="row">Author</th>
          <td>
            <a href="/admin/users/{{ post.author_login_name }}/posts">@{{ post.author_login_name }}</a>
            ({{ post.author_display_name }})
          </td>
        </tr>
        <tr>
          <th scope="row">Community</th>
          <td>
            {% if post.community_slug %}
              <a href="/admin/communities/{{ post.community_slug }}/posts">{{ post.community_name }}</a>
              — {{ post.community_visibility }}
            {% else %}
              <span class="muted">none</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th scope="row">Created</th>
          <td>{{ post.created_at|datetimeformat(format="short", tz="Asia/Seoul") }}</td>
        </tr>
        <tr>
          <th scope="row">Published</th>
          <td>
            {% if post.published_at %}
              {{ post.published_at|datetimeformat(format="short", tz="Asia/Seoul") }}
            {% else %}
              <span class="muted">never (draft)</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th scope="row">Deleted</th>
          <td>
            {% if post.deleted_at %}
              {{ post.deleted_at|datetimeformat(format="short", tz="Asia/Seoul") }}
              ({{ post.deletion_reason or "no reason recorded" }})
            {% else %}
              <span class="muted">no</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th scope="row">Views</th>
          <td>{{ post.viewer_count }}</td>
        </tr>
        <tr>
          <th scope="row">Replay</th>
          <td>
            {% if post.replay_filename %}
              <a href="{{ stored_url("replay", post.replay_filename) }}"><code>{{ post.replay_filename }}</code></a>
              {% if not inline_replay and post.published_at and not post.deleted_at %}
                — <a href="{{ post_url(post) }}/replay">watch</a>
              {% endif %}
            {% else %}
              <span class="muted">none</span>
            {% endif %}
          </td>
        </tr>
      </table>

      {% if post.published_at and not post.deleted_at %}
        <div>
          <a class="ds-button" href="{{ post_url(post) }}">View on site →</a>
        </div>
      {% endif %}
    </div>
  </div>
  {% if inline_replay %}
    <script>
      (function () {
        var box = document.getElementById("admin-post-replay");
        var script = document.createElement("script");
        script.src = "{{ '/static/viewer/neo-cucumber-replay.js' | cachebuster | safe }}";
        script.onload = function () {
          window.NeoCucumberReplay.mount(box, {
            replay: box.getAttribute("data-replay"),
            poster: box.querySelector("img").getAttribute("src"),
            width: parseInt(box.getAttribute("data-width"), 10),
            height: parseInt(box.getAttribute("data-height"), 10),
            lang: box.getAttribute("data-lang")
          });
        };
        document.head.appendChild(script);
      })();
    </script>
  {% endif %}
{% endblock admin_content %}
