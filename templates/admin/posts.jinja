{% extends "admin/base.jinja" %}
{% from "per_row_macro.jinja" import per_row %}
{% set admin_section = "posts" %}
{% block admin_content %}
  {# Applied before first paint so the grid does not flash at the default width. #}
  <script>
    (function () {
      var saved = localStorage.getItem("adminPostCols");
      if (saved) document.documentElement.style.setProperty("--admin-cols", saved);
    })();
  </script>

  <div class="admin-density">
    {{ per_row(id="admin-cols", var="--admin-cols", key="adminPostCols", default=6) }}
  </div>

  <div class="admin-head">
    <h1 class="admin-title">
      All posts
      {%- if filter_author %} by @{{ filter_author }}{% endif -%}
      {%- if filter_community %} in @{{ filter_community }}{% endif %}
    </h1>
    <p class="ds-help">{{ total }} post(s) across every user and community.</p>
  </div>

  <form class="ds-card admin-filters" method="get" action="/admin/posts">
    <label>
      <span class="ds-label">Author</span>
      <input type="text"
             name="author"
             placeholder="login name"
             autocapitalize="none"
             spellcheck="false"
             value="{{ filter_author or '' }}" />
    </label>
    <label>
      <span class="ds-label">Community</span>
      <select name="community">
        <option value="">All communities</option>
        {% for community in communities %}
          <option value="{{ community.slug }}"
                  {% if community.slug == filter_community %}selected{% endif %}>
            {{ community.name }} ({{ community.visibility }})
          </option>
        {% endfor %}
      </select>
    </label>
    <label class="admin-check">
      <input type="checkbox"
             name="drafts"
             {% if include_drafts %}checked{% endif %} />
      Include drafts
    </label>
    <label class="admin-check">
      <input type="checkbox"
             name="deleted"
             {% if include_deleted %}checked{% endif %} />
      Include deleted
    </label>
    <input type="submit" value="Filter" />
  </form>

  {% if posts %}
    {# The grid is the htmx swap target: the sentinel replaces itself with the
       next batch, which ends with a fresh sentinel. #}
    <div class="posts-grid admin-grid adjustable">
      {% include "admin/posts_fragment.jinja" %}
    </div>
  {% else %}
    <p class="ds-card admin-empty">No posts match this filter.</p>
  {% endif %}

{% endblock admin_content %}
