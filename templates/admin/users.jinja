{% extends "admin/base.jinja" %}
{% from "person_macro.jinja" import handle %}
{% set admin_section = "users" %}
{% macro sort_link(key, label) %}
  <a href="?sort={{ key }}{{ filter_query }}" {% if sort == key %}class="admin-sort-active"{% endif %}>
    {{ label }}{% if sort == key %} ▾{% endif %}
  </a>
{% endmacro %}
{% block admin_content %}
  <div class="admin-head">
    <h1 class="admin-title">Users</h1>
    <p class="ds-help">
      "Last active" is the most recent post, comment or guestbook entry the
      account produced. Passive browsing is not tracked.
    </p>
  </div>
  {% if filter %}
    {# Opened from a figure on the overview. #}
    <div class="ds-card admin-filters admin-user-filter">
      <p>
        <strong>{{ filter.description }}{% if filter.range %}, {{ filter.range }}{% endif %}</strong>
        <span class="muted">· {{ filter.matching }} account{% if filter.matching != 1 %}s{% endif %}</span>
      </p>
      <a class="ds-button ds-button-small" href="/admin/users?sort={{ sort }}">Show every account</a>
    </div>
  {% endif %}
  <div class="admin-table-scroll">
    <table>
      <thead>
        <tr>
          <th>{{ sort_link("name", "Login name") }}</th>
          <th>{{ sort_link("display", "Display name") }}</th>
          <th>Sign-in</th>
          <th>{{ sort_link("role", "Role") }}</th>
          <th>{{ sort_link("posts", "Posts") }}</th>
          <th>{{ sort_link("active", "Last active") }}</th>
          <th>{{ sort_link("created", "Joined") }}</th>
          <th>{{ sort_link("status", "Status") }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
          <tr>
            {# The handle as the site draws it, supporter's mark and all,
               leading to the account's staff page. #}
            <td>{{ handle(user.login_name, "/admin/users/" ~ user.login_name) }}</td>
            <td>{{ user.display_name }}</td>
            {# The sign-ins linked to it, by name; a password is on its
               own page, since it is not a provider. #}
            <td><span class="admin-tags">
              {%- for provider in user.providers %}<span class="admin-tag admin-provider-{{ provider }}">{{ {"steam": "Steam", "apple": "Apple", "google": "Google", "discord": "Discord"}[provider] or provider }}</span>{% endfor -%}
            </span></td>
            <td>
              {% if user.role != "user" %}<strong>{{ user.role }}</strong>{% else %}{{ user.role }}{% endif %}
            </td>
            <td>{{ user.post_count }}</td>
            <td>
              {% if user.last_active_at %}
                {{ user.last_active_at|datetimeformat(format="short", tz="Asia/Seoul") }}
              {% else %}
                <span class="muted">never</span>
              {% endif %}
            </td>
            <td>{{ user.created_at|dateformat(format="short", tz="Asia/Seoul") }}</td>
            <td>
              {% if user.deleted_at %}
                <span class="admin-tag deleted">deleted</span>
              {% else %}
                active
              {% endif %}
            </td>
            <td>
              <a href="/admin/users/{{ user.login_name }}/posts">posts →</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="admin-pager">
    {% if page > 1 %}<a class="ds-button ds-button-small" href="?sort={{ sort }}{{ filter_query }}&page={{ page - 1 }}">← Previous</a>{% endif %}
    <span class="muted">Page {{ page }}</span>
    {% if has_next %}<a class="ds-button ds-button-small" href="?sort={{ sort }}{{ filter_query }}&page={{ page + 1 }}">Next →</a>{% endif %}
  </div>
{% endblock admin_content %}
