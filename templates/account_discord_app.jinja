{% from "sign_in_providers_macro.jinja" import provider_mark %}
{# The reader's Discord account in the Windows app (discord.rs in
   oeee-cafe-desktop): connected to the app, to invite friends from a room,
   or not. It is the app's, kept on that computer, and not one of the
   accounts above, which sign into this site from anywhere -- so it has a
   heading of its own, and shows only where the app has said where it
   stands (app_bridge.jinja's discord.state): never in a browser or another
   app. The script is frontend/site/pages/discordAccount.ts. #}
<section class="settings-group" id="account-discord-app" hidden>
  <div class="profile-section-label">{{ ftl_get_message("account-in-this-app") }}</div>
  <div class="ds-card settings-card">
    <div class="settings-row">
      <span class="settings-row-text" data-discord-status></span>
      <button type="button" class="ds-button" data-discord-disconnect hidden>{{ ftl_get_message("account-discord-disconnect") }}</button>
      <button type="button" class="ds-button auth-discord" data-discord-connect hidden>{{ provider_mark("discord") }}{{ ftl_get_message("account-discord-connect") }}</button>
    </div>
    <p class="ds-help">{{ ftl_get_message("account-discord-help") }}</p>
  </div>
</section>
<script>
  if (window.oeeeChrome) window.oeeeChrome.discordAccount({
    off: {{ ftl_get_message("account-discord-not-connected")|tojson }},
    connecting: {{ ftl_get_message("account-discord-connecting")|tojson }},
    connected: {{ ftl_format_pattern("account-discord-connected", {"name": "{name}"})|tojson }}
  });
</script>
