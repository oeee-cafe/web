{% macro follow_button() %}
  {% if current_user.id != user.id %}
    <form hx-post="/@{{ user.login_name }}/follow" hx-swap="outerHTML"
          hx-disable="find button">
      <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("follow") }}</button>
    </form>
  {% endif %}
{% endmacro %}
{% macro unfollow_button() %}
  {% if current_user.id != user.id %}
    <form hx-post="/@{{ user.login_name }}/unfollow" hx-swap="outerHTML"
          hx-disable="find button">
      <button type="submit" class="ds-button">{{ ftl_get_message("unfollow") }}</button>
    </form>
  {% endif %}
{% endmacro %}
