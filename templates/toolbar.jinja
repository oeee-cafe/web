  {# Drawings kept in this browser (frontend/shared/localDrafts.ts), added
     to what the server counted: the account's own and every guest's, since
     those are what the drafts page offers to post. The database is opened
     without being made -- a first visit aborts the upgrade that would create
     it, so the painter still gets to create it with its store. #}
  <script>
    (function () {
      var link = document.querySelector(".nav-bar .toolbar-menu-drafts, .nav-bar .toolbar-drafts");
      if (!link || !window.indexedDB) return;
      var nav = link.closest ? link.closest(".nav-bar") : null;
      var userId = (nav && nav.getAttribute("data-user-id")) || "";
      var opening;
      try { opening = indexedDB.open("oeee-local-drafts", 1); } catch (e) { return; }
      opening.onupgradeneeded = function () { opening.transaction.abort(); };
      opening.onerror = function (event) { if (event.preventDefault) event.preventDefault(); };
      opening.onsuccess = function () {
        var db = opening.result;
        var index;
        try { index = db.transaction("drafts", "readonly").objectStore("drafts").index("owner"); }
        catch (e) { db.close(); return; }
        var owners = userId ? ["", userId] : [""];
        var local = 0, pending = owners.length;
        owners.forEach(function (owner) {
          var counting = index.count(owner);
          counting.onsuccess = function () {
            local += counting.result;
            if (--pending === 0) { db.close(); show(local); }
          };
        });
      };
      function show(local) {
        if (!local) return;
        var total = (parseInt(link.getAttribute("data-server-count"), 10) || 0) + local;
        if (/(^| )toolbar-drafts( |$)/.test(link.className)) {
          // The guest's square: lit, and counted in its words.
          var label = link.getAttribute("aria-label") + " (" + total + ")";
          link.setAttribute("aria-label", label);
          link.setAttribute("title", label);
          link.className += " toolbar-drafts-some";
          return;
        }
        var badge = link.querySelector(".toolbar-badge");
        if (!badge) {
          badge = document.createElement("span");
          badge.className = "toolbar-badge";
          link.appendChild(document.createTextNode(" "));
          link.appendChild(badge);
        }
        badge.textContent = String(total);
        var summary = link.closest ? link.closest(".toolbar-menu") : null;
        summary = summary && summary.querySelector("summary");
        var avatar = summary && summary.querySelector(".toolbar-avatar");
        if (avatar) avatar.className += " toolbar-avatar-pulse";
      }
    })();
  </script>
