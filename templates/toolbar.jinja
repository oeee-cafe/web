{# The toolbar: the window's title bar, on every page that has one.

   Included by base.jinja and by the painter pages, which do not extend base
   because the painter owns the rest of their document. Everything it needs
   is in ds.css, which each of them loads; it reads current_user,
   draft_post_count, unread_notification_count and ftl_lang, and nothing
   else, so a page can show it by passing those four. #}
{# Light, dark or the system's: the same switch as the painter's Dark button,
   stored under the same name, so the two never disagree. Chosen here, it
   applies at once and to every page after (theme_head.jinja). #}
{% macro theme_choices() %}
  <div class="toolbar-theme">
    <span class="toolbar-theme-label">{{ ftl_get_message("theme") }}</span>
    <div class="ds-segmented" role="group" aria-label="{{ ftl_get_message("theme") }}">
      <button type="button" data-theme-choice="light" aria-pressed="false">{{ ftl_get_message("theme-light") }}</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">{{ ftl_get_message("theme-dark") }}</button>
      <button type="button" data-theme-choice="system" aria-pressed="false">{{ ftl_get_message("theme-system") }}</button>
    </div>
  </div>
{% endmacro %}
{# Boost scoped to the nav, not the body.
   A boosted response has its whole <head> discarded except the title,
   and htmx re-runs swapped scripts by cloning the tag — which does not
   re-evaluate a <script type="module"> the browser has already loaded,
   because the module map is keyed on the URL and `cachebuster` holds it
   fixed for a deploy. Body-wide boost therefore leaves the painter
   unmounted the *second* time someone opens a drawing page in a session.
   Measured, not inferred.

   Scoping it here keeps every link that reaches a module bundle out of
   it: they all live in page bodies, outside this nav. The one exception
   is the draw form below, which says so itself. #}
{# The window's title bar: the sections as its tabs, Draw and the
   account at its end. The desktop app draws its window controls over
   this bar rather than above it, so the site and the window read as one
   surface; in a browser it is simply the top of the page. There is no
   separate "app mode" -- what would look out of place in the app is
   changed for everybody.

   Written for Firefox 56 like the rest of static/style.css, which no
   build step touches: flex without `gap`, and the account menu is a
   <details>, so it opens with no script at all. #}
<nav class="nav-bar" hx-boost:inherited="true">
  <div id="menubar">
    {# The site's name, in type rather than the logo: beside a window's own
       controls the wordmark's four round letters read as a second, crooked
       row of them. #}
    <a class="toolbar-name" href="/">{{ ftl_get_message("brand") }}</a>
    {# The sections, as a window's title bar holds its tabs. On a phone
       they take a second row of the bar, sharing its width. #}
    <div class="toolbar-links">
      <a href="/">{{ ftl_get_message("nav-recent") }}</a>
      {% if current_user %}
        <a href="/home">{{ ftl_get_message("timeline") }}</a>
      {% endif %}
      <a href="/communities">{{ ftl_get_message("community") }}</a>
      {# Shown signed out too: the lobby is a public gallery of finished
         collaborative drawings, and only creating a session needs an
         account. #}
      <a href="/collaborate">{{ ftl_get_message("collaborate") }}</a>
      <a href="/hashtags">{{ ftl_get_message("hashtag-discovery") }}</a>
    </div>
    <div class="toolbar-end">
      {% if current_user %}
        {% include "nav_notifications.jinja" %}
        {# The one control in this nav that loads a module bundle.
           Boosting it would mount the painter once per session and never
           again. #}
        <form action="/draw" method="post" hx-boost="false">
          <input type="hidden" name="tool" value="neo" />
          <input type="hidden" name="width" value="300" />
          <input type="hidden" name="height" value="300" />
          <button type="submit" id="nav-draw-button" class="toolbar-draw">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.4 2.6a2 2 0 0 1 2.9 2.9L11 15.8l-3.6.8.8-3.6Z"/><path d="M7 17c-2 0-3 1.2-3 3 0 .6-.4 1-1 1 1.5 1 3 1 4.5 1 1.9 0 3.5-1.6 3.5-3.5"/></svg><span>{{ ftl_get_message('draw') }}</span>
          </button>
        </form>
        <details class="toolbar-menu">
          <summary aria-label="{{ current_user.display_name or current_user.login_name }}">
            <span class="toolbar-avatar" aria-hidden="true">{{ (current_user.display_name or current_user.login_name or "?")[:1]|upper }}</span>
            {% if not current_user.email_verified_at %}<span class="toolbar-dot" title="{{ ftl_get_message('email-not-verified') }}"></span>{% endif %}
          </summary>
          <div class="toolbar-menu-items">
            <div class="toolbar-menu-who">
              <strong>{{ current_user.display_name }}</strong>
              <span>@{{ current_user.login_name }}</span>
            </div>
            <a href="/@{{ current_user.login_name }}">{{ ftl_get_message("profile") }}</a>
            {% if draft_post_count > 0 %}
              <a href="/posts/drafts">{{ ftl_get_message("drafts") }} <span class="toolbar-badge">{{ draft_post_count }}</span></a>
            {% endif %}
            <a href="/account">{{ ftl_get_message("account") }}
              {% if not current_user.email_verified_at %}
                <span class="dangerous">({{ ftl_get_message("email-not-verified") }})</span>
              {% endif %}
            </a>
            <a href="/about">{{ ftl_get_message("nav-about") }}</a>
            {{ theme_choices() }}
          </div>
        </details>
      {% else %}
        {# What the site is, for someone who has not joined it yet -- then
           the same places as signed in: where the bell is, signing in;
           where Draw is, the one filled button; where your initial is, the
           menu. #}
        <a class="toolbar-about" href="/about">{{ ftl_get_message("nav-about") }}</a>
        <a class="toolbar-signin" href="/login">{{ ftl_get_message("sign-in") }}</a>
        <a class="toolbar-draw" href="/signup">{{ ftl_get_message("sign-up") }}</a>
        <details class="toolbar-menu">
          <summary aria-label="{{ ftl_get_message("toolbar-menu") }}" title="{{ ftl_get_message("toolbar-menu") }}">
            <span class="toolbar-avatar toolbar-avatar-guest" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c.8-3.7 3.9-6 7.5-6s6.7 2.3 7.5 6"/></svg></span>
          </summary>
          <div class="toolbar-menu-items">
            {{ theme_choices() }}
          </div>
        </details>
      {% endif %}
    </div>
  </div>
  {# The keyboard shortcuts, listed. Hidden until `?` or the desktop app's
     Help menu asks for it; see oeeeCommand below. #}
  <div class="ds-shortcuts" id="ds-shortcuts" hidden>
    <div class="ds-shortcuts-panel" role="dialog" aria-modal="true" aria-labelledby="ds-shortcuts-title">
      <div class="ds-shortcuts-head">
        <h2 id="ds-shortcuts-title">{{ ftl_get_message("keyboard-shortcuts") }}</h2>
        <button type="button" class="ds-button ds-button-quiet ds-button-small" data-shortcuts-close>{{ ftl_get_message("close") }}</button>
      </div>
      <dl>
        {% if current_user %}
          <dt><kbd>N</kbd></dt><dd>{{ ftl_get_message("draw") }}</dd>
        {% endif %}
        <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>R</kbd></dt><dd>{{ ftl_get_message("nav-recent") }}</dd>
        {% if current_user %}
          <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>F</kbd></dt><dd>{{ ftl_get_message("timeline") }}</dd>
        {% endif %}
        <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>C</kbd></dt><dd>{{ ftl_get_message("community") }}</dd>
        <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>T</kbd></dt><dd>{{ ftl_get_message("collaborate") }}</dd>
        <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>H</kbd></dt><dd>{{ ftl_get_message("hashtag-discovery") }}</dd>
        {% if current_user %}
          <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>N</kbd></dt><dd>{{ ftl_get_message("notifications") }}</dd>
          <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>D</kbd></dt><dd>{{ ftl_get_message("drafts") }}</dd>
          <dt><kbd>G</kbd> {{ ftl_get_message("keyboard-shortcuts-then") }} <kbd>P</kbd></dt><dd>{{ ftl_get_message("profile") }}</dd>
        {% endif %}
        <dt><kbd>?</kbd></dt><dd>{{ ftl_get_message("keyboard-shortcuts-show") }}</dd>
      </dl>
    </div>
  </div>
  {# Which item is the page you are on: the server does not pass the
     request path to templates, so this reads it here. The boost swaps
     the whole body, this included, so it runs again on every visit;
     the document listeners, which outlive a swap, are added once.

     And the account menu closes the way a menu does, on a click
     anywhere else and on Escape, which <details> alone does not. #}
  <script>
    (function () {
      // Also called with the path being gone to, the moment it is asked for,
      // so the tab moves on the click rather than when the page arrives --
      // and with the page's own path again if it never does.
      window.oeeeMarkCurrent = function (here) {
        var links = document.querySelectorAll("#menubar a[href]");
        for (var i = 0; i < links.length; i++) {
          var path = links[i].getAttribute("href");
          if (path === "/" ? here === "/" : here === path || here.indexOf(path + "/") === 0) {
            links[i].setAttribute("aria-current", "page");
          } else {
            links[i].removeAttribute("aria-current");
          }
        }
      };
      window.oeeeMarkCurrent(location.pathname);
      // The content area scrolls, not the window, and browsers only restore
      // the window's own scroll when you go back -- so where you were is
      // kept here, per page, and put back on a return to it: a full load
      // that came from the history, or htmx restoring a boosted page after
      // a popstate. And the content area takes the keyboard's focus when
      // nothing else has it, so Page Down scrolls it without a click first.
      // The toolbar comes before <main> in the page, so on a full load this
      // waits for it; after a boosted swap it is already there.
      function settleContent() {
        var content = document.querySelector("main.ds-content");
        if (!content) return;
        var key = "oeee-scroll:" + location.pathname + location.search;
        var entry = window.performance && performance.getEntriesByType
          ? performance.getEntriesByType("navigation")[0] : null;
        var returning = window.oeeeHistoryStep ||
          (!window.oeeeSettledOnce && entry && entry.type === "back_forward");
        window.oeeeHistoryStep = false;
        window.oeeeSettledOnce = true;
        if (returning) {
          try {
            var top = parseInt(sessionStorage.getItem(key), 10);
            if (top > 0) content.scrollTop = top;
          } catch (error) {}
        }
        var pending;
        content.addEventListener("scroll", function () {
          clearTimeout(pending);
          pending = setTimeout(function () {
            try {
              sessionStorage.setItem(key, String(content.scrollTop));
            } catch (error) {}
          }, 100);
        });
        if (!document.activeElement || document.activeElement === document.body) {
          try {
            content.focus({ preventScroll: true });
          } catch (error) {
            content.focus();
          }
        }
      }
      function showThemeChoice() {
        var chosen = "system";
        try {
          var stored = localStorage.getItem("neo-cucumber-theme");
          if (stored === "light" || stored === "dark") chosen = stored;
        } catch (error) {}
        var buttons = document.querySelectorAll("[data-theme-choice]");
        for (var k = 0; k < buttons.length; k++) {
          buttons[k].setAttribute("aria-pressed", String(buttons[k].getAttribute("data-theme-choice") === chosen));
        }
      }
      showThemeChoice();

      if (document.querySelector("main.ds-content")) settleContent();
      else document.addEventListener("DOMContentLoaded", settleContent);

      if (window.oeeeToolbarMenu) return;
      window.oeeeToolbarMenu = true;

      // Commands, by name: what the keyboard shortcuts below do, and what the
      // desktop app's menu bar asks for (it calls window.oeeeCommand). Going
      // somewhere is a plain page load, so a page that holds a drawing still
      // asks before it is left.
      function setTheme(choice) {
        try {
          if (choice === "system") localStorage.removeItem("neo-cucumber-theme");
          else localStorage.setItem("neo-cucumber-theme", choice);
        } catch (error) {}
        if (choice === "system") document.documentElement.removeAttribute("data-theme");
        else document.documentElement.setAttribute("data-theme", choice);
        showThemeChoice();
      }
      function go(path) {
        loading(path);
        location.href = path;
      }
      function profilePath() {
        var link = document.querySelector('.toolbar-menu-items a[href^="/@"]');
        return link ? link.getAttribute("href") : "/login";
      }
      function toggleShortcuts(open) {
        var panel = document.getElementById("ds-shortcuts");
        if (!panel) return;
        panel.hidden = open === undefined ? !panel.hidden : !open;
        if (!panel.hidden) {
          var close = panel.querySelector("[data-shortcuts-close]");
          if (close) close.focus();
        }
      }
      var commands = {
        "recent": function () { go("/"); },
        "following": function () { go("/home"); },
        "communities": function () { go("/communities"); },
        "together": function () { go("/collaborate"); },
        "hashtags": function () { go("/hashtags"); },
        "notifications": function () { go("/notifications"); },
        "drafts": function () { go("/posts/drafts"); },
        "profile": function () { go(profilePath()); },
        "account": function () { go("/account"); },
        "about": function () { go("/about"); },
        "new-drawing": function () {
          var draw = document.getElementById("nav-draw-button");
          if (draw && draw.form) {
            draw.form.submit();
          } else {
            go("/login");
          }
        },
        "theme-light": function () { setTheme("light"); },
        "theme-dark": function () { setTheme("dark"); },
        "theme-system": function () { setTheme("system"); },
        "shortcuts": function () { toggleShortcuts(); },
      };
      window.oeeeCommand = function (name) {
        var command = commands[name];
        if (command) command();
        return !!command;
      };

      // The keys. Only on the site's own pages -- the painter and the drawing
      // app have keys of their own -- and never while typing, or with a
      // modifier held, which belong to the browser and the system.
      var awaitingGo = false;
      var goTimer;
      var goKeys = { r: "recent", f: "following", c: "communities", t: "together",
                     h: "hashtags", n: "notifications", d: "drafts", p: "profile" };
      document.addEventListener("keydown", function (event) {
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
        if (!document.body || !document.body.classList.contains("ds-page")) return;
        var target = event.target;
        if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
        var key = event.key;
        var panel = document.getElementById("ds-shortcuts");
        if (key === "Escape" && panel && !panel.hidden) {
          toggleShortcuts(false);
          return;
        }
        if (awaitingGo) {
          awaitingGo = false;
          clearTimeout(goTimer);
          var name = goKeys[key.toLowerCase()];
          if (name) {
            event.preventDefault();
            window.oeeeCommand(name);
          }
          return;
        }
        // `?` is shift and `/` on most layouts, and some report it as such.
        if (key === "?" || (key === "/" && event.shiftKey)) {
          event.preventDefault();
          toggleShortcuts();
        } else if (key === "g" || key === "G") {
          awaitingGo = true;
          goTimer = setTimeout(function () { awaitingGo = false; }, 1500);
        } else if (key === "n" || key === "N") {
          if (document.getElementById("nav-draw-button")) {
            event.preventDefault();
            window.oeeeCommand("new-drawing");
          }
        }
      });
      document.addEventListener("click", function (event) {
        var target = event.target;
        if (!target || !target.closest) return;
        if (target.closest("[data-shortcuts-close]") || target.id === "ds-shortcuts") {
          toggleShortcuts(false);
        }
      });
      window.addEventListener("popstate", function () {
        window.oeeeHistoryStep = true;
      });
      document.addEventListener("click", function (event) {
        var button = event.target && event.target.closest ? event.target.closest("[data-theme-choice]") : null;
        if (!button) return;
        setTheme(button.getAttribute("data-theme-choice"));
      });
      function closeMenus(except) {
        var open = document.querySelectorAll(".toolbar-menu[open]");
        for (var j = 0; j < open.length; j++) {
          if (open[j] !== except) open[j].removeAttribute("open");
        }
      }
      document.addEventListener("click", function (event) {
        var target = event.target;
        var menu = target && target.closest ? target.closest(".toolbar-menu") : null;
        closeMenus(menu);
      });
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeMenus(null);
      });

      // The page that was asked for is drawn at once, before it arrives: the
      // content area swaps to a skeleton of it -- a grid of empty squares
      // for the drawing feeds, a title and lines for anything else -- and
      // the next page, or htmx's swap of the body, replaces it. What was
      // there is hidden, not removed: a page that stays after all (the
      // navigation cancelled, a request that failed) gets it back.
      var FEEDS = /^\/(home|collaborate)?$|^\/(communities\/@|hashtags\/)[^/]+$/;
      function skeletonFor(path) {
        var skeleton = document.createElement("div");
        skeleton.className = "ds-skeleton";
        skeleton.setAttribute("aria-busy", "true");
        var heading = document.createElement("div");
        heading.className = "ds-skeleton-bar ds-skeleton-heading";
        skeleton.appendChild(heading);
        if (FEEDS.test(path)) {
          var grid = document.createElement("div");
          grid.className = "posts-grid ds-skeleton-grid";
          for (var i = 0; i < 12; i++) {
            var item = document.createElement("div");
            item.className = "posts-grid-item";
            item.innerHTML = '<div class="ds-skeleton-square"></div>' +
              '<div class="ds-skeleton-bar ds-skeleton-caption"></div>' +
              '<div class="ds-skeleton-bar ds-skeleton-caption short"></div>';
            grid.appendChild(item);
          }
          skeleton.appendChild(grid);
        } else {
          var column = document.createElement("div");
          column.className = "center";
          for (var j = 0; j < 6; j++) {
            var line = document.createElement("div");
            line.className = "ds-skeleton-bar ds-skeleton-line" + (j % 3 === 2 ? " short" : "");
            column.appendChild(line);
          }
          skeleton.appendChild(column);
        }
        return skeleton;
      }
      function loading(path) {
        window.oeeeMarkCurrent(path || location.pathname);
        var content = document.querySelector("main.ds-content");
        if (!content || content.querySelector(".ds-skeleton")) return;
        var kept = [];
        for (var c = 0; c < content.children.length; c++) {
          var child = content.children[c];
          kept.push([child, child.style.display]);
          child.style.display = "none";
        }
        var skeleton = skeletonFor(path || location.pathname);
        content.appendChild(skeleton);
        content.scrollTop = 0;
        function restore() {
          if (!skeleton.parentNode) return;
          skeleton.parentNode.removeChild(skeleton);
          window.oeeeMarkCurrent(location.pathname);
          for (var k = 0; k < kept.length; k++) kept[k][0].style.display = kept[k][1];
        }
        window.oeeeRestoreContent = restore;
        setTimeout(restore, 10000);
      }
      document.addEventListener("click", function (event) {
        if (event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        var link = event.target && event.target.closest ? event.target.closest("a[href]") : null;
        if (!link || link.target || link.hasAttribute("download")) return;
        // htmx takes a boosted link's click for itself, which cancels it; that
        // is still a trip to another page. Any other cancelled click is a
        // script that kept the page where it is.
        var boosted = link.closest('[hx-boost\\:inherited="true"]') && !link.closest('[hx-boost="false"]');
        if (event.defaultPrevented && !boosted) return;
        if (link.origin !== location.origin) return;
        if (link.pathname === location.pathname && link.search === location.search) return;
        loading(link.pathname);
      });
      document.addEventListener("submit", function (event) {
        var form = event.target;
        if (event.defaultPrevented || !form || !form.getAttribute) return;
        if (form.hasAttribute("hx-post") || form.hasAttribute("hx-get") ||
            form.hasAttribute("hx-put") || form.hasAttribute("hx-delete")) return;
        var action = form.getAttribute("action");
        loading(action && action.charAt(0) === "/" ? action.split("?")[0] : location.pathname);
      });
      window.addEventListener("pageshow", function (event) {
        // Back to a page kept in memory: it is shown as it was left.
        if (event.persisted && window.oeeeRestoreContent) window.oeeeRestoreContent();
      });
    })();
  </script>
</nav>
