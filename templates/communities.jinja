{% extends "base.jinja" %}
{% import "community_card_macro.jinja" as card %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("community") }}
{% endblock title %}
{% block content %}
  {# .center-wide, not .center: this is a directory of image-led cards, the same
     kind of content the home grid shows, and the 829px text column fit exactly
     one community per row. Every section below is a grid for the same reason. #}
  <div class="center-wide">
    <h2>{{ ftl_get_message("community") }}</h2>
    {# Yours: owned and joined in one band. They were two stacked sections that
       both matched for any community you own and are a member of, so the same
       card appeared twice before you reached anything new. #}
    {% if current_user %}
      <section class="community-section">
        <div class="community-directory-header">
          <h3>{{ ftl_get_message("my-communities") }}</h3>
          <a href="/communities/new" class="btn">{{ ftl_get_message("create-community") }}</a>
        </div>
        {% if your_communities %}
          <div class="community-grid">
            {% for community in your_communities %}
              {{ card.community_card(community, r2_public_endpoint_url) }}
            {% endfor %}
          </div>
        {% else %}
          <p class="muted">{{ ftl_get_message("my-communities-nil") }}</p>
        {% endif %}
      </section>
    {% endif %}
    {# Official #}
    {% if official_communities %}
      <section class="community-section">
        <h3>{{ ftl_get_message("official-communities") }}</h3>
        <div class="community-grid">
          {% for community in official_communities %}
            {{ card.community_card(community, r2_public_endpoint_url) }}
          {% endfor %}
        </div>
      </section>
    {% else %}
      <p class="muted">{{ ftl_get_message("official-communities-nil") }}</p>
    {% endif %}
    {# Latest active public communities. Cards live in
       community_cards_fragment.jinja so the first batch, search results and
       every scrolled batch share one definition. #}
    <section class="community-section">
      <div class="community-directory-header">
        <h3>{{ ftl_get_message("latest-active-public-community") }}</h3>
        {# Search sits in this header rather than at the top of the page. Its
           hx-target has always been this list alone, so at the top it looked
           like it searched everything and quietly did not. #}
        <div class="community-directory-controls">
          <input type="text"
                 id="community-search"
                 name="q"
                 class="community-move-search community-directory-search"
                 placeholder="{{ ftl_get_message('post-move-search-placeholder') }}"
                 autocomplete="off"
                 hx-get="/api/communities/cards"
                 hx-trigger="input changed delay:300ms, search"
                 hx-target="#public-communities-list"
                 hx-swap="innerHTML"
                 hx-include="[name='sort']"
                 hx-indicator="#community-search-indicator" />
          {# The one control on this page that cannot say it is working by
             disabling itself — doing that mid-keystroke would drop what was
             being typed. htmx puts .htmx-request straight onto the element
             hx-indicator names, and its own stylesheet reveals it. #}
          <span id="community-search-indicator"
                class="htmx-indicator search-indicator"
                role="status">{{ ftl_get_message("searching") }}</span>
          <label class="community-sort">
            {{ ftl_get_message("community-sort") }}
            <select name="sort"
                    hx-get="/api/communities/cards"
                    hx-target="#public-communities-list"
                    hx-swap="innerHTML"
                    hx-include="#community-search">
              <option value="active" {% if sort == "active" %}selected{% endif %}>{{ ftl_get_message("community-sort-active") }}</option>
              <option value="posts" {% if sort == "posts" %}selected{% endif %}>{{ ftl_get_message("community-sort-posts") }}</option>
              <option value="newest" {% if sort == "newest" %}selected{% endif %}>{{ ftl_get_message("community-sort-newest") }}</option>
              <option value="name" {% if sort == "name" %}selected{% endif %}>{{ ftl_get_message("community-sort-name") }}</option>
            </select>
          </label>
        </div>
      </div>
      <div class="community-grid" id="public-communities-list">
        {% include "community_cards_fragment.jinja" %}
      </div>
    </section>
  </div>
{% endblock content %}
