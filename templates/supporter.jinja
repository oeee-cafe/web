{% extends "base.jinja" %}
{% from "supporter_badge_macro.jinja" import supporter_mark, supporter_mark_name %}
{% from "app_stores_macro.jinja" import app_stores %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("supporter-pack") }}
{% endblock title %}
{% block content %}
  {# The Supporter Pack, laid out as /about lays the site out: what it is
     first, then this year's pack and the buttons that buy it, then the
     years already bought.

     Only an app can take the money, and only through the store it was built
     for, so the server draws that store's buttons and no other's
     (handlers/supporter.rs): `store` is what the request's user agent names,
     read the way theme_head.jinja reads it for `data-store`, and `offers`
     are that store's products on sale for this year, from the catalogue
     staff keep at /admin/store -- a button each, in the product's own words
     where it has some. A browser names no store and sees the page with no
     button rather than a button that would do nothing. What it sees
     instead is supporter-pack-elsewhere, which names no store: an Apple app
     that pointed at Steam is the steering App Review reads for, and
     whoever is holding an app knows which one it is. #}
  <div class="profile about-page">
    <section class="profile-card ds-card about-card">
      <div class="profile-identity">
        <h1 class="profile-name">{{ ftl_get_message("supporter-pack") }}</h1>
        <p class="about-lede">{{ ftl_get_message("supporter-pack-lede") }}</p>
      </div>
    </section>

    <section class="profile-section">
      <div class="profile-section-label">{{ ftl_format_pattern("supporter-pack-year", {"year": this_year}) }}</div>
      {# A stack: every line and row below is one gap from the last,
         whichever of them this reader gets. What the pack is reads at the
         page's own size; the notes after it are muted, not smaller. #}
      <div class="ds-card settings-card ds-stack supporter-pack-card">
        {% if supports_this_year %}
          <p class="supporter-thanks ds-marked-block">
            {{ supporter_mark(worn_mark) }}{{ ftl_format_pattern("supporter-pack-have", {"year": this_year}) }}
          </p>
        {% else %}
          <p>{{ ftl_get_message("supporter-pack-what") }}</p>
        {% endif %}

        {% if not current_user %}
          <p class="ds-help">{{ ftl_get_message("supporter-pack-sign-in") }}</p>
          <div class="supporter-actions">
            <a class="ds-button ds-button-primary" href="/login?next=/supporter">{{ ftl_get_message("sign-in") }}</a>
          </div>
        {% else %}
          {# Drawn only when there is a button to put in it: a row with
             nothing in it would still be a gap in the stack. #}
          {% if offers|length > 0 or restorable %}
            <div class="supporter-actions">
              {% for offer in offers %}
                <button type="button"
                        class="ds-button ds-button-primary supporter-buy"
                        data-product="{{ offer.product }}">{{ offer.label or ftl_format_pattern("supporter-pack-buy", {"year": this_year}) }}<span class="supporter-price" data-product="{{ offer.product }}"></span></button>
              {% endfor %}
              {# Restoring is the App Store's word for it: the same purchase
                 handed over again, which gives a pack back to whoever is
                 signed in without ever making a second one. Google Play
                 has the same, from what the device's Google account owns.
                 Steam has no such thing -- it says what an account owns
                 every time it is asked -- and the Microsoft Store build
                 hands its key over again by itself. #}
              {% if restorable %}
                <button type="button" class="ds-button supporter-restore">{{ ftl_get_message("supporter-pack-restore") }}</button>
              {% endif %}
            </div>
          {% endif %}
          {# What became of the last press, once the store or the site has
             answered it (the script below). #}
          <p class="ds-help supporter-status" role="status" aria-live="polite" hidden></p>
          {% if nothing_this_year %}
            <p class="ds-help">{{ ftl_format_pattern("supporter-pack-none", {"year": this_year}) }}</p>
          {% endif %}
        {% endif %}
        {# Where the pack is sold, for a browser: the line, and the apps
           that sell it. An app that sells is marked `data-store` and hides
           the line; any app is marked `data-app` and hides the badges. #}
        <p class="ds-help supporter-elsewhere">{{ ftl_get_message("supporter-pack-elsewhere") }}</p>
        {{ app_stores(ftl_lang) }}
      </div>
    </section>

    {% if supporter_standings|length > 0 %}
      <section class="profile-section">
        <div class="profile-section-label">{{ ftl_get_message("supporter-pack-years") }}</div>
        <div class="profile-chips">
          {% for standing in supporter_standings %}
            <span class="profile-chip supporter-chip ds-marked"
                  title="{{ supporter_mark_name(standing.store) }}">{{ supporter_mark(standing.store) }}{{ standing.year }}</span>
          {% endfor %}
        </div>
        <p class="ds-help">{{ ftl_get_message("supporter-pack-years-help") }}</p>
      </section>
    {% endif %}

    <section class="profile-section">
      <div class="about-buttons">
        <a class="ds-button" href="/about#supporters">{{ ftl_get_message("account-supporter-see-credits") }}</a>
      </div>
    </section>
  </div>

  <script>
    // Buying happens in the app: the page asks, the app sells, and the app
    // hands what the store gave it back to the page, which tells the site
    // (app_store.jinja) and reloads. Nothing here records anything -- a page
    // cannot be trusted about a purchase, and is not; the site asks the
    // store itself.
    //
    // The price is the store's to say, in the reader's own currency and
    // formatted its way, so the button leaves room for it and the app fills
    // it in (app_bridge.jinja). A button with no price is a button whose
    // app has not answered; it still buys the pack, and the sheet the store
    // opens says the price either way.
    (function () {
      function ask(type, data) {
        var app = window.oeeeApp;
        if (!app || !app.post) return false;
        return app.post(type, data, true);
      }

      // Defined before the asking, so an app that answers at once is heard.
      // Called again whenever the app knows better -- a currency that
      // arrived late, a price that changed while the page was open.
      var app = window.oeeeApp;
      if (app) (app.store = app.store || {}).prices = function (prices) {
        if (!prices) return;
        var spans = document.querySelectorAll(".supporter-price");
        for (var i = 0; i < spans.length; i++) {
          var price = prices[spans[i].getAttribute("data-product")];
          spans[i].textContent = price == null ? "" : String(price);
        }
      };

      // Every button here is the store's this build sells through -- the
      // server drew no other -- so nothing the app is asked needs to say
      // which.
      var buttons = document.querySelectorAll(".supporter-buy");
      if (buttons.length) {
        var products = [];
        for (var i = 0; i < buttons.length; i++) products.push(buttons[i].getAttribute("data-product"));
        ask("prices", { products: products });
      }

      // What became of a press, said under the buttons. A pack bought is
      // said by the page the site reloads to, which has it; a Restore
      // might give back nothing that page shows differently, so it leaves
      // a note for the page after it to say.
      var WORDS = {
        checking: {{ ftl_get_message("supporter-pack-checking")|tojson }},
        restored: {{ ftl_get_message("supporter-pack-restored")|tojson }},
        nothing: {{ ftl_get_message("supporter-pack-nothing-to-restore")|tojson }},
        pending: {{ ftl_get_message("supporter-pack-pending")|tojson }},
        failed: {{ ftl_get_message("supporter-pack-failed")|tojson }},
        refused: {{ ftl_get_message("supporter-pack-refused")|tojson }},
        later: {{ ftl_get_message("supporter-pack-later")|tojson }},
        signIn: {{ ftl_get_message("supporter-pack-sign-in")|tojson }}
      };
      var NOTE = "oeee-supporter-note";
      var status = document.querySelector(".supporter-status");
      function say(words, error) {
        if (!status) return;
        status.textContent = words || "";
        status.hidden = !words;
        status.classList.toggle("supporter-status-error", !!error);
      }
      function busy(on) {
        var controls = document.querySelectorAll(".supporter-buy, .supporter-restore");
        for (var i = 0; i < controls.length; i++) controls[i].disabled = on;
      }
      try {
        if (sessionStorage.getItem(NOTE) === "restored") say(WORDS.restored);
        sessionStorage.removeItem(NOTE);
      } catch (error) {
        // Storage refused: the page after a Restore says nothing of it.
      }

      // What was last pressed, while its answer is outstanding. Proof the
      // app hands over unasked -- a purchase it found unfinished as the
      // page opened -- is checked quietly, and is shown by the reload when
      // the site takes it.
      var pressed = null;
      document.addEventListener("oeee:store", function (event) {
        var told = event.detail || {};
        if (!pressed) return;
        if (told.state === "checking") {
          busy(true);
          say(WORDS.checking);
          return;
        }
        var was = pressed;
        pressed = null;
        busy(false);
        if (told.state === "checked") {
          if (told.taken) {
            if (was === "restore") {
              try {
                sessionStorage.setItem(NOTE, "restored");
              } catch (error) {
                // Nothing to leave the note in; the reload says it alone.
              }
            }
            say(WORDS.checking);
            return;
          }
          var refused = told.refused || [];
          if (refused.indexOf(401) !== -1) say(WORDS.signIn, true);
          // Proof the store does not know, or a site not set up to ask it:
          // offering it again would be answered the same way.
          else if (refused.every(function (code) { return code === 400 || code === 404; })) say(WORDS.refused, true);
          else say(WORDS.later, true);
          return;
        }
        if (told.state === "ended") {
          if (told.outcome === "pending") say(WORDS.pending);
          else if (told.outcome === "nothing") say(WORDS.nothing);
          else if (told.outcome === "failed") say(WORDS.failed, true);
          else say("");
        }
      });

      document.addEventListener("click", function (event) {
        var buy = event.target.closest && event.target.closest(".supporter-buy");
        if (buy) {
          if (buy.disabled) return;
          say("");
          if (ask("purchase", { product: buy.getAttribute("data-product") })) pressed = "purchase";
          return;
        }
        var restore = event.target.closest && event.target.closest(".supporter-restore");
        if (restore && !restore.disabled) {
          say("");
          if (ask("restore", {})) pressed = "restore";
        }
      });
    })();
  </script>
{% endblock content %}
