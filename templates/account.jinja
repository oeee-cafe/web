{% extends "base.jinja" %}
{% from "supporter_badge_macro.jinja" import supporter_mark, supporter_mark_name %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("account") }}
{% endblock title %}
{% block content %}
  {# Account settings as a settings pane lays them out: each group a card
     under its own label, its fields the width of the card, and the button
     that saves that group at the card's foot. Every group is still its own
     form posting where it always did. Deleting the account is last and set
     apart. #}
  <div class="settings-page">
    <h1 class="settings-title">{{ ftl_get_message("account") }}</h1>

    <section class="settings-group">
      <div class="profile-section-label">{{ ftl_get_message("account-info") }}</div>
      <form method="post" class="ds-card settings-card">
        <div class="form-field">
          <label class="ds-label" for="login_name">{{ ftl_get_message("login-name") }}</label>
          <input class="ds-input" name="login_name" id="login_name" autocapitalize="none" spellcheck="false"
                 value="{{ current_user.login_name }}" />
        </div>
        <div class="form-field">
          <label class="ds-label" for="display_name">{{ ftl_get_message("display-name") }}</label>
          <input class="ds-input" name="display_name" id="display_name" value="{{ current_user.display_name }}" />
        </div>
        <div class="settings-foot">
          <span class="ds-help">{{ ftl_get_message("account-created-at") }} {{ current_user.created_at|dateformat(format="short", tz="Asia/Seoul") }}</span>
          <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("account-info-edit") }}</button>
        </div>
      </form>
    </section>

    <section class="settings-group">
      {% if has_password %}
      <div class="profile-section-label">{{ ftl_get_message("account-change-password") }}</div>
      <form method="post" action="/account/password" class="ds-card settings-card">
        <div class="form-field">
          <label class="ds-label" for="current_password">{{ ftl_get_message("account-change-password-current") }}</label>
          <input class="ds-input" name="current_password" id="current_password" type="password" autocomplete="current-password" />
        </div>
      {% else %}
      {# An account made by signing in with Steam, say: it has no password
         to give, and setting one lets it sign in on the web and in the
         mobile apps as well. #}
      <div class="profile-section-label">{{ ftl_get_message("account-set-password") }}</div>
      <form method="post" action="/account/password" class="ds-card settings-card">
        <p class="ds-help">{{ ftl_get_message("account-set-password-hint") }}</p>
      {% endif %}
        <div class="form-field">
          <label class="ds-label" for="new_password">{{ ftl_get_message("account-change-password-new") }}</label>
          <input class="ds-input" name="new_password" id="new_password" type="password" autocomplete="new-password" />
        </div>
        <div class="form-field">
          <label class="ds-label" for="new_password_confirm">{{ ftl_get_message("account-change-password-new-repeat") }}</label>
          <input class="ds-input" name="new_password_confirm" id="new_password_confirm" type="password" autocomplete="new-password" />
        </div>
        <div class="settings-foot">
          <span></span>
          <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("account-info-edit") }}</button>
        </div>
      </form>
    </section>

    <section class="settings-group">
      <div class="profile-section-label">{{ ftl_get_message("account-linked-accounts") }}</div>
      <div class="ds-card settings-card">
        {# A Google or Apple account is told apart by its address -- for
           Apple, possibly the relay it was given -- which is what each
           provider's own account screens show; a name is only a fallback.
           Steam has no address. #}
        {% for identity in identities %}
          <form method="post" action="/account/identities/{{ identity.provider }}/unlink" class="settings-row">
            <span class="settings-row-text">{% if identity.provider == "steam" %}Steam{% elif identity.provider == "apple" %}Apple{% elif identity.provider == "google" %}Google{% else %}{{ identity.provider }}{% endif %}{% if identity.provider in ["google", "apple"] and identity.email %}: {{ identity.email }}{% elif identity.display_hint %}: {{ identity.display_hint }}{% elif identity.email %}: {{ identity.email }}{% endif %}</span>
            <button type="submit" class="ds-button" data-haptic="light">{{ ftl_get_message("account-unlink") }}</button>
          </form>
        {% else %}
          <p class="ds-help">{{ ftl_get_message("account-linked-accounts-none") }}</p>
        {% endfor %}
        {% if steam_enabled and not steam_linked %}
          {# Followed only inside the Oeee Cafe app on Steam; see login.jinja. #}
          <a class="ds-button auth-steam" href="/auth/steam/app?next=/account">{{ ftl_get_message("account-link-steam") }}</a>
        {% endif %}
        {% if apple_enabled and not apple_linked %}
          {# Not inside most of the apps; see login.jinja. #}
          <a class="ds-button auth-apple" href="/auth/apple?next=/account">{{ ftl_get_message("account-link-apple") }}</a>
        {% endif %}
        {% if google_enabled and not google_linked %}
          {# Not inside most of the apps; see login.jinja. #}
          <a class="ds-button auth-google" href="/auth/google?next=/account">{{ ftl_get_message("account-link-google") }}</a>
        {% endif %}
      </div>
    </section>

    {% if show_in_credits is defined and show_in_credits is not none %}
      {# Only a supporter has a line in the credits to keep or take away. #}
      <section class="settings-group">
        <div class="profile-section-label">{{ ftl_get_message("account-supporter") }}</div>
        <form action="/account/credits" method="post" class="ds-card settings-card">
          <p class="ds-help">{{ ftl_get_message("account-supporter-thanks") }}</p>
          {% if (supporter_platforms or [])|length > 1 %}
            {# Buying this year's pack on more than one platform is the only
               time there is anything to choose: which one's mark goes beside
               their name. Their profile names every year either way. #}
            <div class="form-field">
              <span class="ds-label">{{ ftl_get_message("account-supporter-mark") }}</span>
              <div class="community-form-choices">
                {% for platform in supporter_platforms %}
                  <label class="community-form-choice">
                    <input type="radio"
                           name="mark"
                           value="{{ platform }}"
                           {% if platform == worn_mark %}checked{% endif %} />
                    <span class="community-form-choice-name">{{ supporter_mark(platform) }}{{ supporter_mark_name(platform) }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          <div class="community-form-choices">
            <label class="community-form-choice">
              <input type="checkbox"
                     name="show_in_credits"
                     id="show_in_credits"
                     value="on"
                     {% if show_in_credits %}checked{% endif %} />
              <span class="community-form-choice-name">{{ ftl_get_message("account-show-in-credits") }}</span>
            </label>
          </div>
          <div class="settings-foot">
            <a href="/about#supporters">{{ ftl_get_message("account-supporter-see-credits") }}</a>
            <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("account-content-settings-save") }}</button>
          </div>
        </form>
      </section>
    {% endif %}

    <section class="settings-group">
      <div class="profile-section-label">{{ ftl_get_message("account-change-email") }}</div>
      {% include "email_edit.jinja" %}
    </section>

    <section class="settings-group">
      <div class="profile-section-label">{{ ftl_get_message("account-language-settings") }}</div>
      <form action="/account/language" method="post" class="ds-card settings-card">
        <div class="form-field">
          <label class="ds-label" for="language">{{ ftl_get_message("account-language-current") }}</label>
          <select class="ds-select" name="language" id="language">
            {% for code, name in languages %}
              <option value="{{ code }}"
                      {% if code == current_user.preferred_language|lower %}selected{% endif %}>{{ name }}</option>
            {% endfor %}
            <option value="auto"
                    {% if not current_user.preferred_language %}selected{% endif %}>
              {{ ftl_get_message("account-language-auto") }}
            </option>
          </select>
        </div>
        <div class="settings-foot">
          <span></span>
          <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("account-language-settings-save") }}</button>
        </div>
      </form>
    </section>

    <section class="settings-group">
      <div class="profile-section-label">{{ ftl_get_message("account-content-settings") }}</div>
      <form action="/account/show-sensitive-content" method="post" class="ds-card settings-card">
        <div class="community-form-choices">
          <label class="community-form-choice">
            <input type="checkbox"
                   name="show_sensitive_content"
                   id="show_sensitive_content"
                   value="on"
                   {% if current_user.show_sensitive_content == true %}checked{% endif %} />
            <span class="community-form-choice-name">{{ ftl_get_message("account-show-sensitive-content") }}</span>
          </label>
        </div>
        <div class="settings-foot">
          <span></span>
          <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("account-content-settings-save") }}</button>
        </div>
      </form>
    </section>

    <section class="settings-group settings-danger">
      <div class="profile-section-label">{{ ftl_get_message("account-delete") }}</div>
      <form id="delete-account-form"
            class="ds-card settings-card"
            hx-delete="/account/delete"
            hx-confirm="{{ ftl_get_message("account-delete-confirm") }}"
            hx-target="#delete-error"
            hx-swap="innerHTML"
            hx-disable="find button">
        <p class="settings-status is-danger">{{ ftl_get_message("account-delete-warning") }}</p>
        <div id="delete-error"></div>
        <div class="form-field">
          {% if has_password %}
          <label class="ds-label" for="delete_password">{{ ftl_get_message("account-change-password-current") }}</label>
          <input class="ds-input" name="password" id="delete_password" type="password" autocomplete="current-password" required />
          {% else %}
          <label class="ds-label" for="delete_login_name">{{ ftl_format_pattern("account-delete-type-login-name", {"loginName": current_user.login_name}) }}</label>
          <input class="ds-input" name="login_name" id="delete_login_name"
                 autocapitalize="none" autocomplete="off" spellcheck="false" required />
          {% endif %}
        </div>
        <div class="settings-foot">
          <span></span>
          <button type="submit" class="ds-button ds-button-danger">{{ ftl_get_message("account-delete-button") }}</button>
        </div>
      </form>
    </section>
  </div>
{% endblock content %}
