{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {% if search_query %}{{ search_query }} - {% endif %}{{ ftl_get_message("search") }}
{% endblock title %}
{% block content %}
  {# The per-row choice applies to the drawings grid below, as on every other
     grid of drawings. #}
  {% include "post_feed_head.jinja" %}
  {# Site search: the form, then the people and the drawings it matched. #}
  <div class="center-wide communities-page search-page">
    <h1 class="collaborate-title">{{ ftl_get_message("search") }}</h1>
    <div class="communities-bar">
      <form method="get" action="/search" class="communities-filters" role="search">
        <input type="search"
               name="q"
               placeholder="{{ ftl_get_message("search-placeholder") }}"
               aria-label="{{ ftl_get_message("search-placeholder") }}"
               value="{% if search_query %}{{ search_query }}{% endif %}"
               class="ds-input communities-search"
               autocomplete="off"
               autocapitalize="none"
               spellcheck="false"
               {% if not search_query %}autofocus{% endif %} />
        <button type="submit" class="ds-button">{{ ftl_get_message("search") }}</button>
      </form>
    </div>

    {% if search_query %}
      <p class="tag-search-info">
        {{ ftl_get_message("search-results-for") }} "<strong>{{ search_query }}</strong>"
      </p>

      {% if people %}
        {% from "person_card_macro.jinja" import person_card %}
        {# Over the drawings: a name is what was more likely meant. #}
        <section class="profile-section" aria-labelledby="search-people-heading">
          <div id="search-people-heading" class="profile-section-label">{{ ftl_get_message("search-people") }}</div>
          <ul class="profile-follows">
            {% for person in people %}
              <li>{{ person_card(person, r2_public_endpoint_url) }}</li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if posts %}
        {% import "post_card.jinja" as card %}
        <section class="profile-section" aria-labelledby="search-posts-heading">
          <div class="grid-header">
            <div id="search-posts-heading" class="profile-section-label">{{ ftl_get_message("search-posts") }}</div>
            {% include "post_feed_controls.jinja" %}
          </div>
          <div class="posts-grid">
            {% for post in posts %}
              {{ card.post_card(post, r2_public_endpoint_url, false) }}
            {% endfor %}
          </div>
        </section>
      {% elif not people %}
        <p class="communities-empty">{{ ftl_get_message("search-no-results") }}</p>
      {% endif %}
    {% endif %}
  </div>
{% endblock content %}
