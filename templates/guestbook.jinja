{% from "guestbook_macro.jinja" import guestbook_entry %}
{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("guestbook") }} | {{ user.display_name }} (@{{ user.login_name }})
{% endblock title %}
{% block content %}
  {# A person's guestbook as a conversation page: back to their profile, a
     field to write in (for anyone but them), and the entries as one list,
     newest first -- a new one lands at its top without leaving the page. #}
  <div class="notifications-page guestbook-page">
    <div class="members-header">
      <div>
        <a class="profile-chip" href="/@{{ user.login_name }}">← {{ user.display_name }}</a>
        <h1 class="settings-title">{{ ftl_get_message("guestbook") }}</h1>
      </div>
    </div>
    {% if current_user and current_user.id != user.id %}
      <form class="ds-card settings-card guestbook-compose"
            id="guestbook-compose" data-haptic-done="success"
            hx-post="/@{{ user.login_name }}/guestbook"
            hx-target="#guestbook-entries"
            hx-swap="afterbegin"
            hx-disable="find button">
        <textarea class="ds-textarea" name="content" rows="3" required
                  aria-label="{{ ftl_get_message("guestbook") }}"></textarea>
        <div class="guestbook-form-actions">
          <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("guestbook-write") }}</button>
        </div>
      </form>
    {% endif %}
    <div class="member-list guestbook-list" id="guestbook-entries"{% if guestbook_entries|length == 0 %} hidden{% endif %}>
      {%- for entry in guestbook_entries %}{{ guestbook_entry(entry) }}{% endfor -%}
    </div>
    {% if guestbook_entries|length == 0 %}
      <div class="ds-card notifications-empty" id="guestbook-empty"><p>{{ ftl_get_message("guestbook-empty") }}</p></div>
    {% endif %}
  </div>
  <script>
    (function () {
      // Once the new entry is in the list: the list shows, the empty note
      // goes, and the field is cleared for the next.
      function afterSwap(e) {
        if (!e.target || e.target.id !== "guestbook-entries") return;
        e.target.hidden = false;
        var empty = document.getElementById("guestbook-empty");
        if (empty) empty.parentNode.removeChild(empty);
        var form = document.getElementById("guestbook-compose");
        if (form) form.reset();
      }
      document.addEventListener("htmx:after:swap", afterSwap);
      document.addEventListener("htmx:afterSwap", afterSwap);
    })();
  </script>
{% endblock content %}
