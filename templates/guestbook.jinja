{% from "guestbook_macro.jinja" import guestbook_entry %}
{% from "follow_macro.jinja" import follow_button, unfollow_button %}
{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ user.display_name }} (@{{ user.login_name }})
{% endblock title %}
{% block content %}
  <div class="center">
    <div class="profile-header">
      <h2>
        {{ user.display_name }}
        <span class="muted">@{{ user.login_name }}</span>
      </h2>
      <div class="banner-controls">
        {% if current_user %}
          {% if is_following %}
            {{ unfollow_button() }} {%
            else %} {{ follow_button() }}
          {% endif %}
        {% endif %}
        {% if banner %}
          {%
          if user.id == current_user.id %}<a href="/banners/draw">
          <img width="{{ banner.width }}"
               height="{{ banner.height }}"
               alt="{{ current_user.display_name }} (@{{ current_user.login_name }}) 동맹 배너"
               class="banner"
               src="{{ r2_public_endpoint_url }}/image/{{ banner.image_filename[:2] }}/{{ banner.image_filename }}" />
        </a>
      {% else %}
        <img width="{{ banner.width }}"
             height="{{ banner.height }}"
             alt="{{ current_user.display_name }} (@{{ current_user.login_name }}) 동맹 배너"
             class="banner"
             src="{{ r2_public_endpoint_url }}/image/{{ banner.image_filename[:2] }}/{{ banner.image_filename }}" />
      {% endif %}
    {% else %}
      {% if user.id == current_user.id %}<a href="/banners/draw" class="button">{{ ftl_get_message("profile-draw-banner") }}</a>{% endif %}
    {% endif %}
  </div>
</div>
{% if current_user and current_user.id != user.id %}
  <form hx-post="/@{{ user.login_name }}/guestbook" hx-swap="outerHTML"
        hx-disable="find button">
    <textarea name="content" title="{{ ftl_get_message("guestbook") }}"></textarea>
    <input type="submit" value="{{ ftl_get_message("guestbook-write") }}" />
  </form>
{% endif %}
{% if guestbook_entries|length == 0 %}
  <p class="muted">{{ ftl_get_message("guestbook-empty") }}</p>
{% else %}
  <div class="guestbook-entries">
    {% for entry in guestbook_entries %}
      {{ guestbook_entry(entry) }}
    {% endfor
    %}
  </div>
{% endif %}
</div>
{% endblock content %}
