{# The site's light/dark choice, applied to every page before it paints.

   The toolbar's theme menu remembers a choice under `neo-cucumber-theme`
   (the name dates from when the painter had its own switch) and marks the
   root `data-theme`; every token on the site and in the painter honours that
   ahead of the system setting. It has to run here, in the head: a page that
   paints first and then turns dark flashes. Boosted navigation keeps the
   root element, so the mark survives it. #}
{% include "app_bridge.jinja" %}
<script>
  // Which app, if any, this page is in -- the one place anything asks. Each
  // app's web view ends its user agent with a token of one shape,
  //
  //   OeeeCafe platform/<app> [store/<store>]
  //
  // (WebTabController.swift, WebTabController.kt, chrome.rs in
  // oeee-cafe-desktop) -- the platform and the store, when there is one, in
  // either order, each a space after the last. The first of each counts, and
  // anything else ends the run, so a store/ further along is not the app's;
  // and each is read only as a word of its own. It marks the root here,
  // before the page paints, so nothing that differs in an app flashes up and
  // away. Three marks, one question each:
  //
  //   data-app    which app: "ios", "android", "macos" or "windows"
  //   data-form   the kind of device it is on: "handheld" for the phone and
  //               tablet apps, full screen under native gestures, where the
  //               page scrolls whole and the web view swipes back itself;
  //               "desktop" for the Mac and Windows windows, whose title bar
  //               is the site's toolbar
  //   data-store  where the build sells: "apple", "microsoft" or "steam";
  //               absent in one that does not (app_store.jinja). The server
  //               reads the same words by the same rule to choose
  //               /supporter's buttons (Store::from_user_agent), so the two
  //               change together.
  //
  // A browser has none of them. Only ever about what to show: nothing is
  // trusted for being marked, and a purchase is checked with the store.
  (function () {
    var ua = navigator.userAgent;
    var run = /\bOeeeCafe((?: (?:platform|store)\/\w+)+)/g;
    var found, app, store;
    while (!app && (found = run.exec(ua))) {
      var words = {};
      found[1].replace(/ (platform|store)\/(\w+)/g, function (_, key, value) {
        if (!words.hasOwnProperty(key)) words[key] = value;
      });
      if (/^(ios|android|macos|windows)$/.test(words.platform || "")) {
        app = words.platform;
        if (/^(apple|microsoft|steam)$/.test(words.store || "")) store = words.store;
      }
    }
    if (!app) return;
    var root = document.documentElement;
    root.setAttribute("data-app", app);
    root.setAttribute("data-form", app === "ios" || app === "android" ? "handheld" : "desktop");
    if (store) root.setAttribute("data-store", store);
  })();
  if (document.documentElement.getAttribute("data-app") === "ios") {
    // The reader's text size (Dynamic Type), for the design system's type
    // scale to follow (--oeee-text-scale): WebKit gives the page the
    // system's own body style as a font, 17px at the default size, so its
    // size over 17 is the setting. Measured again when the app comes back to the front,
    // which is how the reader returns from changing it. The Android app says
    // it itself (SiteBridge.kt in oeee-cafe-android).
    (function () {
      var root = document.documentElement;
      function measure() {
        var probe = document.createElement("span");
        probe.style.cssText = "position:absolute;visibility:hidden;font:-apple-system-body";
        root.appendChild(probe);
        var size = parseFloat(getComputedStyle(probe).fontSize);
        root.removeChild(probe);
        if (size > 0) root.style.setProperty("--oeee-text-scale", String(size / 17));
      }
      measure();
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") measure();
      });
    })();
    // Going back in the app is the web view's edge swipe, which already
    // moved the page; a cross-fade after it would move it twice. Listened
    // for here, in the head, so it is heard before the page first paints.
    var fromCache = false;
    window.addEventListener("pageshow", function (event) {
      fromCache = event.persisted;
    });
    window.addEventListener("pagereveal", function (event) {
      if (!event.viewTransition) return;
      var entry = window.performance && performance.getEntriesByType
        ? performance.getEntriesByType("navigation")[0] : null;
      if (fromCache || (entry && entry.type === "back_forward")) {
        event.viewTransition.skipTransition();
      }
    });
  }
  if (document.documentElement.getAttribute("data-form") === "desktop") {
    // Nor do the Mac and Windows apps pinch to zoom -- the phone and tablet
    // apps are held by their viewport (base.jinja), which neither of these
    // web views reads. A trackpad pinch reaches the page as a ctrl-wheel in
    // WebView2 and as gesture events in WebKit, and a touch screen's is a
    // touch gesture; the page declining each is what keeps the view still.
    // The painter's own pinch (useZoomControls.ts) is a listener on its
    // stage, which hears the ctrl-wheel before it gets here.
    document.documentElement.style.touchAction = "pan-x pan-y";
    window.addEventListener("wheel", function (event) {
      if (event.ctrlKey) event.preventDefault();
    }, { passive: false });
    ["gesturestart", "gesturechange", "gestureend"].forEach(function (name) {
      window.addEventListener(name, function (event) {
        event.preventDefault();
      });
    });
  }
  if (document.documentElement.getAttribute("data-app") === "macos") {
    // The Mac app's window has no title bar of its own: the toolbar is it.
    // A press on the toolbar's empty space (data-window-drag, toolbar.jinja)
    // moves the window, and a double click zooms it, as a title bar's do --
    // asked of the app on the bridge (a `window` message, app_bridge.jinja),
    // which alone can move a window. Its links, buttons and fields stay the
    // page's. From the head, so it is heard on every page, the painter's and
    // the collaborative room's included.
    window.addEventListener("mousedown", function (event) {
      if (event.button !== 0 || event.defaultPrevented) return;
      var target = event.target;
      if (!target || !target.closest || !target.closest("[data-window-drag]")) return;
      if (target.closest("a, button, input, select, textarea, label, summary, details, [role], [contenteditable], [tabindex], [hx-get], [hx-post]")) return;
      if (!window.oeeeApp || !window.oeeeApp.post) return;
      event.preventDefault();
      window.oeeeApp.post("window", { action: event.detail === 2 ? "zoom" : "drag" }, true);
    });
    // And the browser's own right-click menu -- Back, Reload, Open in New
    // Window -- is the plainest sign that a window is a browser, so it is
    // kept to text fields, a selection and pictures. Anywhere else a right
    // click does nothing, unless the page has a use of its own for it, as
    // the painter does. (Windows prunes WebView2's menu item by item
    // instead, context_menu.rs in oeee-cafe-desktop.)
    window.addEventListener("contextmenu", function (event) {
      if (event.defaultPrevented) return;
      var target = event.target;
      if (target && target.closest && target.closest("input, textarea, select, [contenteditable], img")) return;
      if (window.getSelection && String(window.getSelection()) !== "") return;
      event.preventDefault();
    });
  }
  // In a function of its own, so what it keeps is not the window's.
  (function () {
    if (!window.oeeeApp || !window.oeeeApp.connected()) return;
    // Controls are felt as well as seen, as the apps' own are: "light",
    // "medium", "selection", "success", "warning", "error", sent to the app
    // as a haptic message (app_bridge.jinja). Sent to any app listening, not
    // to a kind of device: one that has nothing to feel them with -- a Mac,
    // Windows -- ignores them, as it ignores any message it does not use.
    //
    // Most of it is read off what the markup already says, so a new page is
    // felt without asking: a primary button is a medium press, any other
    // button a light one, a request a press sent is felt as how it went, and
    // a confirmation that destroys something is a warning
    // (confirm_dialog.jinja). data-haptic on a control says otherwise for
    // it, and data-haptic="none" silences everything inside the element
    // that carries it.
    function feel(name) {
      if (name && name !== "none") window.oeeeApp.feel(name);
    }
    // What sends a request that changes something, whose outcome is felt
    // instead of the press: a control of htmx's own, or a form's submit
    // button when the form posts and htmx sends it (boosted). A form that
    // posts by loading the next page has no outcome here to feel -- the page
    // is gone before it -- so its press is felt instead; nearly every form
    // on the site is one, since only the toolbar and the pills are boosted.
    function sends(control) {
      if (control.closest("[hx-post], [hx-put], [hx-patch], [hx-delete]")) return true;
      var form = control.form;
      return !!form && control.matches('button:not([type]), button[type="submit"], input[type="submit"]') &&
        (form.getAttribute("method") || "").toLowerCase() === "post" &&
        !!window.htmx && !!form.closest('[hx-boost\\:inherited="true"]') &&
        !form.closest('[hx-boost="false"]');
    }
    var PRESSABLE = [
      ".ds-button", ".ds-page button:not([class])", '.ds-page input[type="submit"]:not([class])',
      '.ds-page input[type="button"]:not([class])', '.ds-page input[type="reset"]:not([class])',
      ".nav-bar .toolbar-square", ".nav-bar .toolbar-live", ".nav-bar .toolbar-search-glass",
      ".toolbar-menu > summary", ".toolbar-menu-items > a", ".toolbar-menu-signout", ".profile-more-item",
      ".reaction-custom > summary", ".profile-chip", ".ds-notice-close", ".auth-provider", ".neo-button"
    ].join(", ");
    // The control last felt on its press, so what it sent is not felt twice.
    var pressed = null;
    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      pressed = null;
      // A control that says how it feels (data-haptic), or a quiet region.
      var control = target.closest("[data-haptic]");
      if (control) {
        var name = control.getAttribute("data-haptic");
        if (name !== "none") pressed = control;
        feel(name);
        return;
      }
      // A primary button, unless what it sends will be felt when it is done.
      var primary = target.closest(".ds-button-primary");
      if (primary) {
        if (!primary.disabled && !sends(primary)) {
          pressed = primary;
          feel("medium");
        }
        return;
      }
      // A segmented control ticks when its choice changes, as a picker does;
      // pressing the segment already chosen changes nothing.
      var segment = target.closest(".ds-segmented > *");
      if (segment) {
        if (!segment.matches('[aria-pressed="true"], [aria-current="page"], .is-selected')) feel("selection");
        return;
      }
      // Anything else that looks pressable is a light press: what ds.css
      // gives a pressed look (:active), the toolbar's squares, menus and
      // 넷캔, chips, a notice's close, the sign in providers' own buttons,
      // and NEO's bevelled buttons in the painters (.neo-button). Not a link
      // in text, nor a card: a list is not felt as it is tapped through.
      var button = target.closest(PRESSABLE);
      if (button && !button.disabled && !sends(button)) {
        pressed = button;
        feel("light");
      }
    }, true);
    // So do a checkbox or a radio when it changes, and a slider at each step.
    document.addEventListener("change", function (event) {
      var target = event.target;
      if (target && target.matches && target.matches('input[type="checkbox"], input[type="radio"]') &&
          !target.closest('[data-haptic="none"]')) feel("selection");
    }, true);
    document.addEventListener("input", function (event) {
      var target = event.target;
      if (target && target.matches && target.matches('input[type="range"]') &&
          !target.closest('[data-haptic="none"]')) feel("selection");
    }, true);
    // What a press asked the site for. A failure is felt as one; a change
    // that went through is felt as a success, or as the form's
    // data-haptic-done says, unless its press was felt already. Only a press
    // or a submission -- a page loading more as it scrolls is not felt, and
    // nor is a page a link fetched.
    function byPress(ctx) {
      var event = ctx && ctx.sourceEvent;
      return !!event && (event.type === "click" || event.type === "submit");
    }
    document.addEventListener("htmx:after:request", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (!byPress(ctx)) return;
      var source = ctx.sourceElement || event.target;
      if (source && source.closest && source.closest('[data-haptic="none"]')) return;
      if (ctx.response && ctx.response.status >= 400) {
        feel("error");
        return;
      }
      var method = ((ctx.request && ctx.request.method) || "GET").toUpperCase();
      if (method === "GET") return;
      var from = ctx.sourceEvent.submitter || ctx.sourceEvent.target;
      if (pressed && from && pressed.contains(from)) return;
      var done = source && source.closest ? source.closest("[data-haptic-done]") : null;
      feel(done ? done.getAttribute("data-haptic-done") : "success");
    });
    document.addEventListener("htmx:error", function (event) {
      if (byPress(event.detail && event.detail.ctx)) feel("error");
    });
  })();
  try {
    var theme = localStorage.getItem("neo-cucumber-theme");
    if (theme === "light" || theme === "dark") {
      document.documentElement.setAttribute("data-theme", theme);
    }
  } catch (error) {
    // Storage refused: the system setting decides, as it does by default.
  }
</script>
{% include "app_sign_in.jinja" %}
{% include "app_store.jinja" %}
{% include "app_polyfills.jinja" %}
<script>
  // A page htmx could not fetch is fetched again as an ordinary navigation.
  //
  // htmx fetches the site's pages itself (hx-boost, toolbar.jinja). When
  // nothing answers it does nothing at all, and when a gateway answers in
  // the site's place -- a proxy's 502, 503 or 504 during a deploy,
  // Cloudflare's 52x and 530 when the Mac mini is out of reach -- it swaps
  // the gateway's page into the body. Either way the reader is left on a
  // page that is not the one they asked for and cannot tell why. Asked
  // again as a navigation, the failure is the browser's to show -- and in
  // the apps, each of which puts up its own "can't be reached" screen when
  // a page fails to load (Unreachable.swift, Unreachable.kt, offline.rs in
  // oeee-cafe-desktop), the app's. Each app used to watch htmx for this
  // itself, or not at all.
  //
  // Only a page: the whole body, by GET. A part of a page that fails is the
  // page's to show, and an error page of the site's own -- a 404, a 500 --
  // is the site speaking, and is swapped in as usual.
  (function () {
    var GATEWAY = [502, 503, 504, 520, 521, 522, 523, 524, 525, 526, 527, 530];
    function page(ctx) {
      return !!ctx && ctx.target === document.body && !!ctx.request &&
        String(ctx.request.method).toUpperCase() === "GET";
    }
    document.addEventListener("htmx:before:swap", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (!page(ctx) || !ctx.response || GATEWAY.indexOf(ctx.response.status) < 0) return;
      event.preventDefault();
      location.assign(ctx.request.action);
    });
    document.addEventListener("htmx:error", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (!page(ctx) || ctx.response) return;
      location.assign(ctx.request.action);
    });
  })();
</script>
