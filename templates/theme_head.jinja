{# The site's light/dark choice, applied to every page before it paints.

   The toolbar's theme menu remembers a choice under `neo-cucumber-theme`
   (the name dates from when the painter had its own switch) and marks the
   root `data-theme`; every token on the site and in the painter honours that
   ahead of the system setting. It has to run here, in the head: a page that
   paints first and then turns dark flashes. Boosted navigation keeps the
   root element, so the mark survives it. #}
{% include "app_bridge.jinja" %}
<script>
  // Which app, if any, this page is in -- the one place anything asks. Each
  // app's web view ends its user agent with a token of one shape,
  //
  //   OeeeCafe platform/<app> [store/<store>]
  //
  // (WebTabController.swift, WebTabController.kt, chrome.rs in
  // oeee-cafe-desktop) -- the store, when there is one, straight after the
  // platform, and each read only as a word of its own -- and it marks the root here, before the page paints,
  // so nothing that differs in an app flashes up and away. Three marks, one
  // question each:
  //
  //   data-app    which app: "ios", "android", "macos" or "windows"
  //   data-form   the kind of device it is on: "handheld" for the phone and
  //               tablet apps, full screen under native gestures, where the
  //               page scrolls whole and the web view swipes back itself;
  //               "desktop" for the Mac and Windows windows, whose title bar
  //               is the site's toolbar
  //   data-store  where the build sells: "apple", "microsoft" or "steam";
  //               absent in one that does not (app_store.jinja). The server
  //               reads the same words by the same rule to choose
  //               /supporter's buttons (Store::from_user_agent), so the two
  //               change together.
  //
  // A browser has none of them. Only ever about what to show: nothing is
  // trusted for being marked, and a purchase is checked with the store.
  (function () {
    var ua = navigator.userAgent;
    var mark = /\bOeeeCafe platform\/(ios|android|macos|windows)(?: store\/(apple|microsoft|steam))?\b/.exec(ua);
    if (!mark) return;
    var root = document.documentElement;
    root.setAttribute("data-app", mark[1]);
    root.setAttribute("data-form", mark[1] === "ios" || mark[1] === "android" ? "handheld" : "desktop");
    if (mark[2]) root.setAttribute("data-store", mark[2]);
  })();
  if (document.documentElement.getAttribute("data-app") === "ios") {
    // The reader's text size (Dynamic Type), for the design system's type
    // scale to follow (--oeee-text-scale): WebKit gives the page the
    // system's own body style as a font, 17px at the default size, so its
    // size over 17 is the setting. Measured again when the app comes back to the front,
    // which is how the reader returns from changing it. The Android app says
    // it itself (SiteBridge.kt in oeee-cafe-android).
    (function () {
      var root = document.documentElement;
      function measure() {
        var probe = document.createElement("span");
        probe.style.cssText = "position:absolute;visibility:hidden;font:-apple-system-body";
        root.appendChild(probe);
        var size = parseFloat(getComputedStyle(probe).fontSize);
        root.removeChild(probe);
        if (size > 0) root.style.setProperty("--oeee-text-scale", String(size / 17));
      }
      measure();
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") measure();
      });
    })();
    // Going back in the app is the web view's edge swipe, which already
    // moved the page; a cross-fade after it would move it twice. Listened
    // for here, in the head, so it is heard before the page first paints.
    var fromCache = false;
    window.addEventListener("pageshow", function (event) {
      fromCache = event.persisted;
    });
    window.addEventListener("pagereveal", function (event) {
      if (!event.viewTransition) return;
      var entry = window.performance && performance.getEntriesByType
        ? performance.getEntriesByType("navigation")[0] : null;
      if (fromCache || (entry && entry.type === "back_forward")) {
        event.viewTransition.skipTransition();
      }
    });
  }
  if (document.documentElement.getAttribute("data-app") === "macos") {
    // The Mac app's window has no title bar of its own: the toolbar is it.
    // A press on the toolbar's empty space (data-window-drag, toolbar.jinja)
    // moves the window, and a double click zooms it, as a title bar's do --
    // asked of the app on the bridge (a `window` message, app_bridge.jinja),
    // which alone can move a window. Its links, buttons and fields stay the
    // page's. From the head, so it is heard on every page, the painter's and
    // the collaborative room's included.
    window.addEventListener("mousedown", function (event) {
      if (event.button !== 0 || event.defaultPrevented) return;
      var target = event.target;
      if (!target || !target.closest || !target.closest("[data-window-drag]")) return;
      if (target.closest("a, button, input, select, textarea, label, summary, details, [role], [contenteditable], [tabindex], [hx-get], [hx-post]")) return;
      if (!window.oeeeApp || !window.oeeeApp.post) return;
      event.preventDefault();
      window.oeeeApp.post("window", { action: event.detail === 2 ? "zoom" : "drag" }, true);
    });
    // And the browser's own right-click menu -- Back, Reload, Open in New
    // Window -- is the plainest sign that a window is a browser, so it is
    // kept to text fields, a selection and pictures. Anywhere else a right
    // click does nothing, unless the page has a use of its own for it, as
    // the painter does. (Windows prunes WebView2's menu item by item
    // instead, context_menu.rs in oeee-cafe-desktop.)
    window.addEventListener("contextmenu", function (event) {
      if (event.defaultPrevented) return;
      var target = event.target;
      if (target && target.closest && target.closest("input, textarea, select, [contenteditable], img")) return;
      if (window.getSelection && String(window.getSelection()) !== "") return;
      event.preventDefault();
    });
  }
  if (window.oeeeApp && window.oeeeApp.connected()) {
    // Controls are felt as well as seen, as the apps' own are: "light",
    // "medium", "selection", "success", "warning", "error", sent to the app
    // as a haptic message (app_bridge.jinja). Sent to any app listening, not
    // to a kind of device: one that has nothing to feel them with -- a Mac,
    // Windows -- ignores them, as it ignores any message it does not use.
    function feel(name) {
      window.oeeeApp.feel(name);
    }
    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      // A control that says how it feels (data-haptic).
      var control = target.closest("[data-haptic]");
      if (control) {
        feel(control.getAttribute("data-haptic"));
        return;
      }
      // A segmented control ticks when its choice changes, as a picker does;
      // pressing the segment already chosen changes nothing.
      var segment = target.closest(".ds-segmented > *");
      if (segment && !segment.matches('[aria-pressed="true"], [aria-current="page"], .is-selected')) {
        feel("selection");
      }
    }, true);
    // So do a checkbox or a radio when it changes, and a slider at each step.
    document.addEventListener("change", function (event) {
      var target = event.target;
      if (target && target.matches && target.matches('input[type="checkbox"], input[type="radio"]')) feel("selection");
    }, true);
    document.addEventListener("input", function (event) {
      var target = event.target;
      if (target && target.matches && target.matches('input[type="range"]')) feel("selection");
    }, true);
    // What a press asked the site for: a failure is felt as one, and a form
    // marked data-haptic-done is felt when it has gone through. Only a press
    // or a submission -- a page loading more as it scrolls is not felt.
    function pressed(ctx) {
      var event = ctx && ctx.sourceEvent;
      return !!event && (event.type === "click" || event.type === "submit");
    }
    document.addEventListener("htmx:after:request", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (!pressed(ctx)) return;
      if (ctx.response && ctx.response.status >= 400) {
        feel("error");
        return;
      }
      var done = event.target && event.target.closest ? event.target.closest("[data-haptic-done]") : null;
      if (done) feel(done.getAttribute("data-haptic-done"));
    });
    document.addEventListener("htmx:error", function (event) {
      if (pressed(event.detail && event.detail.ctx)) feel("error");
    });
  }
  try {
    var theme = localStorage.getItem("neo-cucumber-theme");
    if (theme === "light" || theme === "dark") {
      document.documentElement.setAttribute("data-theme", theme);
    }
  } catch (error) {
    // Storage refused: the system setting decides, as it does by default.
  }
</script>
