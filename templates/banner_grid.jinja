{# The whole grid of a user's banners.

   Its own template because activating one banner changes two cards -- the
   new one gains the in-use mark and loses its buttons, the old one does the
   reverse -- so no single card is a big enough unit to swap. Both
   `do_activate_banner` and `do_delete_banner` render this and hand it back.

   Swapped with `outerMorph`: every card holds an <img> pulled from R2, and
   replacing the grid outright discarded and refetched all of them for a change
   that usually moves one mark. #}
<div class="banner-grid" id="banner-grid">
  {% for banner_tuple in banners %}
    {% set banner = banner_tuple[0] %}
    {% set image_url = banner_tuple[1] %}
    <div class="ds-card banner-card{% if banner.is_active %} is-active{% endif %}">
      <span class="banner-frame"><img src="{{ image_url }}" alt="" width="200" height="40" /></span>
      <div class="banner-card-meta">
        <span title="{{ banner.created_at|datetimeformat(format="short", tz="Asia/Seoul") }}">{{ ftl_get_message("banner-management-created") }} {{ banner.created_at|ago }}</span>
        {% if banner.is_active %}
          <span class="community-card-badge banner-active">{{ ftl_get_message("banner-management-active-badge") }}</span>
        {% endif %}
      </div>
      {% if not banner.is_active %}
        <div class="banner-card-actions">
          <button class="ds-button ds-button-small"
                  hx-post="/banners/{{ banner.id }}/activate"
                  hx-target="#banner-grid"
                  hx-swap="outerMorph"
                  hx-disable="this">{{ ftl_get_message("banner-management-set-active") }}</button>
          <button class="ds-button ds-button-small"
                  hx-delete="/banners/{{ banner.id }}"
                  hx-confirm="{{ ftl_get_message("banner-management-delete-confirm") }}"
                  hx-target="#banner-grid"
                  hx-swap="outerMorph"
                  hx-disable="this">{{ ftl_get_message("banner-management-delete") }}</button>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
