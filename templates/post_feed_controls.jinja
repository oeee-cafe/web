{# How many drawings a row, as /admin/posts does it: the reader picks a number
   and the grid keeps it at every window width, the squares growing and
   shrinking to fit rather than the count changing under them. Remembered in
   this browser. Expects the grid it drives to be #post-feed-grid. #}
<div class="thumbnail-size">
  <label for="post-cols">{{ ftl_get_message("feed-columns") }}</label>
  <input type="range" id="post-cols" min="1" max="12" step="1" />
  <output id="post-cols-value"></output>
</div>
<script>
  (function () {
    // Matches the fallback in style.css's .posts-grid.
    var DEFAULT_COLS = 4;

    function init() {
      var slider = document.getElementById("post-cols");
      var readout = document.getElementById("post-cols-value");
      if (!slider) return;
      var root = document.documentElement;
      var saved = parseInt(localStorage.getItem("homeCols"), 10);
      var cols = saved >= 1 && saved <= 12 ? saved : DEFAULT_COLS;
      slider.value = cols;
      readout.textContent = cols;
      slider.addEventListener("input", function () {
        var value = parseInt(slider.value, 10);
        root.style.setProperty("--home-cols", value);
        readout.textContent = value;
        try {
          localStorage.setItem("homeCols", value);
        } catch (error) {
          // Not remembering it is not a reason to refuse the change.
        }
      });
    }

    // This partial sits above the grid it drives; waiting for the parse makes
    // its place in the page irrelevant.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
