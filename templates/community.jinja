{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ community.name }}
{% endblock title %}
{% block social_meta %}
  {% if community.visibility == "public" %}
    <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ community.name }}" />
    <meta property="og:description" content="{{ community.description }}" />
    <meta property="og:url" content="{{ base_url|safe }}/@{{ community.slug }}" />
    <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@oeee_cafe" />
  {% endif %}
{% endblock social_meta %}
{% block head %}
  {# Unlisted and private communities should not show up in search results,
     and there is nothing to preview for someone who cannot open them. #}
  {% if community.visibility != "public" %}
    <meta name="robots" content="noindex, nofollow" />
  {% endif %}
  <link rel="alternate"
        type="application/activity+json"
        href="https://{{ domain }}/ap/communities/{{ community.id }}" />
  {% include "post_feed_head.jinja" %}
{% endblock head %}
{% block content %}
  <div class="center">
    {% block community_edit_block %}
      {# :inherited so the edit button below still swaps this header out.
         htmx 4 does not pass attributes down to children on its own. #}
      <div hx-target:inherited="this"
           hx-swap:inherited="outerHTML"
           class="community-header">
        <div>
          <h2>{{ community.name }}</h2>
          <p class="community-handle">@{{ community.slug }}@{{ domain }}</p>
        </div>
        <p class="community-description">{{ community.description }}</p>
        {# Shown to everyone, because the comments link is the only way left to
           reach them: the page below is the drawing feed and nothing else. #}
        <div class="community-menu">
          {% if current_user and current_user.id == community.owner_id %}
            <button hx-get="/communities/{{ community_id }}/edit">{{ ftl_get_message("edit") }}</button>
          {% endif %}
          {# Opens the lobby with this community preselected, so the session's
             saved drawing lands here. Goes through the lobby rather than
             creating a session outright so the canvas size, title and
             participant limit can still be chosen.

             Hidden for two-tone communities: they are excluded from the
             postable set, so the option would not exist to be preselected
             and the session would silently save with no community. They have
             their own drawing card below. #}
          {% if current_user and not community.background_color %}
            <a href="/collaborate?community={{ community.slug }}" class="btn">
              {{ ftl_get_message("community-draw-together") }}
            </a>
          {% endif %}
          <a href="/communities/@{{ community.slug }}/comments" class="btn">{{ ftl_get_message("recent-comments") }}</a>
          {% if current_user and community.visibility == "private" %}
            <a href="/communities/@{{ community.slug }}/members" class="btn">{{ ftl_get_message("community-members") }}</a>
          {% endif %}
        </div>
      </div>
    {% endblock community_edit_block %}
    {# Two-tone communities draw offline in the fixed pair of colours the
       community was created with. This used to hang off the stats card, which
       is gone; the form is what people came for, so it stands on its own. #}
    {% if current_user and community.background_color %}
      <div class="community-drawing-card">
        <form action="/draw" method="post" onsubmit="setOrientationDimensions(event, this)">
          <input type="hidden" name="tool" value="neo" />
          <input type="hidden" name="community_id" value="{{ community_id }}" />
          <input type="hidden" name="width" value="640" />
          <input type="hidden" name="height" value="480" />
          <fieldset>
            <legend>{{ ftl_get_message('community-drawing-orientation') }}</legend>
            <label>
              <input type="radio" name="orientation" value="landscape" checked />
              {{ ftl_get_message('community-drawing-landscape') }} (640 × 480)
            </label>
            <label>
              <input type="radio" name="orientation" value="portrait" />
              {{ ftl_get_message('community-drawing-portrait') }} (480 × 640)
            </label>
          </fieldset>
          <input type="submit" value="{{ ftl_get_message('community-drawing-new') }}" />
        </form>
        <script>
          function setOrientationDimensions(event, form) {
            const orientation = form.querySelector('input[name="orientation"]:checked').value;
            if (orientation === 'landscape') {
              form.querySelector('input[name="width"]').value = '640';
              form.querySelector('input[name="height"]').value = '480';
            } else if (orientation === 'portrait') {
              form.querySelector('input[name="width"]').value = '480';
              form.querySelector('input[name="height"]').value = '640';
            }
          }
        </script>
      </div>
    {% endif %}
    {% if current_user and not community.background_color %}
      <div class="community-drawing-card">
        <form action="/draw" method="post">
          <input type="hidden" name="community_id" value="{{ community_id }}" />
          <select name="tool" title="{{ ftl_get_message('community-drawing-tool') }}">
            <option value="neo" selected>Neo Cucumber</option>
            <option value="tegaki">Tegaki</option>
          </select>
          <select name="width" title="{{ ftl_get_message('community-drawing-width') }}">
            <option value="300" selected>300</option>
            <option value="350">350</option>
            <option value="400">400</option>
            <option value="450">450</option>
            <option value="500">500</option>
            <option value="550">550</option>
            <option value="600">600</option>
            <option value="650">650</option>
            <option value="700">700</option>
            <option value="750">750</option>
            <option value="800">800</option>
            <option value="850">850</option>
            <option value="900">900</option>
            <option value="950">950</option>
            <option value="1000">1000</option>
            <option value="1024">1024</option>
          </select>
          <span>×</span>
          <select name="height"
                  title="{{ ftl_get_message('community-drawing-height') }}">
            <option value="300" selected>300</option>
            <option value="350">350</option>
            <option value="400">400</option>
            <option value="450">450</option>
            <option value="500">500</option>
            <option value="550">550</option>
            <option value="600">600</option>
            <option value="650">650</option>
            <option value="700">700</option>
            <option value="750">750</option>
            <option value="768">768</option>
            <option value="800">800</option>
          </select>
          <input type="submit" value="{{ ftl_get_message('community-drawing-new') }}" />
        </form>
      </div>
    {% endif %}
  </div>
  {# The drawings are the page from here down, and they get the same chrome as
     /: shared head, column control, grid and card fragment. Only the grid opts
     into the wider column, so the header above it stays put. #}
  {# `feed` is missing when a handler only wants the header block above: saving
     or cancelling the edit form renders that block alone, and minijinja still
     walks the rest of the template to reach it. #}
  {% set feed_posts = feed.posts if feed is defined else [] %}
  <div class="center-wide">
    <section role="region" aria-labelledby="post-feed-heading">
      <div class="feed-header">
        <h2 id="post-feed-heading" class="home-section-title">{{ ftl_get_message("recent-drawings") }}</h2>
        {# Only with posts to arrange: an empty feed has no columns to set. #}
        {% if feed_posts %}
          {% include "post_feed_controls.jinja" %}
        {% endif %}
      </div>
      {% if feed_posts %}
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      {% else %}
        <p>{{ ftl_get_message("community-no-posts") }}</p>
      {% endif %}
    </section>
  </div>
{% endblock content %}
