{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ community.name }}
{% endblock title %}
{% block social_meta %}
  {% if community.visibility == "public" %}
    <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ community.name }}" />
    <meta property="og:description" content="{{ community.description }}" />
    <meta property="og:url" content="{{ base_url|safe }}/@{{ community.slug }}" />
    <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@oeee_cafe" />
  {% endif %}
{% endblock social_meta %}
{% block head %}
  {# Unlisted and private communities should not show up in search results,
     and there is nothing to preview for someone who cannot open them. #}
  {% if community.visibility != "public" %}
    <meta name="robots" content="noindex, nofollow" />
  {% endif %}
  <link rel="alternate"
        type="application/activity+json"
        href="https://{{ domain }}/ap/communities/{{ community.id }}" />
{% endblock head %}
{% block content %}
  {% include "post_feed_head.jinja" %}
  {# A community, laid out the way the profile lays out a person: one card
     with what it is and what you can do in it, then its drawings. The
     drawing form used to sit open under the header as a row of bare
     selects; it is the one thing people come here to do, so it is the
     primary button, and the choices it needs come up when it is pressed. #}
  <div class="profile community-page">
    {% block community_edit_block %}
      {# :inherited so the edit button below still swaps this header out.
         htmx 4 does not pass attributes down to children on its own. #}
      <section hx-target:inherited="this"
               hx-swap:inherited="outerHTML"
               class="profile-card ds-card community-header">
        <div class="profile-identity">
          <h1 class="profile-name">
            {{ community.name }}
            {% if community.visibility == "unlisted" %}
              <span class="community-card-badge">{{ ftl_get_message("community-badge-unlisted") }}</span>
            {% elif community.visibility == "private" %}
              <span class="community-card-badge">{{ ftl_get_message("community-badge-private") }}</span>
            {% endif %}
          </h1>
          <div class="profile-handle">@{{ community.slug }}@{{ domain }}</div>
          {% if community.description %}
            <p class="community-header-description">{{ community.description }}</p>
          {% endif %}
          {% if header is defined %}
            <div class="community-header-meta">
              {% if header.owner %}
                <a class="profile-chip" href="/@{{ header.owner.login_name }}" title="@{{ header.owner.login_name }}">{{ header.owner.display_name }}</a>
              {% endif %}
              {# A two-tone community draws in the pair of colours it was
                 made with, which is worth knowing before pressing Draw. #}
              {% if community.background_color %}
                <span class="community-colors" aria-hidden="true">
                  <span style="background-color: {{ community.background_color }}"></span><span style="background-color: {{ community.foreground_color }}"></span>
                </span>
              {% endif %}
              <span class="community-header-stats">
                {{ header.posts_count }} {{ ftl_get_message("community-stats-posts") }}
                · {{ header.contributors_count }} {{ ftl_get_message("community-stats-contributors") }}
              </span>
            </div>
          {% endif %}
        </div>
        <div class="profile-actions">
          {# A guest can draw for a public community too, keeping the
             drawing in the browser until they have an account; drawing
             together, and anything unlisted or private, is for someone
             signed in (draw.rs, may_draw_in). #}
          {% if current_user or community.visibility == "public" %}
            <button type="button" class="ds-button ds-button-primary" onclick="showCommunityDrawModal()">{{ ftl_get_message("community-drawing-new") }}</button>
          {% endif %}
          {% if current_user %}
            {# Opens the lobby with this community preselected, so the
               session's saved drawing lands here. Goes through the lobby
               rather than creating a session outright so the canvas size,
               title and participant limit can still be chosen.

               Not for two-tone communities: they are excluded from the
               postable set, so the option would not exist to be preselected
               and the session would silently save with no community. #}
            {% if not community.background_color %}
              <a href="/collaborate?community={{ community.slug }}" class="ds-button">{{ ftl_get_message("community-draw-together") }}</a>
            {% endif %}
          {% endif %}
          <a href="/communities/@{{ community.slug }}/comments" class="ds-button">{{ ftl_get_message("recent-comments") }}</a>
          {% if current_user and community.visibility == "private" %}
            <a href="/communities/@{{ community.slug }}/members" class="ds-button">{{ ftl_get_message("community-members") }}</a>
          {% endif %}
          {% if current_user and current_user.id == community.owner_id %}
            <button type="button" class="ds-button" hx-get="/communities/{{ community_id }}/edit">{{ ftl_get_message("edit") }}</button>
          {% endif %}
        </div>
      </section>
    {% endblock community_edit_block %}
    {# The drawings, with the same chrome as /: shared head, column control,
       grid and card fragment. `feed` is missing when a handler only wants
       the header block above: saving or cancelling the edit form renders
       that block alone, and minijinja still walks the rest to reach it. #}
    {% set feed_posts = feed.posts if feed is defined else [] %}
    <section class="profile-section" role="region" aria-labelledby="post-feed-heading">
      <div class="grid-header">
        <div id="post-feed-heading" class="profile-section-label">{{ ftl_get_message("recent-drawings") }}</div>
        {# Only with posts to arrange: an empty feed has no columns to set. #}
        {% if feed_posts %}
          {% include "post_feed_controls.jinja" %}
        {% endif %}
      </div>
      {% if feed_posts %}
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      {% else %}
        <p class="profile-empty">{{ ftl_get_message("community-no-posts") }}</p>
      {% endif %}
    </section>
  </div>

  {% if current_user or community.visibility == "public" %}
    {# New drawing: the painter's choices, asked for when they are needed. #}
    <div id="community-draw-modal" class="ds-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="community-draw-title">
      <div class="ds-modal-panel">
        <h2 id="community-draw-title" tabindex="-1">{{ ftl_get_message("community-drawing-new") }}</h2>
        {% if community.background_color %}
          {# Two-tone communities draw offline in the fixed pair of colours
             the community was created with, at one of two sizes. #}
          <form action="/draw" method="post" onsubmit="setOrientationDimensions(this)">
            <input type="hidden" name="tool" value="neo" />
            <input type="hidden" name="community_id" value="{{ community_id }}" />
            <input type="hidden" name="width" value="640" />
            <input type="hidden" name="height" value="480" />
            <div class="form-field">
              <span class="ds-label">{{ ftl_get_message('community-drawing-orientation') }}</span>
              <label class="community-draw-choice">
                <input type="radio" name="orientation" value="landscape" checked />
                {{ ftl_get_message('community-drawing-landscape') }} <span class="ds-help">640 × 480</span>
              </label>
              <label class="community-draw-choice">
                <input type="radio" name="orientation" value="portrait" />
                {{ ftl_get_message('community-drawing-portrait') }} <span class="ds-help">480 × 640</span>
              </label>
            </div>
            <div class="form-actions community-draw-actions">
              <button type="button" class="ds-button" onclick="hideCommunityDrawModal()">{{ ftl_get_message("cancel") }}</button>
              <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("community-drawing-new") }}</button>
            </div>
          </form>
        {% else %}
          <form action="/draw" method="post">
            <input type="hidden" name="tool" value="neo" />
            <input type="hidden" name="community_id" value="{{ community_id }}" />
            <div class="form-field community-draw-size">
              <label>
                <span class="ds-label">{{ ftl_get_message('community-drawing-width') }}</span>
                <select name="width" class="ds-select">
                  {% for w in [300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 800, 850, 900, 950, 1000, 1024] %}
                    <option value="{{ w }}" {% if w == 300 %}selected{% endif %}>{{ w }}</option>
                  {% endfor %}
                </select>
              </label>
              <span class="community-draw-times" aria-hidden="true">×</span>
              <label>
                <span class="ds-label">{{ ftl_get_message('community-drawing-height') }}</span>
                <select name="height" class="ds-select">
                  {% for h in [300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 768, 800] %}
                    <option value="{{ h }}" {% if h == 300 %}selected{% endif %}>{{ h }}</option>
                  {% endfor %}
                </select>
              </label>
            </div>
            <div class="form-actions community-draw-actions">
              <button type="button" class="ds-button" onclick="hideCommunityDrawModal()">{{ ftl_get_message("cancel") }}</button>
              <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("community-drawing-new") }}</button>
            </div>
          </form>
        {% endif %}
      </div>
    </div>
    <script>
      function showCommunityDrawModal() {
        var modal = document.getElementById("community-draw-modal");
        modal.style.display = "flex";
        // Focus the heading, not the first field: on iOS a focused <select>
        // opens its picker, so the width wheel would come up with the modal.
        document.getElementById("community-draw-title").focus();
      }
      function hideCommunityDrawModal() {
        document.getElementById("community-draw-modal").style.display = "none";
      }
      function setOrientationDimensions(form) {
        var portrait = form.querySelector('input[name="orientation"]:checked').value === "portrait";
        form.querySelector('input[name="width"]').value = portrait ? "480" : "640";
        form.querySelector('input[name="height"]').value = portrait ? "640" : "480";
      }
      (function () {
        var modal = document.getElementById("community-draw-modal");
        modal.addEventListener("click", function (e) {
          if (e.target === modal) hideCommunityDrawModal();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && modal.style.display !== "none") hideCommunityDrawModal();
        });
      })();
    </script>
  {% endif %}
{% endblock content %}
