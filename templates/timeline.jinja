{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("timeline") }}
{% endblock title %}
{% block head %}
{% endblock head %}
{% block content %}
  {% include "post_feed_head.jinja" %}
  <div class="center-wide">
    {# Same chrome as /: shared head, controls, grid and card fragment. The two
       feeds differ only in which query fills them and where the sentinel
       points, both of which come from the `feed` object. #}
    <section role="region" aria-labelledby="post-feed-heading">
      <div class="feed-header">
        <h2 id="post-feed-heading" class="home-section-title">{{ ftl_get_message("timeline-my") }}</h2>
        {# Only with posts to arrange: an empty feed has no columns to set. #}
        {% if feed.posts and feed.posts|length > 0 %}
          {% include "post_feed_controls.jinja" %}
        {% endif %}
      </div>
      {% if feed.posts and feed.posts|length > 0 %}
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      {% else %}
        <p>{{ ftl_get_message("timeline-empty")|safe }}</p>
      {% endif %}
    </section>
  </div>
{% endblock content %}
