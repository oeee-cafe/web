{# The mark a supporter wears beside their name wherever a page prints it:
   the mark of the platform they bought this year's Supporter Pack on. A
   gamepad for the Steam DLC, an apple for an App Store purchase, the
   Microsoft Store's own shopping bag for one bought there (see
   models/supporter.rs, which is also where the year comes in -- a pack is a
   year's, and the years someone has bought are on their profile). It leads
   to the thanks on /about.

   Emoji rather than artwork, so a mark is one character the reader's own
   system draws and no icon set has to be kept in step with the providers.
   A mark is only ever a provider's name -- `users.supporter_mark` and
   `user_identities.provider` are held to one list by a CHECK apiece and by
   `the_marks_are_what_the_database_allows` -- so there is no fallback here:
   a platform without a mark below wears nothing at all.

   `supporter_mark()` is the mark alone, for a chip that spells the platform
   out beside it, and `supporter_badge()` the small inline mark. A page that
   knows several people passes the marks of the supporters among them, by
   login name, and asks for each name it prints; a name that is not a
   supporter is not in there and gets nothing. #}
{% macro supporter_mark(mark) -%}
  {%- if mark == "steam" -%}
    <span class="supporter-mark" aria-hidden="true">🎮</span>
  {%- elif mark == "apple" -%}
    <span class="supporter-mark" aria-hidden="true">🍎</span>
  {%- elif mark == "microsoft" -%}
    <span class="supporter-mark" aria-hidden="true">🛍️</span>
  {%- endif -%}
{%- endmacro %}

{# What the mark is called: the platform it came from. #}
{% macro supporter_mark_name(mark) -%}
  {%- if mark == "steam" -%}
    {{ ftl_get_message("supporter-badge-steam") }}
  {%- elif mark == "apple" -%}
    {{ ftl_get_message("supporter-badge-apple") }}
  {%- elif mark == "microsoft" -%}
    {{ ftl_get_message("supporter-badge-microsoft") }}
  {%- endif -%}
{%- endmacro %}

{% macro supporter_badge(supporters, login_name) -%}
  {#- A page that prints no supporter passes nothing at all, so the marks are
      defaulted before they are asked. -#}
  {%- set mark = (supporters or {})[login_name] -%}
  {%- if mark -%}
    <a class="supporter-badge" href="/about#supporters" title="{{ supporter_mark_name(mark) }}" aria-label="{{ supporter_mark_name(mark) }}">{{ supporter_mark(mark) }}</a>
  {%- endif -%}
{%- endmacro %}
