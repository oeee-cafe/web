{# One batch of post cards plus the sentinel that pulls the next batch.
   Shared by Home's feeds: each passes a `feed` object built by feed_context() in
   handlers/home.rs, so the sentinel points at whichever load-more endpoint
   that feed uses. Rendered inline for the first batch and standalone by the
   load-more handlers for the rest, so it must not depend on anything those
   handlers do not pass. #}
{% import "post_card.jinja" as card %}
{% for post in feed.posts %}
  {{ card.post_card(post, r2_public_endpoint_url, false) }}
{% endfor %}

{% if feed.has_more %}
  <div class="infinite-scroll-sentinel"
       hx-get="{{ feed.next_url }}"
       hx-trigger="revealed"
       hx-swap="outerHTML">
    <span class="loading-indicator">{{ ftl_get_message("loading-more-posts") }}</span>
  </div>
{% endif %}
