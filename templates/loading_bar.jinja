{# The loading bar: a thin line under the header while the next page is on
   its way, so a tap is seen to have been taken.

   Only in the apps (data-app, theme_head.jinja). A browser shows a page
   load in its own chrome, and the trips it cannot see -- htmx's -- already
   answer at the press: the toolbar's links with a skeleton, a page's pills
   by dimming the content. In an app there is no chrome, and a link inside a
   page keeps that page up, unchanged, until the next has come.

   The bar hangs from the header's bottom edge, inside it, so it goes
   wherever the header goes -- pinned, pulled down with a refresh, scrolled
   under the status bar. Fixed to the screen instead, it parted from the
   header as soon as either moved: iOS insets the page under the status bar,
   and a sticky header and a fixed bar do not agree on where the top is. A
   boosted swap puts a new header up mid-trip, and the bar is carried over
   into it where it had got to. It creeps towards the end and never reaches it on its own
   (ds.css, "The loading bar"); what finishes it is the page arriving --
   htmx's swap, or for a page load, the new document -- or, for a trip that
   never lands (a download, a cancelled load), a timeout.

   Clicks and submits start it at the press. In the apps built on WebKit, a
   press that loads a page holds the load back a frame, until the bar is on
   the screen (leave(), below).
   Any page load that is neither
   -- a script's, or back to a page not kept -- is caught as the page is
   about to be left (beforeunload, below). htmx's own trips are only ever
   the first kind.

   Included by toolbar.jinja, so the painter pages have it as well. A
   boosted swap runs this again; the document listeners are added once. #}
<script>
  (function () {
    if (!document.documentElement.getAttribute("data-app")) return;
    if (window.oeeeLoadingBar) return;

    var bar = null;
    var source = null;
    var request = null;
    var sent = null;
    var timeout = null;
    var clearing = null;

    function reset() {
      clearTimeout(timeout);
      clearTimeout(clearing);
      source = null;
      request = null;
      if (bar) bar.className = "ds-loading-bar";
    }
    function loadingNow() {
      return !!bar && bar.className.indexOf("is-loading") >= 0;
    }
    // Under the whole header, the notices included; the painter pages have
    // the toolbar alone.
    function hang() {
      var header = document.querySelector(".ds-page > header") || document.querySelector(".nav-bar");
      if (!header) return false;
      if (bar.parentNode !== header) header.appendChild(bar);
      return true;
    }
    function start(from, now) {
      if (navigator.onLine === false) return;
      if (!bar) {
        bar = document.createElement("div");
        bar.setAttribute("aria-hidden", "true");
      }
      reset();
      if (!hang()) return;
      // Read back once, so the step to .is-loading is a transition from
      // nothing rather than from wherever the last trip left it.
      void bar.offsetWidth;
      bar.className = "ds-loading-bar is-loading" + (now ? " is-now" : "");
      source = from || null;
      if (source && sent && sent.sourceElement === source && sent.status === "issuing") request = sent;
      timeout = setTimeout(done, 20000);
    }
    function done() {
      if (!loadingNow()) return;
      clearTimeout(timeout);
      source = null;
      request = null;
      bar.className = "ds-loading-bar is-done";
      clearing = setTimeout(reset, 600);
    }
    // A page load, as opposed to one of htmx's trips. WebKit stops putting
    // the page on the screen the moment a load begins -- scripts go on
    // running, but nothing they change is shown again -- so a bar started in
    // the same turn as the load is never seen. Measured in the simulator: the
    // page's own clock stopped at the tap. So in the apps built on it, the
    // bar goes up first, at once rather than after the usual moment, and the
    // load is begun a frame later, once it has been painted; what is on the
    // screen is then frozen with the bar in it, and its creep runs on the
    // compositor, which the freeze does not stop. Chromium, under the
    // Android and Windows apps, keeps painting the page until the next one
    // arrives, so there nothing is held back.
    var holds = /^(ios|macos)$/.test(document.documentElement.getAttribute("data-app"));
    function leave(go) {
      if (!holds || !window.requestAnimationFrame) {
        start(null);
        return go();
      }
      start(null, true);
      requestAnimationFrame(function () { go(); });
    }
    window.oeeeLoadingBar = { start: start, done: done, leave: leave };

    // On the window, so it is heard after every listener on the document:
    // those that do something with a link the page is leaving by (a
    // segmented control's thumb sliding to it, segmented.jinja) see a click
    // nobody has cancelled yet, and what they cancel is seen here.
    window.addEventListener("click", function (event) {
      if (event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      var link = event.target && event.target.closest ? event.target.closest("a[href]") : null;
      if (!link || link.target || link.hasAttribute("download")) return;
      // htmx cancels the click on a boosted link and fetches the page
      // itself; any other cancelled click is a script keeping the page.
      var boosted = link.closest('[hx-boost\\:inherited="true"]') && !link.closest('[hx-boost="false"]');
      if (event.defaultPrevented && !boosted) return;
      if (link.origin !== location.origin) return;
      if (link.pathname === location.pathname && link.search === location.search) return;
      if (boosted) return start(link);
      if (!holds) return start(null);
      event.preventDefault();
      var href = link.href;
      leave(function () { location.href = href; });
    });
    // A form that is sent as a page load, and a boosted one (the toolbar's)
    // that htmx sends. Forms of htmx's own -- a follow, a comment -- change
    // the page they are on and answer for themselves.
    window.addEventListener("submit", function (event) {
      var form = event.target;
      if (!form || !form.getAttribute || form.target) return;
      if ((form.getAttribute("method") || "").toLowerCase() === "dialog") return;
      if (form.hasAttribute("hx-post") || form.hasAttribute("hx-get") ||
          form.hasAttribute("hx-put") || form.hasAttribute("hx-delete")) return;
      var boosted = form.closest('[hx-boost\\:inherited="true"]') && !form.closest('[hx-boost="false"]');
      if (event.defaultPrevented && !boosted) return;
      if (boosted) return start(form);
      if (!holds) return start(null);
      // Sent again by hand once the bar is up. form.submit() leaves out the
      // button that was pressed, which some forms read, so it goes along as
      // a field of its own.
      event.preventDefault();
      var submitter = event.submitter;
      leave(function () {
        var carried = null;
        if (submitter && submitter.name && form.contains(submitter)) {
          carried = document.createElement("input");
          carried.type = "hidden";
          carried.name = submitter.name;
          carried.value = submitter.value;
          form.appendChild(carried);
        }
        HTMLFormElement.prototype.submit.call(form);
        if (carried) setTimeout(function () { if (carried.parentNode) carried.parentNode.removeChild(carried); }, 0);
      });
    });
    // Back to a page htmx has not kept: it is fetched again.
    document.addEventListener("htmx:before:history:restore", function () {
      start(document.body);
    });

    // htmx's request for the trip that started the bar is the one that ends
    // it, however it ends. The source element can be swapped away before
    // the end, so the request is remembered by its context once it is sent.
    // htmx's own click handler is on the link, so it usually sends the
    // request before the click reaches the document and starts the bar:
    // the last request sent is kept for start() to claim.
    document.addEventListener("htmx:before:request", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (!ctx) return;
      sent = ctx;
      if (source && ctx.sourceElement === source) request = ctx;
    });
    document.addEventListener("htmx:finally:request", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (!ctx || !(source || request)) return;
      if (ctx === request || ctx.sourceElement === source) done();
    });
    // A boosted swap replaces the header, and the bar with it. It is hung
    // under the new one where it had got to, and goes on from there.
    var reached = null;
    document.addEventListener("htmx:before:swap", function () {
      reached = loadingNow() && bar.parentNode ? getComputedStyle(bar).transform : null;
    });
    document.addEventListener("htmx:after:swap", function () {
      if (!reached || !loadingNow() || document.documentElement.contains(bar)) return;
      if (!hang()) return;
      bar.style.transition = "none";
      bar.style.transform = reached;
      bar.style.opacity = "1";
      void bar.offsetWidth;
      bar.style.transition = "";
      bar.style.transform = "";
      bar.style.opacity = "";
      reached = null;
    });
    // Every other page load: a script's (the apps' menus and shortcuts,
    // Draw's form.submit(), htmx following an HX-Redirect, a retry after a
    // gateway error), back or forward to a page that was not kept, the app
    // loading an address itself. The page stays up, and running, until the
    // next one commits. Looked at once every listener has had its say: a
    // page that asks whether to leave (a drawing not yet saved) may be
    // stayed on, and the bar would hang there, so it is left without.
    window.addEventListener("beforeunload", function (event) {
      setTimeout(function () {
        if (event.defaultPrevented) return;
        if (typeof event.returnValue === "string" && event.returnValue !== "") return;
        if (loadingNow()) return;
        start(null);
      }, 0);
    });
    // Back to a page kept in memory, left with the bar still going.
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) reset();
    });
  })();
</script>
