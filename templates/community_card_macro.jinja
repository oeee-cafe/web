{% from "storage_macro.jinja" import stored_url %}
{# The community card, shared by every list on /communities and by the
   infinite-scroll fragment, so a community looks the same however it arrived.

   The whole card is one target, the community, as a tile in an application
   is. Its three latest drawings are its cover, edge to edge; the drawings and
   the owner are a click further in, on the community's own page. Name, owner
   and stats each keep to one line that clips rather than wraps, so every card
   in a row is the same height.

   The description is a title attribute rather than a line of its own -- it
   averages a dozen characters across the site and half of all communities have
   none. #}
{% macro community_card(community, r2_public_endpoint_url) %}
  <a class="community-card" href="/@{{ community.slug }}" title="{{ community.description if community.description else community.name }}">
    <span class="community-card-cover">
      {% for post in community.recent_posts %}
        <span class="community-card-cell">
          <img src="{{ stored_url("image", post.image_filename) }}"
               alt=""
               class="{% if post.image_width > 300 and post.image_height > 300 %}drawing-downscaled{% endif %}"
               width="{{ post.image_width }}"
               height="{{ post.image_height }}"
               loading="lazy"
               decoding="async" />
        </span>
      {% endfor %}
      {% if not community.recent_posts %}
        <span class="community-card-empty">{{ ftl_get_message("community-no-posts") }}</span>
      {% endif %}
    </span>
    <span class="community-card-body">
      <span class="community-card-name">
        <span class="community-card-title">{{ community.name }}</span>
        {% if community.visibility == "unlisted" %}
          <span class="community-card-badge">{{ ftl_get_message("community-badge-unlisted") }}</span>
        {% elif community.visibility == "private" %}
          <span class="community-card-badge">{{ ftl_get_message("community-badge-private") }}</span>
        {% endif %}
      </span>
      {# The slug is not shown: for three quarters of communities it is a raw
         UUID. #}
      <span class="community-card-owner">@{{ community.owner_login_name }}</span>
      <span class="community-card-stats">
        {{ community.posts_count if community.posts_count else 0 }} {{ ftl_get_message("community-stats-posts") }}
        · {{ community.members_count if community.members_count else 0 }} {{ ftl_get_message("community-stats-contributors") }}
        {# The directory sorts on this by default, so the card shows it. #}
        {% if community.last_post_at %}
          · {{ community.last_post_at|dateformat(format="short", tz="Asia/Seoul") }}
        {% endif %}
      </span>
    </span>
  </a>
{% endmacro %}
