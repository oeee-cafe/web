{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("collaborate-title") }}
{% endblock title %}
{% block head %}
  {# Same page width and column-restore script Home's feeds use, so the
     finished-drawings grid behaves identically here. #}
{% endblock head %}
{# One tier of the community picker. data-search is what the filter box matches
   against, lowercased server-side so the script only has to lowercase the
   query. #}
{% macro community_options(communities, group_label, selected_slug) %}
  {% if communities %}
    <optgroup label="{{ group_label }}">
      {% for community in communities %}
        <option value="{{ community.id }}" data-owner="@{{ community.owner_login_name }}" data-search="{{ (community.name ~ " " ~ community.slug ~ " @" ~ community.owner_login_name ~ " " ~ (community.description or ""))|lower }}" {% if community.slug == selected_slug %}selected{% endif %}>{{ community.name }}{% if community.visibility == "unlisted" %} ({{ ftl_get_message("community-badge-unlisted") }}){% elif community.visibility == "private" %} ({{ ftl_get_message("community-badge-private") }}){% endif %}</option>
      {% endfor %}
    </optgroup>
  {% endif %}
{% endmacro %}
{% block content %}
  {% include "post_feed_head.jinja" %}
  {# A lobby, as an application shows rooms: the title with New session
     beside it, the rooms open now as cards with their canvas on the front,
     then what was drawn together before. Starting a session is a dialog
     rather than a form standing open over the rooms -- it is one choice of
     four fields, made now and then, above a list people come back to. #}
  <div class="center-wide collaborate-lobby">
    <div class="collaborate-header">
      <h1 class="collaborate-title">{{ ftl_get_message("collaborate-title") }}</h1>
      {# Signed-out visitors can browse the rooms and the gallery; only
         starting a session needs an account. #}
      {% if current_user %}
        <button type="button" class="ds-button ds-button-primary" onclick="toggleSessionDialog(true)">{{ ftl_get_message("collaborate-create-session") }}</button>
      {% else %}
        <a class="ds-button ds-button-primary" href="/login?next=/collaborate">{{ ftl_get_message("collaborate-sign-in-to-create") }}</a>
      {% endif %}
    </div>
    {% if current_user %}
      <div id="create-session-dialog" class="ds-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="create-session-title">
        <div class="ds-modal-panel create-session-panel">
          <h2 id="create-session-title" tabindex="-1">{{ ftl_get_message("collaborate-create-session") }}</h2>
          {# Failure messages ride on the form rather than being interpolated
             into the script below: they are translated text, and an attribute
             is the only context minijinja escapes correctly for. A label
             column and a control column, so the eye follows one edge down. #}
          {# Sent by htmx: the server answers with where the new session
             is (HX-Redirect), and a refusal goes to the page's error banner
             (web::htmx). Only a request that got no answer at all is ours to
             say, which the banner cannot. Without script it is an ordinary
             form, redirected there. #}
          <form id="create-session-form"
                class="session-form"
                method="post"
                action="/collaborate"
                hx-post="/collaborate"
                hx-disable="find button[type=submit]"
                data-network-error="{{ ftl_get_message("collaborate-create-network-error") }}"
                hx-on::error="if (!(event.detail.ctx && event.detail.ctx.response)) dsAlert(this.dataset.networkError)">
            <label for="canvas-size">{{ ftl_get_message("collaborate-canvas-size-label") }}</label>
            <div class="field">
              <select id="canvas-size" name="canvas-size" class="ds-select" required>
                {% for size_value, size_label in canvas_sizes %}<option value="{{ size_value }}">{{ size_label }}</option>{% endfor %}
              </select>
            </div>

            <label for="session-title">{{ ftl_get_message("collaborate-session-title-label") }}</label>
            <div class="field">
              <input type="text"
                     class="ds-input"
                     id="session-title"
                     name="title"
                     maxlength="100"
                     placeholder="{{ ftl_get_message("collaborate-session-title-placeholder") }}">
            </div>

            <label for="max-participants">{{ ftl_get_message("collaborate-max-participants-label") }}</label>
            <div class="field">
              <select id="max-participants" name="max_participants" class="ds-select" required>
                {% for seats in participant_choices %}<option value="{{ seats }}" {% if seats == 4 %}selected{% endif %}>{{ seats }} {{ ftl_get_message("collaborate-participants") }}</option>{% endfor %}
              </select>
            </div>

            {% if has_postable_communities %}
              <label for="community-input" id="community-label">{{ ftl_get_message("collaborate-community-label") }}</label>
              <div class="field">
                {# One control, not two. The select stays the form's value holder —
                   so there is no second community_id and a visitor without JS gets
                   the plain select with its tiers intact — and the script builds a
                   type-ahead facade over it. #}
                <div class="combobox" id="community-combobox">
                  <input type="text"
                         id="community-input"
                         class="ds-input combobox-input"
                         role="combobox"
                         aria-expanded="false"
                         aria-controls="community-listbox"
                         aria-autocomplete="list"
                         aria-labelledby="community-label"
                         autocomplete="off"
                         hidden
                         data-no-matches="{{ ftl_get_message("collaborate-community-no-matches") }}"
                         placeholder="{{ ftl_get_message("collaborate-community-search-placeholder") }}">
                  <div id="community-listbox"
                       class="combobox-list"
                       role="listbox"
                       aria-labelledby="community-label"
                       hidden></div>
                </div>
                <select id="session-community" name="community_id" class="ds-select">
                  <option value="">{{ ftl_get_message("collaborate-community-none") }}</option>
                  {{ community_options(member_communities, ftl_get_message("collaborate-community-group-yours"), selected_community_slug) }}
                  {{ community_options(participated_communities, ftl_get_message("collaborate-community-group-participated"), selected_community_slug) }}
                  {{ community_options(other_communities, ftl_get_message("collaborate-community-group-public"), selected_community_slug) }}
                </select>
                <p class="field-help">{{ ftl_get_message("collaborate-community-hint") }}</p>
              </div>
            {% endif %}

            <div class="field field-wide">
              <label class="checkbox-label" for="is-public">
                <input type="checkbox" id="is-public" name="is_public" checked>
                {{ ftl_get_message("collaborate-public-session-label") }}
              </label>
              <p class="field-help">{{ ftl_get_message("collaborate-public-session-description") }}</p>
            </div>

            <div class="field field-wide form-actions session-form-actions">
              <button type="button" class="ds-button" onclick="toggleSessionDialog(false)">{{ ftl_get_message("cancel") }}</button>
              <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("collaborate-create-button") }}</button>
            </div>
          </form>
        </div>
      </div>
    {% endif %}
    {% include "collaborate_sessions_fragment.jinja" %}
    {# Finished collaborative drawings, through the same card template as the
       home grid so they carry the community label and sensitive handling. #}
    {% if feed.posts and feed.posts|length > 0 %}
      <section role="region" aria-labelledby="collab-gallery-heading">
        <div class="feed-header">
          <h2 id="collab-gallery-heading" class="profile-section-label">{{ ftl_get_message("collaborate-finished-drawings") }}</h2>
          {% include "post_feed_controls.jinja" %}
        </div>
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      </section>
    {% endif %}
  </div>
  {# Only ship with the form: getElementById would be null signed out and
     the TypeError would break any later script on the page. #}
  {% if current_user %}
  <script>
    function toggleSessionDialog(open) {
      var dialog = document.getElementById("create-session-dialog");
      dialog.style.display = open ? "flex" : "none";
      // Focus the heading, not the first field: on iOS a focused <select>
      // opens its picker and a focused input raises the keyboard, so
      // New session would arrive with the canvas-size wheel already up.
      if (open) document.getElementById("create-session-title").focus();
    }
    (function () {
      var dialog = document.getElementById("create-session-dialog");
      dialog.addEventListener("click", function (e) {
        if (e.target === dialog) toggleSessionDialog(false);
      });
      document.addEventListener("keydown", function (e) {
        // The community list closes itself on Escape first.
        if (e.key === "Escape" && dialog.style.display !== "none" &&
            document.getElementById("community-listbox") &&
            !document.getElementById("community-listbox").hidden) return;
        if (e.key === "Escape") toggleSessionDialog(false);
      });
      // Arriving from a community's Draw together, the dialog is what was
      // asked for: open it with that community chosen.
      {% if selected_community_slug %}toggleSessionDialog(true);{% endif %}
    })();
  </script>
  <script>
    // A type-ahead facade over the community <select>. The select stays the
    // form's value holder — it is what create-session reads and what a visitor
    // without JS uses — so this only ever mirrors a choice back into it.
    //
    // It replaces a search box that filtered a separate dropdown: two controls
    // for one decision, where typing never got you closer to picking.
    (function () {
      function init() {
        var select = document.getElementById("session-community");
        var input = document.getElementById("community-input");
        var list = document.getElementById("community-listbox");
        // The picker is omitted entirely when the user can post nowhere.
        if (!select || !input || !list) return;

        // Read the tiers out of the select once. Everything below works off
        // this snapshot, so filtering can never lose an option permanently.
        var items = [];
        Array.prototype.forEach.call(select.children, function (child) {
          if (child.tagName === "OPTGROUP") {
            Array.prototype.forEach.call(child.children, function (option) {
              items.push({
                value: option.value,
                label: option.textContent.trim(),
                owner: option.dataset.owner || "",
                group: child.label,
                search: option.dataset.search || "",
              });
            });
          } else if (child.tagName === "OPTION") {
            // "No community" — ungrouped, and offered only on an empty query,
            // since it has no text to match against.
            items.push({
              value: child.value,
              label: child.textContent.trim(),
              group: "",
              search: "",
            });
          }
        });

        var open = false;
        var active = -1;
        var shown = [];

        function labelFor(value) {
          for (var i = 0; i < items.length; i++) {
            if (items[i].value === value) return items[i].label;
          }
          return "";
        }

        function matches(query) {
          if (query === "") return items.slice();
          return items.filter(function (item) {
            // The empty-value row has nothing to match on, so it only shows on
            // an empty query — otherwise it would survive every search.
            return item.search.indexOf(query) !== -1;
          });
        }

        function render(query) {
          shown = matches(query);
          list.textContent = "";
          if (!shown.length) {
            var empty = document.createElement("div");
            empty.className = "combobox-empty";
            empty.textContent = input.dataset.noMatches;
            list.appendChild(empty);
            return;
          }
          var group = null;
          var container = list;
          shown.forEach(function (item, index) {
            if (item.group !== group) {
              group = item.group;
              if (group) {
                container = document.createElement("div");
                container.setAttribute("role", "group");
                container.setAttribute("aria-label", group);
                var heading = document.createElement("div");
                heading.className = "combobox-group-label";
                heading.textContent = group;
                container.appendChild(heading);
                list.appendChild(container);
              } else {
                container = list;
              }
            }
            var option = document.createElement("div");
            option.className = "combobox-option";
            option.id = "community-option-" + index;
            option.setAttribute("role", "option");
            option.setAttribute("aria-selected", item.value === select.value ? "true" : "false");
            option.dataset.value = item.value;
            var name = document.createElement("span");
            name.className = "combobox-option-name";
            name.textContent = item.label;
            option.appendChild(name);
            // The owner handle disambiguates two communities with the same
            // display name, which the label alone cannot.
            if (item.owner) {
              var meta = document.createElement("span");
              meta.className = "combobox-option-meta";
              meta.textContent = item.owner;
              option.appendChild(meta);
            }
            // mousedown, not click: click fires after blur has already closed
            // the list and thrown the row away.
            option.addEventListener("mousedown", function (e) {
              e.preventDefault();
              choose(index);
            });
            container.appendChild(option);
          });
        }

        function setActive(index) {
          var options = list.querySelectorAll(".combobox-option");
          for (var i = 0; i < options.length; i++) {
            options[i].removeAttribute("data-active");
          }
          active = index;
          if (index < 0 || index >= options.length) {
            input.removeAttribute("aria-activedescendant");
            return;
          }
          options[index].setAttribute("data-active", "");
          input.setAttribute("aria-activedescendant", options[index].id);
          // Keep the highlighted row in view when arrowing past the fold.
          var top = options[index].offsetTop;
          var bottom = top + options[index].offsetHeight;
          if (top < list.scrollTop) list.scrollTop = top;
          else if (bottom > list.scrollTop + list.clientHeight) {
            list.scrollTop = bottom - list.clientHeight;
          }
        }

        function openList(query) {
          render(query === undefined ? "" : query);
          list.hidden = false;
          input.setAttribute("aria-expanded", "true");
          open = true;
          // Start on the current selection so Enter without arrowing is a
          // no-op rather than a silent change.
          var index = -1;
          for (var i = 0; i < shown.length; i++) {
            if (shown[i].value === select.value) index = i;
          }
          setActive(index);
        }

        function closeList() {
          list.hidden = true;
          input.setAttribute("aria-expanded", "false");
          input.removeAttribute("aria-activedescendant");
          open = false;
          active = -1;
        }

        function choose(index) {
          if (index < 0 || index >= shown.length) return;
          select.value = shown[index].value;
          input.value = shown[index].label;
          closeList();
        }

        // Show the select's initial choice, which may be preselected by
        // ?community=<slug>.
        input.value = labelFor(select.value);
        input.hidden = false;
        select.hidden = true;

        input.addEventListener("focus", function () {
          input.select();
          openList("");
        });
        input.addEventListener("input", function () {
          openList(input.value.toLowerCase().trim());
        });
        input.addEventListener("blur", function () {
          // Whatever half-typed query is in the box is not a choice; put the
          // real one back so the field never lies about what will be posted.
          input.value = labelFor(select.value);
          closeList();
        });
        input.addEventListener("keydown", function (e) {
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            if (!open) return openList(input.value.toLowerCase().trim());
            var next = active + (e.key === "ArrowDown" ? 1 : -1);
            if (next < 0) next = shown.length - 1;
            if (next >= shown.length) next = 0;
            setActive(next);
          } else if (e.key === "Enter") {
            // Always swallowed: with the list open Enter picks a row, and with
            // it closed Enter here would submit a form the user is still
            // filling in.
            e.preventDefault();
            if (open) choose(active);
          } else if (e.key === "Escape") {
            if (open) {
              e.preventDefault();
              input.value = labelFor(select.value);
              closeList();
            }
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
  {% endif %}
{% endblock content %}
