{% extends "base.jinja" %}
{% block title %}{{ super() }} | {{ ftl_get_message("profile-draw-banner") }}{% endblock title %}
{% block content %}
  <div class="center"><h2>{{ ftl_get_message("profile-draw-banner") }}</h2></div>
  <link rel="stylesheet"
        href="{{ '/static/neo-cucumber/offline.css' | cachebuster | safe }}" />
  {# The painter takes the screen below the toolbar. It only fills what it is
     given, so the page has to say that it wants the screen; it stops at the
     toolbar because that is the window's title bar on every page, the
     painter's included. #}
  <style>
    /* The ground behind the painter is the window's: the system grey and
       its grid, the same surface as the toolbar above, in either theme.
       NEO's own lavender ground belongs to a page that is nothing but the
       painter. Three :roots outrank every theme selector in the painter's
       sheet, which uses two. */
    :root:root:root {
      --neo-bk: var(--ground-color);
      --neo-bk2: var(--ground-grid-solid);
    }
    #neo-cucumber-root {
      position: fixed;
      top: 53px; left: 0; right: 0; bottom: 0;
      height: calc(100dvh - 53px);
      z-index: 50;
    }
  </style>
  <div id="neo-cucumber-root"></div>
  <div class="center">
    <button id="oeee-painter-save" type="button" disabled
            data-confirm="{{ ftl_get_message("draw-save-confirm") }}"
            data-cancel="{{ ftl_get_message("cancel") }}">{{ ftl_get_message("save") }}</button>
  </div>
  <script id="neo-cucumber-config" type="application/json">{{ painter_config | safe }}</script>
  <script type="module"
          src="{{ '/static/neo-cucumber/offline.js' | cachebuster | safe }}"></script>
{% endblock content %}
