{% from "person_macro.jinja" import handle %}
{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("post-reactions") }} | {{ post_title }}
{% endblock title %}
{% block content %}
  {# Who reacted to a drawing, grouped by what they reacted with: each emoji
     a list of people, as the members page lists them. #}
  <div class="settings-page reactions-page">
    <div class="members-header">
      <div>
        <a class="profile-chip" href="/@{{ login_name }}/{{ post_id }}">← {{ post_title }}</a>
        <h1 class="settings-title">{{ ftl_get_message("post-reactions") }}</h1>
      </div>
    </div>
    {% if grouped_reactions %}
      {% for group in grouped_reactions %}
        <section class="settings-group">
          <div class="profile-section-label reaction-group-label"><span class="reaction-group-emoji">{{ group.emoji }}</span> {{ group.reactions|length }}</div>
          <div class="member-list">
            {% for reaction in group.reactions %}
              <div class="member-row">
                <span class="member-text">
                  {% if reaction.is_local %}
                    <a class="member-name" href="{{ reaction.actor_url }}">{{ reaction.actor_name }}</a>
                  {% else %}
                    <a class="member-name" href="{{ reaction.actor_url }}" target="_blank" rel="noopener noreferrer">{{ reaction.actor_name }}<span class="profile-chip-out" aria-hidden="true">↗</span></a>
                  {% endif %}
                  <span class="member-meta">{{ handle(reaction.actor_login_name if reaction.is_local else none, reaction.actor_handle) }} · {{ reaction.created_at|ago }}</span>
                </span>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    {% else %}
      <div class="ds-card notifications-empty"><p>{{ ftl_get_message("post-no-reactions") }}</p></div>
    {% endif %}
  </div>
{% endblock content %}
