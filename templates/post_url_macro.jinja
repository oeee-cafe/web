{# A post's permalink. Its author names the page whatever community the post
   was posted to — see `post_page_path` in src/models/post.rs, which is where
   that is decided and which every other handle redirects to. #}
{% macro post_url(post, post_id="") %}
{%- set author = post.login_name or post.user_login_name or post.author_login_name -%}
/@{{ author }}/{{ post_id or post.id }}
{%- endmacro %}
