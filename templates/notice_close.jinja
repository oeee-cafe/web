{# The button that puts a notice away (ds.css, "Notices"): the notice goes,
   and a list left with nothing in it is emptied outright, so `:empty` takes
   the list away too (frontend/site/actions.ts, "dismiss-notice"). Not htmx's,
   so it closes where htmx does not run (Firefox 56).
   web::htmx::error_banner writes the same markup by hand. #}
<button class="ds-notice-close"
        type="button"
        data-action="dismiss-notice"
        aria-label="{{ ftl_get_message('close') }}"
        title="{{ ftl_get_message('close') }}">
  <svg viewBox="0 0 12 12" aria-hidden="true">
    <path d="M2.5 2.5l7 7m0-7l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</button>
