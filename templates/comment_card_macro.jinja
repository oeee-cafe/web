{% from "person_macro.jinja" import handle %}
{# A comment in a list of them: the drawing it is on, framed, then who said
   it and when, what they said, and the drawing's title. The whole row goes
   to the drawing, through one stretched link, so links inside what was said
   still work.

   On a profile every row is by the same person, so `by_drawing` heads each
   row with the drawing's title instead, and names whose drawing it is where
   the commenter's handle would be.

   Someone from this site is named by their login name alone (@miro); only
   a commenter from elsewhere needs the domain to be told apart. #}
{% macro comment_card(comment, r2_public_endpoint_url, ftl_get_message, by_drawing=false) %}
  <div class="comment-row">
    {% if comment.post_image_filename %}
      <span class="notification-figure">
        <span class="notification-thumbnail">
          <img class="notification-post-image"
               src="{{ r2_public_endpoint_url }}/image/{{ comment.post_image_filename[:2] }}/{{ comment.post_image_filename }}"
               alt=""
               width="{{ comment.post_image_width }}"
               height="{{ comment.post_image_height }}"
               loading="lazy"
               decoding="async">
        </span>
      </span>
    {% endif %}
    <div class="comment-row-body">
      <div class="comment-row-head">
        <a class="comment-row-link" href="/@{{ comment.post_author_login_name }}/{{ comment.post_id }}">
          {%- if by_drawing %}{{ comment.post_title or ftl_get_message("post-no-title") }}{% else %}{{ comment.actor_name }}{% endif -%}
        </a>
        <span class="comment-row-meta"><span class="comment-row-handle">{% if by_drawing %}{{ handle(comment.post_author_login_name) }}{% else %}{{ handle(comment.handle) }}{% endif %} · </span><span title="{{ comment.created_at|datetimeformat(format="short", tz="Asia/Seoul") }}">{{ comment.created_at|ago }}</span></span>
      </div>
      <div class="comment-row-content ds-selectable">
        {% if comment.content_html %}
          {{ comment.content_html|safe }}
        {% else %}
          {{ comment.content|markdown|safe }}
        {% endif %}
      </div>
      {% if not by_drawing %}
        <div class="comment-row-post">→ {{ comment.post_title or ftl_get_message("post-no-title") }}</div>
      {% endif %}
    </div>
  </div>
{% endmacro %}
