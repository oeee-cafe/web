{# The raised choice in a segmented control -- every .ds-segmented, and the
   toolbar's sections, which are one -- slides to the next rather than
   jumping. It is a thumb the group draws behind its items (ds.css), put
   under whichever item is chosen: aria-current="page" for a group of
   links, aria-pressed="true" for a group of buttons, or .is-selected.

   It moves when the choice does, whoever changes it: a page's own script
   pressing a tab, the toolbar marking the section being gone to
   (oeeeMarkCurrent), or a press here on a link in a page's pill, which is
   marked chosen at once and switched to in place (below) -- the toolbar
   keeps the pill on screen over the page's skeleton meanwhile (loading,
   toolbar.jinja). Anything else that moves the items -- a page
   arriving, a font loading, the window resizing, a menu opening on a group
   that was hidden -- puts it in place without sliding.

   The boost swaps the body and runs this again, which places the new
   page's groups; the document's listeners are added once. #}
<script>
  (function () {
    var GROUPS = ".ds-segmented, .toolbar-sections";

    function isGroup(node) {
      return !!node && node.nodeType === 1 && node.matches && node.matches(GROUPS);
    }

    function chosen(group) {
      for (var i = 0; i < group.children.length; i++) {
        var item = group.children[i];
        if (item.getAttribute("aria-current") === "page" ||
            item.getAttribute("aria-pressed") === "true" ||
            item.classList.contains("is-selected")) return item;
      }
      return null;
    }

    function place(group, moving) {
      var item = chosen(group);
      // Nothing chosen, or not laid out (a closed menu): the item's own
      // raised look stands in until it can be measured.
      if (!item || !item.offsetWidth) {
        group.classList.remove("has-thumb", "thumb-moves");
        return;
      }
      if (moving && group.classList.contains("has-thumb")) {
        // Where the thumb is now, settled before it is told where to go,
        // or a group just moved in the document would have no start.
        void group.offsetWidth;
        group.classList.add("thumb-moves");
      } else {
        group.classList.remove("thumb-moves");
      }
      // Marked before it is measured: the choice is drawn at its
      // neighbours' weight once the thumb is under it (ds.css), and the
      // thumb is to fit that.
      group.classList.add("has-thumb");
      group.style.setProperty("--thumb-x", item.offsetLeft + "px");
      group.style.setProperty("--thumb-y", item.offsetTop + "px");
      group.style.setProperty("--thumb-w", item.offsetWidth + "px");
      group.style.setProperty("--thumb-h", item.offsetHeight + "px");
    }

    function settle() {
      var groups = document.querySelectorAll(GROUPS);
      for (var i = 0; i < groups.length; i++) place(groups[i], false);
    }
    window.oeeeSettleThumbs = settle;
    settle();

    if (window.oeeeThumbsListening) return;
    window.oeeeThumbsListening = true;

    if (window.MutationObserver) {
      new MutationObserver(function (records) {
        var moved = [];
        for (var i = 0; i < records.length; i++) {
          var group = records[i].target.parentNode;
          if (isGroup(group) && moved.indexOf(group) < 0) moved.push(group);
        }
        for (var j = 0; j < moved.length; j++) place(moved[j], true);
      }).observe(document.documentElement, {
        subtree: true,
        attributes: true,
        attributeFilter: ["aria-current", "aria-pressed"]
      });
    }

    // A link in a page's pill -- one of Home's feeds, an order of the
    // hashtags, one of the documents -- is another view of the same page,
    // so it is switched to in place rather than loaded as a page: the pill
    // is chosen at once and its thumb slides, the content area alone is
    // fetched and replaced under it, and the pill carries over into the new
    // content as it is, mid-slide. The address still changes, pushed as an
    // htmx entry so going back and forward is htmx's own restore, like any
    // boosted page.
    //
    // Fetched early: at the pointer's hover or press, which is most of the
    // round trip before the click lands, and kept for a minute, so going
    // back and forth between two is instant. A pill link pressed before
    // the page has come shows the page's skeleton meanwhile (loading, in
    // toolbar.jinja, which has already laid it by the time this runs).
    //
    // Anything that goes wrong -- no htmx (an engine too old for it), an
    // error, a redirect elsewhere, say to sign in -- is an ordinary trip
    // to the page instead.
    var FRESH = 60000;
    var fetched = {};
    var canSwap = !!(window.fetch && window.DOMParser && window.history && history.pushState);

    function pillLink(target) {
      var link = target && target.closest ? target.closest("a[href]") : null;
      if (!link || link.target || link.origin !== location.origin) return null;
      var group = link.parentNode;
      if (!isGroup(group) || !link.closest("main")) return null;
      return link;
    }

    function fetchPage(href) {
      var entry = fetched[href];
      if (entry && Date.now() - entry.at < FRESH) return entry.page;
      var page = fetch(href, { credentials: "same-origin" }).then(function (response) {
        if (!response.ok || response.redirected) throw new Error("not the page");
        return response.text();
      });
      fetched[href] = { at: Date.now(), page: page };
      page.catch(function () {
        if (fetched[href] && fetched[href].page === page) delete fetched[href];
      });
      return page;
    }

    function prefetch(event) {
      if (!canSwap || !window.htmx) return;
      var link = pillLink(event.target);
      if (link && link.getAttribute("aria-current") !== "page") fetchPage(link.href);
    }
    document.addEventListener("mouseover", prefetch);
    document.addEventListener("mousedown", prefetch);
    document.addEventListener("touchstart", prefetch, { passive: true });

    // The new page's own scripts, run as the page would have run them.
    function runScripts(container) {
      var scripts = container.querySelectorAll("script");
      for (var i = 0; i < scripts.length; i++) {
        var old = scripts[i];
        var fresh = document.createElement("script");
        for (var a = 0; a < old.attributes.length; a++) fresh.setAttribute(old.attributes[a].name, old.attributes[a].value);
        fresh.text = old.text;
        old.parentNode.replaceChild(fresh, old);
      }
    }

    function switchTo(link, group, href) {
      var content = document.querySelector("main.ds-content");
      var groups = content ? content.querySelectorAll(".ds-segmented") : [];
      var index = Array.prototype.indexOf.call(groups, group);
      fetchPage(href).then(function (text) {
        // Somewhere else by now: this is not the page being looked at.
        if (!content.isConnected || !group.isConnected) return;
        var next = new DOMParser().parseFromString(text, "text/html");
        var incoming = next.querySelector("main.ds-content");
        if (!incoming) throw new Error("not a page");
        var nodes = document.createDocumentFragment();
        while (incoming.firstChild) nodes.appendChild(document.adoptNode(incoming.firstChild));
        // The pill that is here, mid-slide, in the place of the new page's.
        var theirs = nodes.querySelectorAll(".ds-segmented")[index];
        if (theirs) theirs.parentNode.replaceChild(group, theirs);
        while (content.firstChild) content.removeChild(content.firstChild);
        content.appendChild(nodes);
        runScripts(content);
        if (window.htmx && htmx.process) htmx.process(content);
        if (next.title) document.title = next.title;
        history.pushState({ htmx: true }, "", href);
        if (window.oeeeMarkCurrent) window.oeeeMarkCurrent(location.pathname);
        content.scrollTop = 0;
        window.scrollTo(0, 0);
        settle();
      }).catch(function () {
        location.href = href;
      });
    }

    // Chosen now, so the thumb slides while the page comes. After the
    // toolbar's own click handler, which lays the skeleton and moves the
    // pill into it.
    document.addEventListener("click", function (event) {
      if (event.button !== 0 || event.defaultPrevented) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      var link = event.target && event.target.closest ? event.target.closest("a[href]") : null;
      if (!link || link.target || link.origin !== location.origin) return;
      var group = link.parentNode;
      // The toolbar's sections are marked by the toolbar (oeeeMarkCurrent).
      if (!isGroup(group) || link.closest("#menubar")) return;
      if (link.getAttribute("aria-current") === "page") return;
      var was = chosen(group);
      group.oeeeWas = was;
      if (was) was.removeAttribute("aria-current");
      link.setAttribute("aria-current", "page");
      if (canSwap && window.htmx && link.closest("main")) {
        event.preventDefault();
        delete group.oeeeWas;
        switchTo(link, group, link.href);
      }
    });

    // Back to a page kept in memory: the choice is the one it was left with.
    window.addEventListener("pageshow", function (event) {
      if (!event.persisted) return;
      var groups = document.querySelectorAll(GROUPS);
      for (var i = 0; i < groups.length; i++) {
        var group = groups[i];
        if (!("oeeeWas" in group)) continue;
        var now = chosen(group);
        if (now && now !== group.oeeeWas) now.removeAttribute("aria-current");
        if (group.oeeeWas) group.oeeeWas.setAttribute("aria-current", "page");
        delete group.oeeeWas;
      }
      settle();
    });

    window.addEventListener("resize", settle);
    window.addEventListener("load", settle);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(settle);
    // A group inside a menu is measured when the menu opens.
    document.addEventListener("toggle", settle, true);
    document.addEventListener("htmx:after:settle", settle);
  })();
</script>
