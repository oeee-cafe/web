{% from "follow_macro.jinja" import follow_button, unfollow_button %} {% extends "base.jinja" %}
{% from "achievement_icon_macro.jinja" import achievement_icon %}
{% from "supporter_badge_macro.jinja" import supporter_mark, supporter_mark_name %}
{% from "per_row_macro.jinja" import per_row %}
{% block title %}
  {{ super() }} | {{ user.display_name }} (@{{ user.login_name }})
{% endblock title %}
{% block social_meta %}
  <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
  <meta property="og:type" content="profile" />
  <meta property="og:title"
        content="{{ user.display_name }} (@{{ user.login_name }})" />
  <meta property="og:description"
        content="{{ user.display_name }} @{{ user.login_name }}@{{ domain }}" />
  <meta property="og:url" content="{{ base_url|safe }}/@{{ user.login_name }}" />
  {# The banner is the one image that belongs to a profile; fall back to the
     site mark when the user has not drawn one. #}
  {% if banner %}
    <meta property="og:image"
          content="{{ r2_public_endpoint_url|safe }}/image/{{ banner.image_filename[:2] }}/{{ banner.image_filename }}" />
    <meta property="og:image:width" content="{{ banner.width }}" />
    <meta property="og:image:height" content="{{ banner.height }}" />
  {% else %}
    <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
  {% endif %}
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:site" content="@oeee_cafe" />
{% endblock social_meta %}
{% block head %}
  <link rel="alternate"
        type="application/activity+json"
        href="https://{{ domain }}/ap/users/{{ user.id }}" />
{% endblock head %}
{% block content %}
  {# A profile in three parts. First one card: their banner at twice its
     size, their name, their links, what they have earned, and what you can
     do about them. Then the people they follow. Then one switch and what it
     chooses -- their drawings, or what they have said. #}
  {% include "post_feed_head.jinja" %}
  {% set is_owner = current_user and user.id == current_user.id %}
  <div class="profile">
    <section class="profile-card profile-person ds-card">
      <div class="profile-head">
        {% if banner %}
          {# On your own profile the banner leads to redrawing it. #}
          {% if is_owner %}<a class="profile-banner" href="/banners/draw" title="{{ ftl_get_message('profile-draw-banner') }}">{% else %}<span class="profile-banner">{% endif %}
            <img width="{{ banner.width }}"
                 height="{{ banner.height }}"
                 alt=""
                 src="{{ r2_public_endpoint_url }}/image/{{ banner.image_filename[:2] }}/{{ banner.image_filename }}" />
          {% if is_owner %}</a>{% else %}</span>{% endif %}
        {% elif is_owner %}
          {# Where the banner will go, holding its place until there is one. #}
          <a class="profile-banner profile-banner-blank" href="/banners/draw">{{ ftl_get_message("profile-draw-banner") }}</a>
        {% endif %}
        <div class="profile-identity">
          <h1 class="profile-name">{{ user.display_name }}</h1>
          <div class="profile-handle">@{{ user.login_name }}@{{ domain }}</div>
          {# The month they joined, in Seoul time like every other date on
             the site. Year and month go to the locale as numbers, so each
             language words and orders them itself. #}
          {% set joined_tz = "Asia/Seoul" %}
          <div class="profile-joined">
            <time datetime="{{ user.created_at|dateformat(format='[year]-[month]', tz=joined_tz) }}">
              {{- ftl_format_pattern("profile-member-since", {
                    "year": user.created_at|dateformat(format="[year]", tz=joined_tz)|int,
                    "month": user.created_at|dateformat(format="[month padding:none]", tz=joined_tz)|int,
                  }) -}}
            </time>
          </div>
          {% if supporter_standings or links %}
            <div class="profile-chips">
              {% for standing in supporter_standings %}
                {# First, and on the accent: the chips that are a thank-you. One
                   for every year they have supported, earliest first, on the
                   platform that year's pack was bought on. A year that has
                   passed stays here -- the mark beside their name is this
                   year's, this is what they gave. #}
                <a class="profile-chip supporter-chip"
                   href="/about#supporters"
                   aria-label="{{ ftl_format_pattern('supporter-year', {'platform': supporter_mark_name(standing.store), 'year': standing.year}) }}"
                   title="{{ supporter_mark_name(standing.store) }}">{{ supporter_mark(standing.store) }}{{ standing.year }}</a>
              {% endfor %}
              {% for link, target in links %}
                <a class="profile-chip" href="{{ link.url }}" target="{{ target }}" rel="noopener">{{ link.description }}<span class="profile-chip-out" aria-hidden="true">↗</span></a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {# What you can do about them. The guestbook is for anyone; reporting
           is rare, so it waits behind the menu rather than sitting beside
           Follow at the same weight. #}
        <div class="profile-actions">
          {% if current_user and not is_owner %}
            {% if is_following %}{{ unfollow_button() }}{% else %}{{ follow_button() }}{% endif %}
          {% endif %}
          <a href="/@{{ user.login_name }}/guestbook" class="ds-button">{{ ftl_get_message("profile-guestbook") }}</a>
          {% if is_owner %}
            <a href="/@{{ user.login_name }}/settings" class="ds-button">{{ ftl_get_message("profile-manage") }}</a>
          {% elif current_user %}
            {# A .toolbar-menu, so the toolbar's script closes it on a click
               elsewhere and on Escape. #}
            <details class="toolbar-menu profile-more">
              <summary aria-label="{{ ftl_get_message('profile-more') }}" title="{{ ftl_get_message('profile-more') }}">
                <span class="ds-button profile-more-button" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M6 14q-.825 0-1.412-.587T4 12t.588-1.412T6 10t1.413.588T8 12t-.587 1.413T6 14m6 0q-.825 0-1.412-.587T10 12t.588-1.412T12 10t1.413.588T14 12t-.587 1.413T12 14m6 0q-.825 0-1.412-.587T16 12t.588-1.412T18 10t1.413.588T20 12t-.587 1.413T18 14"/></svg></span>
              </summary>
              <div class="toolbar-menu-items">
                <button type="button" class="profile-more-item" onclick="this.closest('details').removeAttribute('open'); showProfileReportModal()">{{ ftl_get_message("profile-report") }}</button>
              </div>
            </details>
          {% endif %}
        </div>
      </div>

      {% if achievements %}
        {# What they have done here: a first drawing, a first relay, a first
           collaboration, buying the Steam app. The same achievements as on
           Steam, earned on the site whatever they drew in. A badge each,
           along the foot of the card; what it was for and when is its
           tooltip. #}
        <ul class="profile-achievements" aria-label="{{ ftl_get_message('profile-achievements') }}">
          <li class="profile-achievements-label" aria-hidden="true">{{ ftl_get_message("profile-achievements") }}</li>
          {% for earned in achievements %}
            <li class="profile-achievement"
                title="{{ ftl_get_message('achievement-' ~ earned.key ~ '-description') }} · {{ earned.earned_at|dateformat(format='short', tz='Asia/Seoul') }}">
              {{ achievement_icon(earned.key) }}
              <span class="profile-achievement-name">{{ ftl_get_message("achievement-" ~ earned.key) }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    {% if followings %}
      {# Everyone they follow, under the card and over the drawings, all
         the same shape: their banner framed in hard pixels, or where they
         have none, a frame of the same size with their name in it -- one
         list, not banners and then chips. #}
      <section class="profile-section">
        <div class="profile-section-label">{{ ftl_get_message("profile-following") }}<span class="profile-tab-count">{{ followings|length }}</span></div>
      <ul class="profile-follows">
        {% for following in followings %}
          <li>
            <a class="profile-follow" href="/@{{ following.login_name }}">
              {% if following.banner_image_filename %}
                <img class="profile-follow-banner"
                     width="200"
                     height="40"
                     alt=""
                     loading="lazy"
                     decoding="async"
                     src="{{ r2_public_endpoint_url }}/image/{{ following.banner_image_filename[:2] }}/{{ following.banner_image_filename }}" />
              {% else %}
                <span class="profile-follow-banner profile-follow-blank" aria-hidden="true">{{ following.display_name }}</span>
              {% endif %}
              <span class="profile-follow-text">
                <span class="profile-follow-name">{{ following.display_name }}</span>
                <span class="profile-follow-handle">@{{ following.login_name }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
      </section>
    {% endif %}

    <section class="profile-section">
      {# One switch, one grid. Everyone sees their drawings and, when there
         are any, what they have said; on their own profile the drawings are
         split in two -- what everyone sees, and what only they do. With
         nothing to switch between, the one grid is simply named.

         Each tab is a link to its own address -- /@name, /@name/comments,
         /@name/private -- and `tab` is the one the address asked for, so a
         tab can be shared, reloaded and gone back to. A plain click is
         taken here and switches in place, pushing the address as it goes. #}
      {% set tab = tab or "public" %}
      {% set tab_count = 1 + (1 if is_owner else 0) + (1 if comment_count else 0) %}
      <div class="grid-header">
        {% if tab_count > 1 %}
          <div class="profile-tabs-bar">
            <nav class="ds-segmented profile-tabs" aria-label="{{ ftl_get_message('profile-tabs-label') }}">
              <a href="/@{{ user.login_name }}" data-profile-tab="public"{% if tab == "public" %} aria-current="page"{% endif %}>{{ ftl_get_message("profile-tab-public" if is_owner else "profile-tab-drawings") }}<span class="profile-tab-count">{{ public_count }}</span></a>
              {% if is_owner %}
                <a href="/@{{ user.login_name }}/private" data-profile-tab="private"{% if tab == "private" %} aria-current="page"{% endif %}>{{ ftl_get_message("profile-tab-private") }}<span class="profile-tab-count">{{ private_count }}</span></a>
              {% endif %}
              {% if comment_count %}
                <a href="/@{{ user.login_name }}/comments" data-profile-tab="comments"{% if tab == "comments" %} aria-current="page"{% endif %}>{{ ftl_get_message("profile-tab-comments") }}<span class="profile-tab-count">{{ comment_count }}</span></a>
              {% endif %}
            </nav>
            {% if is_owner %}
              {# Beside the switch, and only while it is on the private
                 drawings: what that tab means, where it is chosen. #}
              <p class="profile-panel-note" data-profile-note="private"{% if tab != "private" %} hidden{% endif %}>{{ ftl_get_message("profile-private-community-posts-note") }}</p>
            {% endif %}
          </div>
        {% else %}
          <div class="profile-section-label">{{ ftl_get_message("profile-tab-drawings") }}</div>
        {% endif %}
        {% if public_count or is_owner %}<div data-profile-per-row{% if tab == "comments" %} hidden{% endif %}>{{ per_row() }}</div>{% endif %}
      </div>
      {# Their drawings in the feeds' own grid and cards: the same
         sensitive blur, captions and Per row, headed by month, and loading
         on as it is scrolled -- a tab's sentinel sits harmlessly in its
         panel while the panel is hidden, as the comments' does. The cards
         leave out whose drawing each is: every one here is theirs. #}
      <div class="profile-drawings" data-profile-panel="public"{% if tab != "public" %} hidden{% endif %}>
        {% if public_feed.posts %}
          <div class="posts-grid">
            {% with feed = public_feed %}{% include "post_feed_fragment.jinja" %}{% endwith %}
          </div>
        {% else %}
          <p class="profile-empty">{{ ftl_get_message("profile-public-community-posts-nil") }}</p>
        {% endif %}
      </div>
      {% if is_owner %}
        <div class="profile-drawings" data-profile-panel="private"{% if tab != "private" %} hidden{% endif %}>
          {% if private_feed.posts %}
            <div class="posts-grid">
              {% with feed = private_feed %}{% include "post_feed_fragment.jinja" %}{% endwith %}
            </div>
          {% else %}
            <p class="profile-empty">{{ ftl_get_message("profile-private-community-posts-nil") }}</p>
          {% endif %}
        </div>
      {% endif %}
      {% if comment_count %}
        {# What they have said: a card each, the drawing, what was said,
           and the card the way to it, in as many columns as the width
           holds -- comments are short, and one to a row across a wide
           screen was mostly empty. Only on drawings this profile would
           show anyone. The rest arrive as the grid is scrolled; the
           sentinel sits in the hidden panel harmlessly, since htmx watches
           it with an IntersectionObserver and nothing hidden intersects. #}
        <div data-profile-panel="comments"{% if tab != "comments" %} hidden{% endif %}>
          <div class="comment-grid">
            {% include "comments_fragment.jinja" %}
          </div>
        </div>
      {% endif %}
      {% if tab_count > 1 %}
        <script>
          (function () {
            // Found at the time rather than kept: a boosted visit to
            // another profile swaps the body, and the listeners below
            // outlive it.
            function select(chosen) {
              var tabs = document.querySelectorAll("[data-profile-tab]");
              for (var j = 0; j < tabs.length; j++) {
                if (tabs[j].getAttribute("data-profile-tab") === chosen) {
                  tabs[j].setAttribute("aria-current", "page");
                } else {
                  tabs[j].removeAttribute("aria-current");
                }
              }
              var panels = document.querySelectorAll("[data-profile-panel]");
              for (var k = 0; k < panels.length; k++) {
                panels[k].hidden = panels[k].getAttribute("data-profile-panel") !== chosen;
              }
              var notes = document.querySelectorAll("[data-profile-note]");
              for (var n = 0; n < notes.length; n++) {
                notes[n].hidden = notes[n].getAttribute("data-profile-note") !== chosen;
              }
              // How many a row is a question about drawings only.
              var perRow = document.querySelector("[data-profile-per-row]");
              if (perRow) perRow.hidden = chosen === "comments";
            }

            var tabs = document.querySelectorAll("[data-profile-tab]");
            for (var i = 0; i < tabs.length; i++) {
              tabs[i].addEventListener("click", function (event) {
                // A new tab or window, or a copied link, is the link's.
                if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                event.preventDefault();
                if (this.getAttribute("aria-current") === "page") return;
                select(this.getAttribute("data-profile-tab"));
                history.pushState({ profileTab: true }, "", this.href);
              });
            }

            // Back and forward between tabs. htmx restores only the entries
            // it pushed, so these are left to here; the one the page was
            // loaded at is htmx's, and it fetches that address afresh.
            if (!window.oeeeProfileTabsPopstate) {
              window.oeeeProfileTabsPopstate = true;
              window.addEventListener("popstate", function () {
                var tabs = document.querySelectorAll("[data-profile-tab]");
                for (var i = 0; i < tabs.length; i++) {
                  if (tabs[i].pathname === location.pathname) {
                    select(tabs[i].getAttribute("data-profile-tab"));
                    return;
                  }
                }
              });
            }
          })();
        </script>
      {% endif %}
    </section>

{# Profile Report Modal #}
{% if current_user and user.id != current_user.id %}
  <div id="profile-report-modal" class="ds-modal" style="display: none;">
    <div class="ds-modal-panel">
      <h2>{{ ftl_get_message("profile-report-title") }}</h2>
      {# `required` on the textarea is the empty-description check: htmx runs
         HTML5 validation before it will issue a request for a form. The login
         name is interpolated here rather than carried in a JS variable, so the
         modal no longer has any state of its own to reset. #}
      <form id="profile-report-form"
            hx-post="/@{{ user.login_name }}/report"
            hx-target="this"
            hx-swap="outerHTML"
            hx-disable="find button">
        <label class="ds-label" for="profile-report-description">{{ ftl_get_message("profile-report-description-label") }}</label>
        <textarea id="profile-report-description"
                  class="ds-textarea"
                  name="description"
                  required
                  rows="5"
                  style="width: 100%"
                  placeholder="{{ ftl_get_message('profile-report-description-placeholder') }}"></textarea>
        <div class="ds-actions" style="justify-content: flex-end">
          <button type="button" class="ds-button" onclick="hideProfileReportModal()">{{ ftl_get_message("cancel") }}</button>
          <button type="submit" class="ds-button ds-button-danger">{{ ftl_get_message("profile-report-submit") }}</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function showProfileReportModal() {
      const modal = document.getElementById('profile-report-modal');
      modal.style.display = 'flex';
      document.getElementById('profile-report-description').value = '';
      document.getElementById('profile-report-description').focus();
    }

    function hideProfileReportModal() {
      document.getElementById('profile-report-modal').style.display = 'none';
    }

    // Close modal when clicking outside
    document.getElementById('profile-report-modal').addEventListener('click', function(e) {
      if (e.target === this) {
        hideProfileReportModal();
      }
    });
  </script>
{% endif %}
</div>
{% endblock content %}
