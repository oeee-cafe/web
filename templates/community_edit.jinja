{# Editing a community, in place of its header card and in the same card.

   Everything is inside the one section, and the section is what Cancel and
   Save swap back out (:inherited, because htmx 4 does not pass attributes
   down to children on its own). The delete area used to be a sibling of the
   form, so cancelling put the header back and left it standing underneath.
   Delete keeps its own target: it replaces the whole page. #}
<section class="ds-card community-edit"
         hx-target:inherited="this"
         hx-swap:inherited="outerHTML">
  <form class="community-edit-form"
        hx-put="/communities/{{ community_id }}"
        hx-disable="find button">
    {% if error_message %}
      <p class="community-edit-error" role="alert">{{ error_message }}</p>
    {% endif %}
    <div class="form-field">
      <label class="ds-label" for="community-edit-name">{{ ftl_get_message("community-name") }}</label>
      <input class="ds-input" type="text" id="community-edit-name" name="name" value="{{ community.name }}" required />
    </div>
    <div class="form-field">
      <label class="ds-label" for="community-edit-slug">ID</label>
      <input class="ds-input" type="text" id="community-edit-slug" name="slug" value="{{ community.slug }}" required
             autocomplete="off" autocapitalize="off" spellcheck="false" />
      <span class="ds-help">/communities/@{{ community.slug }}</span>
    </div>
    <div class="form-field">
      <label class="ds-label" for="community-edit-description">{{ ftl_get_message("community-description") }}</label>
      <textarea class="ds-textarea" id="community-edit-description" name="description" rows="3">{{ community.description }}</textarea>
    </div>
    <div class="form-field" role="radiogroup" aria-labelledby="community-edit-visibility">
      <span class="ds-label" id="community-edit-visibility">{{ ftl_get_message("community-visibility") }}</span>
      {% if community.visibility == "private" %}
        {# Private is for good: its members joined on that understanding. #}
        <input type="hidden" name="visibility" value="private" />
        <div class="community-edit-choices">
          <label class="community-edit-choice is-fixed">
            <input type="radio" checked disabled />
            <span>
              <span class="community-edit-choice-name">{{ ftl_get_message("visibility-private") }}</span>
              <span class="ds-help">{{ ftl_get_message("visibility-cannot-change") }}</span>
            </span>
          </label>
        </div>
      {% else %}
        <div class="community-edit-choices">
          {% for value in ["public", "unlisted"] %}
            <label class="community-edit-choice">
              <input type="radio" name="visibility" value="{{ value }}" {% if community.visibility == value %}checked{% endif %} />
              <span>
                <span class="community-edit-choice-name">{{ ftl_get_message("visibility-" ~ value) }}</span>
                <span class="ds-help">{{ ftl_get_message("visibility-" ~ value ~ "-description") }}</span>
              </span>
            </label>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="form-actions community-edit-actions">
      <button type="button" class="ds-button" hx-get="/communities/{{ community_id }}">{{ ftl_get_message("cancel") }}</button>
      <button type="submit" class="ds-button ds-button-primary">{{ ftl_get_message("save") }}</button>
    </div>
  </form>

  {# Deleting is set apart and asks for the ID typed out, so it is never
     one slip from Save. #}
  <div class="community-edit-danger">
    <div class="community-edit-danger-title">{{ ftl_get_message("community-delete-danger-zone") }}</div>
    <p class="ds-help">{{ ftl_get_message("community-delete-warning") }}</p>
    <label class="ds-label" for="confirm-slug">
      {{ ftl_get_message("community-delete-confirm-prompt") }}: <code>{{ community.slug }}</code>
    </label>
    <div class="community-edit-danger-row">
      <input class="ds-input"
             type="text"
             id="confirm-slug"
             autocomplete="off"
             autocapitalize="off"
             spellcheck="false"
             data-slug="{{ community.slug }}"
             oninput="document.getElementById('delete-community-btn').disabled = this.value !== this.getAttribute('data-slug')" />
      <button type="button"
              id="delete-community-btn"
              class="ds-button ds-button-danger"
              disabled
              hx-delete="/communities/{{ community_id }}/delete"
              hx-confirm="{{ ftl_get_message("community-delete-final-confirm") }}"
              hx-target="body"
              hx-swap="innerHTML"
              hx-disable="this">{{ ftl_get_message("community-delete-button") }}</button>
    </div>
  </div>
</section>
