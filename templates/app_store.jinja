{# What a store gives an app, handed to the page, which tells the site.

   A store is "apple" (the App Store: the iOS and macOS apps), "google"
   (Google Play: the Android app), "microsoft" (the Microsoft Store build of
   the Windows app) or "steam" (the Steam build). A build that sells names
   its store in its user agent, and the root is marked data-store before
   the page paints (theme_head.jinja); one that does not sells nothing.
   Each build sells through one store only, so nothing the page asks says
   which: the app is that store.

   What a store sells is the site's catalogue, which staff keep at
   /admin/store (models/store_product.rs): each product by the store's own
   id, with the Supporter Pack year it counts for. The server reads the
   same user agent and draws /supporter's buttons itself -- that store's
   products on sale this year, and nothing of any other store's
   (handlers/supporter.rs) -- so every product the page asks about is one
   the app can sell.

   An app does only what a store can -- sell, restore, hand over proof of
   what was bought -- and the page does the rest. Every store goes the same
   way:
     1. /supporter asks  prices {products}  and the app answers with
        oeeeApp.store.prices({product: price}) (supporter.jinja);
     2. a press asks  purchase {product}, or  restore {}  where the store
        has such a thing (App Store, Google Play), and the app sells;
     3. the app hands the page proof of what was bought, as strings:

          window.oeeeApp.store.purchased(proofs)

        apple      StoreKit transaction ids -- after a sale, a Restore, or
                   finding transactions StoreKit has not seen finished
        google     Play Billing purchase tokens -- after a sale, a
                   Restore, and whenever /supporter asks for prices and
                   Play lists a purchase not yet acknowledged. The site
                   acknowledges each one it takes, so the app has nothing
                   to finish
        steam      a Web API ticket -- after Steam says a DLC was installed;
                   the site asks Steam what the ticket's account owns
        microsoft  a Microsoft Store ID key -- after a sale, and whenever
                   the app finds add-ons the site has not taken; the site
                   asks the Store's collections API what the key's account
                   owns. The app makes the key itself, from a ticket the
                   page gets it:

          window.oeeeApp.store.ticket()

                   resolves to {ticket, user}, two strings, from POST
                   /store/microsoft/tickets -- or to null outside the
                   Microsoft Store build, signed out, or when the site could
                   not make one. The app passes both to
                   StoreContext.GetCustomerCollectionsIdAsync(ticket, user)
                   and hands the key it gets to purchased(). A ticket
                   lasts minutes, not days, so it is asked for afresh each
                   time a key is wanted.

        Each is posted to /store/<store>/purchases, which asks the store
        itself (src/app_store.rs, src/google_play.rs, src/steam.rs,
        src/microsoft_store.rs) -- nothing the page or the app says
        records a purchase. The promise answers with the proofs the site
        took; the app finishes those and only those where its store has
        finishing (StoreKit), and anything else is offered again. The page reloads once, after answering, if
        the site took any.

   What happens to a press is the page's to say, since only the page hears
   the site's answer (supporter.jinja). So purchased() tells the page as
   well as the app, and an app whose store can end a press without proof --
   a sale cancelled or left waiting for a parent, one that failed, a
   Restore that found nothing -- says so with

          window.oeeeApp.store.ended(outcome)

   where outcome is "cancelled", "pending", "failed" or "nothing". Both
   reach the page as an `oeee:store` event on the document, whose detail
   is one of
          {state: "checking"}                   proofs are with the site
          {state: "checked", taken, refused}    how many it took, and the
                                                statuses of those it did not
          {state: "ended", outcome}             from ended() #}
<script>
  (function () {
    var app = window.oeeeApp;
    if (!app) return;

    function tell(detail) {
      var event;
      try {
        event = new CustomEvent("oeee:store", { detail: detail });
      } catch (error) {
        return;
      }
      document.dispatchEvent(event);
    }

    app.store = app.store || {};
    app.store.ended = function (outcome) {
      tell({ state: "ended", outcome: String(outcome) });
    };
    app.store.purchased = function (proofs) {
      var store = document.documentElement.getAttribute("data-store");
      var list = Array.isArray(proofs) ? proofs.filter(function (proof) { return typeof proof === "string" && proof; }) : [];
      if (!store) list = [];
      if (list.length) tell({ state: "checking" });
      return Promise.all(list.map(function (proof) {
        return fetch("/store/" + store + "/purchases", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: "proof=" + encodeURIComponent(proof)
        }).then(function (response) {
          // A plain yes only. Nobody signed in (401), too many at once (429)
          // and the store out of reach (502) are all worth offering again,
          // so none of them lets the app finish.
          return { proof: proof, status: response.status };
        }, function () {
          // Never reached the site: as good as a store out of reach.
          return { proof: proof, status: 0 };
        });
      })).then(function (answers) {
        var taken = [];
        var refused = [];
        answers.forEach(function (answer) {
          if (answer.status === 204) taken.push(answer.proof);
          else refused.push(answer.status);
        });
        if (list.length) tell({ state: "checked", taken: taken.length, refused: refused });
        // After the answer has gone back, so the app hears it before the
        // page it came from goes away.
        if (taken.length) setTimeout(function () { location.reload(); }, 0);
        return taken;
      });
    };
    app.store.ticket = function () {
      if (document.documentElement.getAttribute("data-store") !== "microsoft") {
        return Promise.resolve(null);
      }
      return fetch("/store/microsoft/tickets", {
        method: "POST",
        credentials: "same-origin"
      }).then(function (response) {
        return response.status === 200 ? response.json() : null;
      }).then(function (told) {
        // Exactly the two strings the Store is to be given, or nothing.
        return told && typeof told.ticket === "string" && told.ticket &&
          typeof told.user === "string" && told.user
          ? { ticket: told.ticket, user: told.user } : null;
      }, function () {
        return null;
      });
    };
  })();
</script>
