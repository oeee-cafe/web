{# How many drawings a row: the one control for it, on every grid of
   drawings. A slider from big tiles to many small ones, the count beside it.
   The reader's choice is remembered in this browser under `key`, and set on
   the root as `var`, which the grid reads -- so the page's own head script
   (post_feed_head.jinja for the feeds) can apply it before the grid paints.

   The count is also written to the root as `data-{{ key }}-density`:
   "dense" past six a row, "bare" past nine, which the grid's captions use to
   say less as the squares get narrower. Several controls for the same key on
   one page -- the profile's two tabs -- stay in step.

   Hidden on a phone, which keeps three a row whatever was chosen (style.css).
   The script is frontend/site/perRow.ts. #}
{% macro per_row(id="post-cols", var="--home-cols", key="homeCols", default=6) %}
  <div class="ds-per-row" data-per-row data-var="{{ var }}" data-key="{{ key }}" data-default="{{ default }}">
    <svg class="ds-per-row-few" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
    <input class="ds-range" type="range" id="{{ id }}" min="1" max="12" step="1" aria-label="{{ ftl_get_message('feed-columns') }}" title="{{ ftl_get_message('feed-columns') }}" />
    <svg class="ds-per-row-many" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><g fill="currentColor"><rect x="1" y="1" width="3.6" height="3.6" rx=".6"/><rect x="6.2" y="1" width="3.6" height="3.6" rx=".6"/><rect x="11.4" y="1" width="3.6" height="3.6" rx=".6"/><rect x="1" y="6.2" width="3.6" height="3.6" rx=".6"/><rect x="6.2" y="6.2" width="3.6" height="3.6" rx=".6"/><rect x="11.4" y="6.2" width="3.6" height="3.6" rx=".6"/><rect x="1" y="11.4" width="3.6" height="3.6" rx=".6"/><rect x="6.2" y="11.4" width="3.6" height="3.6" rx=".6"/><rect x="11.4" y="11.4" width="3.6" height="3.6" rx=".6"/></g></svg>
    <output class="ds-per-row-value" for="{{ id }}"></output>
  </div>
  <script>if (window.oeeeChrome) window.oeeeChrome.perRow();</script>
{% endmacro %}
