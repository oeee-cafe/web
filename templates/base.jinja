<!DOCTYPE html>
<html lang="{{ ftl_lang }}">
  <head>
    <meta charset="utf-8" />
    <title>{%- block title -%} {{ ftl_get_message("brand") }} {%- endblock title -%}</title>
    <link rel="stylesheet"
          href="{{ '/static/style.css' | cachebuster | safe }}"
          type="text/css" />
    <script src="https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js"
            integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc"
            crossorigin="anonymous"></script>
    <meta name="viewport"
          content="width=device-width,initial-scale=1.0,minimum-scale=1.0" />
    <meta name="keywords" content="오이카페, 오에카키, 커뮤니티, お絵かき" />
    <meta name="description" content="오이카페는 오에카키 커뮤니티입니다. お絵かできるOEEEカフェです。" />
    <link rel="icon" type="image/png" href="/static/favicon.png" />
    {# Link-preview card. Every page gets the site-level version; pages with
       something more specific to say (a post, a profile, a community) override
       this block. Only og:* and twitter:card are set — X falls back to og:title
       and og:description when the twitter:* equivalents are absent, so there is
       no reason to write each string twice. #}
    {% block social_meta %}
      <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
      <meta property="og:type" content="website" />
      <meta property="og:title" content="{{ ftl_get_message('brand') }}" />
      <meta property="og:description" content="{{ ftl_get_message('about') }}" />
      <meta property="og:url" content="{{ base_url|safe }}/" />
      <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:site" content="@oeee_cafe" />
    {% endblock social_meta %}
    {% block head %}
    {% endblock head %}
  </head>
  <body>
    <header>
      <h1 class="logo center">
        <a href="/">
          <img src="{%- if ftl_lang == "zh" -%}/static/logo/en.svg{%- else -%}/static/logo/{{ ftl_lang }}.svg{%- endif -%}"
               alt="{{ ftl_get_message('brand') }}"
               height="75px"
               width="{%- if ftl_lang == "ja" -%} 345px {%- else -%} 270px {%- endif -%}" />
        </a>
      </h1>
      <nav class="nav-bar">
        <div id="menubar" class="center">
          <div>
            <a href="/about">{{ ftl_get_message('brand') }}?</a>
          </div>
          {% if current_user %}
            <form action="/draw" method="post">
              <input type="hidden" name="tool" value="neo" />
              <input type="hidden" name="width" value="300" />
              <input type="hidden" name="height" value="300" />
              <input type="submit"
                     id="nav-draw-button"
                     value="{{ ftl_get_message('draw') }}" />
            </form>
          {% else %}
            <div>
              <a href="/login">{{ ftl_get_message('draw') }}</a>
            </div>
          {% endif %}
          {# Shown signed out too: the lobby is a public gallery of finished
             collaborative drawings, and only creating a session needs an
             account. #}
          <div>
            <a href="/collaborate">{{ ftl_get_message("collaborate") }}</a>
          </div>
          <div>
            <a href="/communities">{{ ftl_get_message("community") }}</a>
          </div>
          <div>
            <a href="/hashtags">{{ ftl_get_message("hashtag-discovery") }}</a>
          </div>
          {% if current_user %}
            <div>
              <a href="/home">{{ ftl_get_message("timeline") }}</a>
            </div>
            {% if draft_post_count > 0 %}
              <div>
                <a href="/posts/drafts">{{ ftl_get_message("drafts") }} ({{ draft_post_count }})</a>
              </div>
            {% endif %}
            <div>
              <a href="/notifications">{{ ftl_get_message("notifications") }}{% if unread_notification_count is defined and unread_notification_count > 0 %} ({{ unread_notification_count }}){% endif %}</a>
            </div>
            <div>
              <a href="/@{{ current_user.login_name }}">{{ ftl_get_message("profile") }}</a>
            </div>
            <div>
              <a href="/account">{{ ftl_get_message("account") }}</a>
              {% if not current_user.email_verified_at %}
                <span class="dangerous">({{ ftl_get_message("email-not-verified") }})</span>
              {% endif %}
            </div>
          {% else %}
            <a href="/login">{{ ftl_get_message("sign-in") }}</a>
            <a href="/signup">{{ ftl_get_message("sign-up") }}</a>
          {% endif %}
        </div>
      </nav>
      <ul class="center">
        {% for message in messages %}
          <li>
            <span><strong>{{ message.m }}</strong></span>
          </li>
        {% endfor %}
      </ul>
      {# Where a failed htmx request lands. web::htmx::error_banner retargets
         every error response at this id, so a control that fails says so
         instead of going quiet. Empty until something goes wrong; the CSS
         gives it no box of its own while it holds nothing. #}
      <div id="htmx-error" class="htmx-error center"></div>
    </header>
    <main>
      {% block content %}
      {% endblock content %}
    </main>
  </body>
</html>
