<!DOCTYPE html>
<html lang="{{ ftl_lang }}">
  <head>
    <meta charset="utf-8" />
    {% include "theme_head.jinja" %}
    <title>{%- block title -%} {{ ftl_get_message("brand") }} {%- endblock title -%}</title>
    <link rel="stylesheet"
          href="{{ '/static/ds.css' | cachebuster | safe }}"
          type="text/css" />
    <link rel="stylesheet"
          href="{{ '/static/style.css' | cachebuster | safe }}"
          type="text/css" />
    <script src="https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js"
            integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc"
            crossorigin="anonymous"></script>
    {# Two of htmx's own extensions. preload fetches a boosted link's page
       at the press, before the click lands -- the toolbar's sections and
       every in-place pill (pill_macro.jinja, which asks for the hover as
       well). history-cache keeps the last ten pages left, so going back
       puts one up at once, scrolled where it was, instead of fetching it
       again (the skeleton is taken down before it is kept, toolbar.jinja). #}
    <script src="https://unpkg.com/htmx.org@4.0.0/dist/ext/hx-preload.min.js"
            integrity="sha384-LSxugL3er+b7Uzb5mUEXqf/04QBmk03jifaR6p8VcImZQw4rUNO+bNbMC5eYzK82"
            crossorigin="anonymous"></script>
    <script src="https://unpkg.com/htmx.org@4.0.0/dist/ext/hx-history-cache.min.js"
            integrity="sha384-e1wwPpjN1qgXFpaQz+GhbURx/wQofDpeAB9F3m8nxLi7CVxm1w2bpiNi3hECpDPg"
            crossorigin="anonymous"></script>
    <meta name="viewport"
          content="width=device-width,initial-scale=1.0,minimum-scale=1.0,viewport-fit=cover" />
    <meta name="keywords" content="오이카페, 오에카키, 커뮤니티, お絵かき" />
    <meta name="description" content="오이카페는 오에카키 커뮤니티입니다. お絵かできるOEEEカフェです。" />
    <link rel="icon" type="image/png" href="/static/favicon.png" />
    {# Link-preview card. Every page gets the site-level version; pages with
       something more specific to say (a post, a profile, a community) override
       this block. Only og:* and twitter:card are set — X falls back to og:title
       and og:description when the twitter:* equivalents are absent, so there is
       no reason to write each string twice. #}
    {% block social_meta %}
      <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
      <meta property="og:type" content="website" />
      <meta property="og:title" content="{{ ftl_get_message('brand') }}" />
      <meta property="og:description" content="{{ ftl_get_message('about') }}" />
      <meta property="og:url" content="{{ base_url|safe }}/" />
      <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:site" content="@oeee_cafe" />
    {% endblock social_meta %}
    {% include "presence_meta.jinja" %}
    {% block head %}
    {% endblock head %}
  </head>
  <body class="ds-page">
    {# Safari on iOS gives nothing :active unless the page listens for
       touches, and the pressed states in ds.css are how a control answers a
       tap there now that the tap highlight is off. #}
    <script>
      document.addEventListener("touchstart", function () {}, { passive: true });
    </script>
    <header>
      {% include "toolbar.jinja" %}
      {# Flash messages, one notice each (ds.css, "Notices"); the level --
         Success, Error, and the rest axum-messages has -- picks the colour. #}
      {% if messages %}
        <ul class="ds-notices">
          {% for message in messages %}
            <li class="ds-notice ds-notice-{{ message.l | lower }}">
              <span class="ds-notice-body">{{ message.m }}</span>
              {% include "notice_close.jinja" %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {# Where a failed htmx request lands. web::htmx::error_banner retargets
         every error response at this id, so a control that fails says so
         instead of going quiet. Empty until something goes wrong, and
         `.ds-notices:empty` gives it no box while it holds nothing. #}
      <div id="htmx-error" class="ds-notices htmx-error"></div>
    </header>
    {# Putting a notice away. Delegated, so the htmx banner's notices, which
       arrive after this runs, close the same way. A list left with nothing
       in it is emptied outright, so `:empty` takes the list away too. #}
    <script>
      document.addEventListener("click", function (event) {
        var button = event.target.closest && event.target.closest(".ds-notice-close");
        if (!button) return;
        var notice = button.parentNode;
        var list = notice.parentNode;
        list.removeChild(notice);
        if (!list.querySelector(".ds-notice")) list.innerHTML = "";
      });
    </script>
    {# In the macOS app the header floats over the content (ds.css), which
       needs its height to start below it -- a height that changes when the
       toolbar stacks or a message arrives. #}
    <script>
      (function () {
        var root = document.documentElement;
        if (root.getAttribute("data-app") !== "macos" || !window.ResizeObserver) return;
        var header = document.querySelector(".ds-page > header");
        function measure() {
          root.style.setProperty("--ds-header-height", header.offsetHeight + "px");
        }
        measure();
        new ResizeObserver(measure).observe(header);
      })();
    </script>
    {# The content area: what scrolls, below the toolbar, on screens wider
       than a phone (ds.css, "The content area"). Focusable from script only,
       so the keyboard scrolls it without a click first. #}
    <main class="ds-content" tabindex="-1">
      {% block content %}
      {% endblock content %}
    </main>
    {% include "confirm_dialog.jinja" %}
    {% include "segmented.jinja" %}
  </body>
</html>
