{# Controls that show their answer at the press, before the server's: a
   reaction chip, and follow and unfollow (follow_macro.jinja), whose button
   takes the other one's words and fill.

   A reaction chip (post_reactions.jinja) fills or empties and moves its
   number, and the post's total with it, the moment it is pressed, the way a
   chat application's reactions do -- the round trip is a few hundred
   milliseconds on a phone, and a chip that sits there that long reads as a
   press that missed. The response is the whole block re-rendered, which
   stands in for this guess with the truth: someone else's reaction that
   landed meanwhile included.

   A request that fails is answered with a toast (web::htmx::error_banner)
   and no block, so the guess is taken back here, from what was noted before
   it was made; a request that never reached the server is taken back the
   same way. Only the numbers and the class are touched, never the markup,
   so the chip is still the element htmx knows. #}
<script>
  (function () {
    if (window.oeeeOptimisticInstalled) return;
    window.oeeeOptimisticInstalled = true;
    function nudge(span, by) {
      if (!span) return null;
      var was = span.textContent;
      var n = parseInt(was, 10);
      if (!isNaN(n)) span.textContent = String(Math.max(0, n + by));
      return { span: span, was: was };
    }
    // Follow and unfollow (follow_macro.jinja): the button takes the other
    // one's words and fill.
    function toggle(ctx, form) {
      var button = form.querySelector("button[data-pressed-label]");
      if (!button) return;
      var was = { text: button.textContent, className: button.className };
      button.textContent = button.getAttribute("data-pressed-label");
      button.classList.toggle("ds-button-primary");
      ctx.oeeeGuess = {
        undo: function () {
          if (!button.isConnected) return;
          button.textContent = was.text;
          button.className = was.className;
        }
      };
    }
    document.addEventListener("htmx:before:request", function (event) {
      var ctx = event.detail && event.detail.ctx;
      var source = ctx && ctx.sourceElement;
      if (source && source.hasAttribute && source.hasAttribute("data-optimistic-toggle")) {
        toggle(ctx, source);
        return;
      }
      var chip = source;
      if (!chip || !chip.classList || !chip.classList.contains("reaction-button")) return;
      var block = chip.closest(".post-reactions");
      if (!block) return;
      var reacted = !chip.classList.contains("reacted");
      var by = reacted ? 1 : -1;
      chip.classList.toggle("reacted", reacted);
      var counts = [nudge(chip.querySelector(".reaction-count"), by), nudge(block.querySelector(".reaction-total-count"), by)];
      ctx.oeeeGuess = {
        undo: function () {
          if (!chip.isConnected) return;
          chip.classList.toggle("reacted", !reacted);
          for (var i = 0; i < counts.length; i++) {
            if (counts[i] && counts[i].span.isConnected) counts[i].span.textContent = counts[i].was;
          }
        }
      };
    });
    function takeBack(ctx) {
      var guess = ctx && ctx.oeeeGuess;
      if (!guess) return;
      ctx.oeeeGuess = null;
      guess.undo();
    }
    document.addEventListener("htmx:after:request", function (event) {
      var ctx = event.detail && event.detail.ctx;
      if (ctx && ctx.response && ctx.response.status >= 400) takeBack(ctx);
    });
    document.addEventListener("htmx:error", function (event) {
      takeBack(event.detail && event.detail.ctx);
    });
  })();
</script>
