{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("password-reset-sent-title") }}
{% endblock title %}
{% block content %}
  <div class="auth-page">
    <div class="ds-card auth-card">
      <h1 class="auth-title">{{ ftl_get_message("password-reset-sent-title") }}</h1>
      <p class="auth-lede">{{ ftl_get_message("password-reset-sent-message") }}</p>
      <p class="settings-status is-good auth-email">{{ ftl_get_message("password-reset-sent-email") }}: <strong>{{ email }}</strong></p>
      <p class="auth-lede">{{ ftl_get_message("password-reset-check-email") }}</p>
      <a class="ds-button auth-secondary" href="/login">{{ ftl_get_message("back-to-login") }}</a>
    </div>
  </div>
{% endblock content %}
