{# Signing in with another provider, as a section of /login's card under
   "Or sign in with".

   An imported macro does not see the page's context, so the language,
   where the reader was going and which providers are on are handed over;
   `question` is the message key over the buttons. Each is the site's own
   button in the provider's colours with the provider's logo before the
   words, at the card's 40px (`auth-card-providers`, style.css). #}
{# A provider's logo, before the words on its button: here, and on
   /account's buttons that link one (account.jinja). Apple's and Steam's
   are drawn inline in the words' own colour so they turn with the theme;
   Google's and Discord's are their own pictures (static/signin/). #}
{% macro provider_mark(provider) -%}
  {%- if provider == "apple" -%}
    <svg class="auth-provider-mark" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
  {%- elif provider == "google" -%}
    <img class="auth-provider-mark" src="{{ '/static/signin/google-mark.svg' | cachebuster | safe }}" width="18" height="18" alt="" />
  {%- elif provider == "steam" -%}
    <svg class="auth-provider-mark" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/></svg>
  {%- elif provider == "discord" -%}
    <img class="auth-provider-mark auth-discord-mark" src="{{ '/static/signin/discord-mark.svg' | cachebuster | safe }}" width="24" height="18" alt="" />
  {%- endif -%}
{%- endmacro %}

{% macro sign_in_providers(question, lang, next, steam_enabled, apple_enabled, google_enabled, discord_enabled=false) -%}
  <div class="auth-social">
    <div class="auth-divider"><span>{{ ftl_get_message(question) }}</span></div>
    {% if apple_enabled %}
      {# Apple's sign-in page, and back, in a browser. In every app the
         page takes the press itself (app_sign_in.jinja): a sheet of the
         platform's own on iOS and macOS, and elsewhere the browser, with
         the answer handed back to this session.

         The site's button in Apple's colours, black on light and white
         on dark as Apple asks, with Apple's logo drawn inline in the
         words' own colour so it turns with the theme (style.css). #}
      <a class="ds-button auth-secondary auth-apple" href="/auth/apple{% if next %}?next={{ next|urlencode }}{% endif %}">{{ provider_mark("apple") }}{{ ftl_get_message("sign-in-with-apple") }}</a>
    {% endif %}
    {% if google_enabled %}
      {# Google's sign-in page, and back, in a browser. Google refuses
         its own pages in an embedded web view, so in every app the page
         takes the press itself (app_sign_in.jinja): Credential Manager
         on Android, and elsewhere this same page in a browser of the
         system's -- a sheet on iOS and macOS, the browser on Windows --
         with the answer handed back.

         The site's button in Google's colours for each theme, with
         Google's four-colour G in flat colour (static/signin/google-mark.svg)
         before the words in the reader's language (style.css). #}
      <a class="ds-button auth-secondary auth-google" href="/auth/google{% if next %}?next={{ next|urlencode }}{% endif %}">{{ provider_mark("google") }}{{ ftl_get_message("sign-in-with-google") }}</a>
    {% endif %}
    {% if steam_enabled %}
      {# Steam's sign-in page, and back, in a browser (/auth/steam). The
         Oeee Cafe app on Steam never follows it: the page takes the press
         itself, asks Steam for a ticket and posts it to /auth/steam. The
         other apps open it in a browser of the system's
         (app_sign_in.jinja).

         The site's own button, with Steam's logo drawn inline in the
         words' colour so it turns with the theme. #}
      <a class="ds-button auth-secondary auth-steam" href="/auth/steam{% if next %}?next={{ next|urlencode }}{% endif %}">{{ provider_mark("steam") }}{{ ftl_get_message("sign-in-with-steam") }}</a>
    {% endif %}
    {% if discord_enabled %}
      {# Discord's sign-in page, and back, in a browser: in every app the
         page takes the press itself and opens this in a browser of the
         system's (app_sign_in.jinja), where the person's Discord
         password or passkey is. Most who press it were asked into a
         collaborative room from Discord and have no account here yet.

         Discord's blurple, its symbol in white as its branding page
         gives it (static/signin/discord-mark.svg, unaltered), and the
         words in the reader's language, at the card's 40px (style.css). #}
      <a class="ds-button auth-secondary auth-discord" href="/auth/discord{% if next %}?next={{ next|urlencode }}{% endif %}">{{ provider_mark("discord") }}{{ ftl_get_message("sign-in-with-discord") }}</a>
    {% endif %}
  </div>
{%- endmacro %}
