{% extends "base.jinja" %}
{% from "sign_in_providers_macro.jinja" import sign_in_providers %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("sign-in") }}
{% endblock title %}
{% block content %}
  {# Signing in as an application's sheet asks for it: one card, the two
     fields, the one button that does it, and the other things a person at
     this door may need -- another way in, a password they have forgotten,
     or an account they do not have yet -- each a section of its own under a
     question, rather than a line of small print under the form. #}
  <div class="auth-page">
    <form method="post" class="ds-card auth-card auth-card-providers">
      <h1 class="auth-title">{{ ftl_get_message("sign-in") }}</h1>
      {% if linking_provider %}
        {# Arrived from signing in with Steam, say, to an account that is
           not linked yet: signing in here links it. #}
        <p class="auth-lede">{{ ftl_format_pattern("identity-login-notice", {"provider": linking_provider}) }}</p>
      {% endif %}
      <div class="form-field">
        <label class="ds-label" for="login_name">{{ ftl_get_message("login-name") }}</label>
        <input class="ds-input" name="login_name" id="login_name"
               autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus />
      </div>
      <div class="form-field">
        <label class="ds-label" for="password">{{ ftl_get_message("password") }}</label>
        <input class="ds-input" name="password" id="password" type="password"
               autocomplete="current-password" required />
      </div>
      {% if next %}<input type="hidden" name="next" value="{{ next }}" />{% endif %}
      <button type="submit" class="ds-button ds-button-primary auth-submit">{{ ftl_get_message("sign-in") }}</button>
      {% if linking_provider %}
        <button type="submit" form="identity-cancel" class="ds-button auth-secondary">{{ ftl_get_message("identity-cancel") }}</button>
      {% endif %}

      {% if not linking_provider and (steam_enabled or apple_enabled or google_enabled) %}
        {{ sign_in_providers("sign-in-other-ways", ftl_lang, next, steam_enabled, apple_enabled, google_enabled) }}
      {% endif %}

      <div class="auth-divider"><span>{{ ftl_get_message("forgot-password") }}</span></div>
      <a class="ds-button auth-secondary" href="/password-reset">{{ ftl_get_message("find-password") }}</a>

      <div class="auth-divider"><span>{{ ftl_get_message("sign-in-no-account") }}</span></div>
      {# Carries where the reader was going, so signing up from here ends
         where signing in would have. #}
      <a class="ds-button auth-secondary" href="/signup{% if next %}?next={{ next|urlencode }}{% endif %}">{{ ftl_get_message("sign-up") }}</a>
    </form>
    {% if linking_provider %}<form id="identity-cancel" method="post" action="/auth/cancel"></form>{% endif %}
  </div>
{% endblock content %}
