{% extends "base.jinja" %}
{% import "pill_macro.jinja" as pill %}
{% from "comments_aside_macro.jinja" import comments_aside %}
{% block title %}
  {{ super() }} | #{{ tag.display_name }}
{% endblock title %}
{% block social_meta %}
  <meta property="og:site_name" content="{{ ftl_get_message('brand') }}" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="#{{ tag.display_name }}" />
  <meta property="og:description"
        content="{{ ftl_format_pattern('tag-post-count', {'count': post_count}) }}" />
  {# The stored name, escaped: the display name differs from it in case, and a
     tag in a non-Latin script has to survive being put in a URL. #}
  <meta property="og:url"
        content="{{ base_url|safe }}/tags/{{ tag.name|urlencode }}" />
  {# Lead with the most recent drawing carrying the tag, which is a far better
     preview than the site mark. #}
  {% if feed.posts %}
    <meta property="og:image"
          content="{{ r2_public_endpoint_url|safe }}/image/{{ feed.posts[0].image_filename[:2] }}/{{ feed.posts[0].image_filename }}" />
    <meta name="twitter:card" content="summary_large_image" />
  {% else %}
    <meta property="og:image" content="{{ base_url|safe }}/static/favicon.png" />
    <meta name="twitter:card" content="summary" />
  {% endif %}
  <meta name="twitter:site" content="@oeee_cafe" />
{% endblock social_meta %}
{# What of the tag is showing under its card -- its drawings, or what has
   been said on them -- as a pill of links, each its own address
   (/tags/name and /tags/name/comments), switched in place, as a
   community's are. tag_comments.jinja is this page with the other one
   chosen. #}
{% macro tag_views(chosen) %}
  {% set here = "/tags/" ~ tag.name|urlencode %}
  <nav class="ds-segmented" aria-label="#{{ tag.display_name }}" {{ pill.in_place() }}>
    <a href="{{ here }}"{% if chosen == "drawings" %} aria-current="page"{% endif %}>{{ ftl_get_message("feed-view-drawings") }}</a>
    <a href="{{ here }}/comments"{% if chosen == "comments" %} aria-current="page"{% endif %}>{{ ftl_get_message("feed-view-comments") }}</a>
  </nav>
{% endmacro %}
{% block content %}
  {# In the body, not the head: a boosted visit keeps nothing of the head but
     the title, so from there it stopped applying the reader's count a row. #}
  {% include "post_feed_head.jinja" %}
  {# A tag's page as a community's is laid out: the card saying what it is,
     then its drawings. #}
  <div class="profile tag-page">
    <section class="profile-card ds-card">
      <div class="profile-identity">
        <h1 class="profile-name">#{{ tag.display_name }}</h1>
        {# Counted over the same filter the grid below is drawn from, so this
           is the number of drawings on the page rather than a stored counter
           that had drifted from it. #}
        <div class="profile-handle">{{ ftl_format_pattern("tag-post-count", {"count": post_count}) }}</div>
      </div>
      <div class="profile-actions">
        <a class="ds-button" href="/tags">{{ ftl_get_message("tag-discovery") }}</a>
      </div>
    </section>

    {% block tag_body %}
    {# The shared feed: same cards, same sensitive blur, same column control
       and same infinite scroll as / and a community page, and the same
       comments beside it (comments_aside_macro.jinja). #}
    {% set aside_comments = comments if comments is defined else {} %}
    <section class="profile-section feed-layout{% if aside_comments.rows %} has-comments{% endif %}" role="region" aria-label="{{ ftl_get_message("feed-view-drawings") }}">
      <div class="grid-header">
        {{ tag_views("drawings") }}
        {% if feed.posts %}
          {% include "post_feed_controls.jinja" %}
        {% endif %}
      </div>
      {{ comments_aside(aside_comments, "/tags/" ~ tag.name|urlencode ~ "/comments") }}
      {% if feed.posts %}
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      {% else %}
        <p class="profile-empty">{{ ftl_get_message("tag-no-posts") }}</p>
      {% endif %}
    </section>
    {% endblock tag_body %}
  </div>
{% endblock content %}
