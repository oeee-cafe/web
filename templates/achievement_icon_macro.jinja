{# An achievement's icon, on the accent so it reads as a badge. Keyed by the
   locale key (first-drawing), as the profile names them.

   The artwork is Google's Material Symbols (Apache 2.0; see
   THIRD-PARTY-NOTICES.md), the set the painter draws its tools with, copied
   from @iconify-json/material-symbols in neo-cucumber. Each is named beside
   it; to change one, copy the body of another from that package's
   icons.json rather than drawing it by hand. An achievement without an icon
   here gets the star. #}
{% macro achievement_icon(key) %}
  <span class="achievement-icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24">
      {%- if key == "first-drawing" -%}
        {# material-symbols:brush #}
        <path fill="currentColor" d="M6 21q-1.125 0-2.225-.55T2 19q.65 0 1.325-.513T4 17q0-1.25.875-2.125T7 14t2.125.875T10 17q0 1.65-1.175 2.825T6 21m5.75-6L9 12.25l8.95-8.95q.275-.275.688-.288t.712.288l1.35 1.35q.3.3.3.7t-.3.7z"/>
      {%- elif key == "first-relay" -%}
        {# material-symbols:reply #}
        <path fill="currentColor" d="M19 19v-4q0-1.25-.875-2.125T16 12H6.825l3.6 3.6L9 17l-6-6l6-6l1.425 1.4l-3.6 3.6H16q2.075 0 3.538 1.463T21 15v4z"/>
      {%- elif key == "first-collaboration" -%}
        {# material-symbols:group #}
        <path fill="currentColor" d="M1 20v-2.8q0-.85.438-1.562T2.6 14.55q1.55-.775 3.15-1.162T9 13t3.25.388t3.15 1.162q.725.375 1.163 1.088T17 17.2V20zm18 0v-3q0-1.1-.612-2.113T16.65 13.15q1.275.15 2.4.513t2.1.887q.9.5 1.375 1.112T23 17v3zM9 12q-1.65 0-2.825-1.175T5 8t1.175-2.825T9 4t2.825 1.175T13 8t-1.175 2.825T9 12m10-4q0 1.65-1.175 2.825T15 12q-.275 0-.7-.062t-.7-.138q.675-.8 1.038-1.775T15 8t-.362-2.025T13.6 4.2q.35-.125.7-.163T15 4q1.65 0 2.825 1.175T19 8"/>
      {%- elif key == "steam-supporter" -%}
        {# material-symbols:sports-esports #}
        <path fill="currentColor" d="M4.55 19q-1.275 0-1.975-.888T2.05 15.95l1.05-7.5q.225-1.5 1.338-2.475T7.05 5h9.9q1.5 0 2.613.975T20.9 8.45l1.05 7.5q.175 1.275-.525 2.163T19.45 19q-.525 0-.975-.187t-.825-.563L15.4 16H8.6l-2.25 2.25q-.375.375-.825.563T4.55 19M17 13q.425 0 .713-.288T18 12t-.288-.712T17 11t-.712.288T16 12t.288.713T17 13m-2-3q.425 0 .713-.288T16 9t-.288-.712T15 8t-.712.288T14 9t.288.713T15 10m-7.25 3h1.5v-1.75H11v-1.5H9.25V8h-1.5v1.75H6v1.5h1.75z"/>
      {%- else -%}
        {# material-symbols:star #}
        <path fill="currentColor" d="m5.825 21l1.625-7.025L2 9.25l7.2-.625L12 2l2.8 6.625l7.2.625l-5.45 4.725L18.175 21L12 17.275z"/>
      {%- endif -%}
    </svg>
  </span>
{% endmacro %}
