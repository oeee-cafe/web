{# An achievement's icon: a line drawing in the toolbar's hand -- a 24-unit
   grid, round caps -- on the accent, so it reads as a badge. Keyed by the
   locale key (first-drawing), as the profile names them. An achievement
   without a drawing here gets a star rather than nothing. #}
{% macro achievement_icon(key) %}
  <span class="achievement-icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      {%- if key == "first-drawing" -%}
        {# The pencil the toolbar draws with. #}
        <path d="M18.4 2.6a2 2 0 0 1 2.9 2.9L11 15.8l-3.6.8.8-3.6Z"/><path d="M7 17c-2 0-3 1.2-3 3 0 .6-.4 1-1 1 1.5 1 3 1 4.5 1 1.9 0 3.5-1.6 3.5-3.5"/>
      {%- elif key == "first-relay" -%}
        {# A drawing, and another carried on from it. #}
        <rect x="3" y="3" width="11" height="11" rx="2"/><path d="M10 21h9a2 2 0 0 0 2-2v-9"/><path d="M14 17.5l3.5-3.5M17.5 17.5V14H14"/>
      {%- elif key == "first-collaboration" -%}
        {# Two people. #}
        <circle cx="9" cy="8" r="3.2"/><path d="M3 20c.6-3.4 3-5.2 6-5.2s5.4 1.8 6 5.2"/><circle cx="17" cy="9" r="2.6"/><path d="M16.4 14.4c2.6-.2 4.4 1.4 4.8 4.4"/>
      {%- elif key == "steam-supporter" -%}
        {# A heart. #}
        <path d="M12 20.5s-8-4.9-8-10.8A4.7 4.7 0 0 1 12 6.6a4.7 4.7 0 0 1 8 3.1c0 5.9-8 10.8-8 10.8Z"/>
      {%- else -%}
        <path d="M12 3l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8Z"/>
      {%- endif -%}
    </svg>
  </span>
{% endmacro %}
