{
  "name": "neo-cucumber",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist-lib/neo-cucumber.js",
    "dist-lib/style.css",
    "dist-lib/types/public.d.ts",
    "dist-lib/types/operations.d.ts",
    "dist-lib/types/styles.d.ts",
    "dist-lib/types/components/Icon.d.ts",
    "dist-lib/types/components/neo/neoClasses.d.ts",
    "dist-lib/types/utils/windowDrag.d.ts"
  ],
  "main": "./dist-lib/neo-cucumber.js",
  "types": "./dist-lib/types/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/public.d.ts",
      "import": "./dist-lib/neo-cucumber.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:collaborate": "vite --config vite.collaborate.config.ts",
    "build": "tsc -b && vite build --config vite.collaborate.config.ts && vite build && vite build --config vite.viewer.config.ts && vite build --config vite.offline.config.ts && vite build --config vite.replay.config.ts && pnpm run build:library",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.lib.json",
    "build:icons": "node scripts/buildIconCollection.ts",
    "lint": "cd .. && eslint --config neo-cucumber/eslint.config.js neo-cucumber frontend",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:collaborate": "vite preview --config vite.collaborate.config.ts",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build:replay": "vite build --config vite.replay.config.ts"
  },
  "dependencies": {
    "@lingui/core": "^5.4.1",
    "@lingui/react": "^5.4.1",
    "lz-string": "^1.5.0"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@iconify-json/material-symbols": "^1.2.37",
    "@iconify/react": "^6.0.1",
    "@lingui/cli": "^5.4.1",
    "@lingui/swc-plugin": "^5.6.1",
    "@lingui/vite-plugin": "^5.5.0",
    "@sentry/react": "^10.12.0",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
