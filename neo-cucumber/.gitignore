# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules

# Vite's dependency-optimisation cache: a build artifact, not a lockfile.
.vite
# npm's lockfile. This package is managed with pnpm, and a second lockfile
# only resolves differently and then goes stale.
package-lock.json

dist
dist-example
dist-ssr
# The replay viewer bundle. Built by `pnpm run build` and rebuilt by the
# Dockerfile, so the deployed copy never comes from git. It was tracked only
# so a bare `cargo run` could serve /static/viewer without a node build first;
# run `pnpm run build:viewer` once instead.
dist-viewer
dist-offline
dist-replay
dist-lib
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vitest browser mode
.vitest-attachments/
**/__screenshots__/

# Real replay files fetched for the corpus test (see src/test/README.md)
src/test/corpus/
